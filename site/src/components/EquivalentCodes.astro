---
import data from "../data/data.json";

interface Code {
  brand: string;
  code: string;
}
interface Props {
  codes: Code[];
}
const { codes } = Astro.props;

function norm(s: string) {
  return String(s || "")
    .toLowerCase()
    .replace(/\s+/g, "")
    .replace(/[^a-z0-9]/g, "");
}

const localByCode = new Map<string, { slug: string; part_number: string; part_name: string }>();
for (const row of data as Array<Record<string, unknown>>) {
  const slug = String(row.slug || "");
  const pn = String(row.part_number || "");
  if (!slug || !pn) continue;
  localByCode.set(norm(pn), {
    slug,
    part_number: pn,
    part_name: String(row.part_name || pn),
  });
}

function resolve(code: string) {
  const n = norm(code);
  if (localByCode.has(n)) return localByCode.get(n)!;
  const variants = [
    n,
    n.replace(/2rs1$/, "2rs"),
    n.replace(/2rs$/, "2rs1"),
    n + "2rs",
    n.replace(/ddu$/, "2rs"),
    n.replace(/llb$/, "2rs"),
    n.replace(/2nse$/, "2rs"),
  ];
  for (const v of variants) {
    if (localByCode.has(v)) return localByCode.get(v)!;
  }
  return null;
}

function amazonUrl(brand: string, code: string) {
  const q = encodeURIComponent(`${brand} ${code}`.trim());
  return `https://www.amazon.com/s?k=${q}&tag=partpedia29-20`;
}

function shopeeUrl(brand: string, code: string) {
  const q = encodeURIComponent(`${brand} ${code}`.trim());
  return `https://shopee.co.id/search?keyword=${q}`;
}
---

{
  codes && codes.length > 0 && (
    <div class="eq-grid">
      {codes.map((c) => {
        const local = resolve(c.code);
        if (local) {
          return (
            <a class="eq-item eq-local" href={`/sparepart/${local.slug}/`} title={`Lihat di Partpedia: ${local.part_number}`}>
              <span class="eq-brand">{c.brand}</span>
              <span class="eq-code">{c.code}</span>
              <span class="eq-badge">Di katalog →</span>
            </a>
          );
        }
        return (
          <div class="eq-item eq-external">
            <span class="eq-brand">{c.brand}</span>
            <span class="eq-code">{c.code}</span>
            <div class="eq-actions">
              <a
                class="eq-link eq-amz"
                href={amazonUrl(c.brand, c.code)}
                target="_blank"
                rel="noopener sponsored nofollow"
              >
                Amazon →
              </a>
              <a
                class="eq-link eq-shp"
                href={shopeeUrl(c.brand, c.code)}
                target="_blank"
                rel="noopener sponsored nofollow"
              >
                Shopee →
              </a>
            </div>
          </div>
        );
      })}
    </div>
  )
}

<style>
  .eq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 0.65rem;
    margin: 1rem 0 1.25rem;
  }
  .eq-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 0.85rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(165deg, #1a2330 0%, #121820 100%);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  a.eq-item:hover,
  .eq-external:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
  }
  .eq-local {
    border-color: rgba(61, 207, 182, 0.28);
  }
  .eq-local:hover {
    border-color: rgba(61, 207, 182, 0.65);
  }
  .eq-external {
    border-color: rgba(255, 255, 255, 0.1);
  }
  .eq-brand {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b9aab;
  }
  .eq-code {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.92rem;
    color: #eef2f6;
    word-break: break-all;
  }
  .eq-badge {
    margin-top: 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    color: #3dcfb6;
  }
  .eq-actions {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.4rem;
  }
  .eq-link {
    font-size: 0.72rem;
    font-weight: 700;
    text-decoration: none;
  }
  .eq-link:hover {
    text-decoration: underline;
  }
  .eq-amz {
    color: #4da3ff;
  }
  .eq-shp {
    color: #ee4d2d;
  }
</style>
