---
// Slot iklan AdSense. Letakkan komponen ini di titik-titik yang sudah dioptimasi
// (setelah paragraf intro & di tengah konten) — bukan di atas fold atau berdekatan
// dengan tombol navigasi, agar sesuai kebijakan "invalid click" AdSense.
interface Props {
  slotId: string; // GANTI: data-ad-slot dari dashboard AdSense Anda (per lokasi/unit iklan)
}
const { slotId } = Astro.props;
---

<div class="ad-slot">
  <span class="ad-slot__label">Iklan</span>
  <!--
    GANTI ca-pub-XXXXXXXXXXXXXXXX dengan Publisher ID Anda, dan aktifkan blok ini
    setelah situs disetujui AdSense (lihat juga <script> loader di Layout.astro).
  -->
  <!--
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
    data-ad-slot={slotId}
    data-ad-format="auto"
    data-full-width-responsive="true"
  ></ins>
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
  -->
  <div class="ad-slot__placeholder">Ruang iklan ({slotId})</div>
</div>

<style>
  .ad-slot { margin: 2rem 0; text-align: center; }
  .ad-slot__label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--color-steel-light);
    display: block;
    margin-bottom: 0.35rem;
  }
  .ad-slot__placeholder {
    border: 1px dashed var(--color-line);
    padding: 1.5rem;
    color: var(--color-steel-light);
    font-size: 0.8rem;
  }
</style>
