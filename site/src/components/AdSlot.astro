---
/**
 * Slot iklan.
 * - Kosong / belum ada publisher ID → tidak ditampilkan (aman untuk review AdSense).
 * - Nanti isi ADSENSE_CLIENT & ADSENSE_SLOT di bawah, atau lewat props — unit iklan muncul otomatis.
 */
interface Props {
  slotId?: string;
  /** Override slot unit AdSense (opsional) */
  adSlot?: string;
}
const { slotId = "ad", adSlot = "" } = Astro.props;

// TODO saat AdSense disetujui: ganti string di bawah dengan milikmu
const ADSENSE_CLIENT = ""; // contoh: "ca-pub-xxxxxxxxxxxxxxxx"
const ADSENSE_SLOT = adSlot || ""; // contoh: "1234567890"
const enabled = Boolean(ADSENSE_CLIENT && ADSENSE_SLOT);
---
{enabled && (
  <aside class="ad-slot" data-ad-slot={slotId} aria-label="Iklan">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={ADSENSE_SLOT}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
    <script is:inline>
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
    </script>
  </aside>
)}
<style>
  .ad-slot {
    margin: 1.25rem 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 12px;
  }
</style>
