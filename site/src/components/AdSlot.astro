---
/**
 * Slot iklan — HANYA render jika ADSENSE_CLIENT + ADSENSE_SLOT sudah diisi.
 * Jangan tampilkan placeholder teks (penting untuk review AdSense).
 */
interface Props {
  slotId?: string;
  adSlot?: string;
}
const { slotId = "ad", adSlot = "" } = Astro.props;
const ADSENSE_CLIENT = ""; // isi setelah AdSense disetujui, contoh: "ca-pub-xxxxxxxx"
const ADSENSE_SLOT = adSlot || "";
const enabled = Boolean(ADSENSE_CLIENT && ADSENSE_SLOT);
---
{enabled && (
  <aside class="ad-slot" data-ad-slot={slotId} aria-label="Iklan">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={ADSENSE_SLOT}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
    <script is:inline>
      try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
    </script>
  </aside>
)}
<style>
  .ad-slot {
    margin: 1.25rem 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 12px;
  }
</style>
