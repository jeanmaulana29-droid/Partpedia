---
interface Props { slotId?: string; }
const { slotId = "ad" } = Astro.props;
---
<aside class="ad-slot" data-ad-slot={slotId} aria-label="Ruang iklan">
  <span>Ad space · {slotId}</span>
  <small>Tempat unit AdSense / sponsor — ganti dengan kode iklan Anda</small>
</aside>
<style>
  .ad-slot {
    display: grid; gap: 0.25rem; place-items: center;
    border: 1px dashed rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.03);
    color: var(--muted, #8b9aab);
    text-align: center;
    padding: 1.4rem 1rem;
    border-radius: 14px;
    margin: 1.35rem 0;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  small { text-transform: none; letter-spacing: 0; opacity: 0.8; font-size: 0.75rem; }
</style>
