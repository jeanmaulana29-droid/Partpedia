---
import Layout from "../../layouts/Layout.astro";
import { loadAllArticles } from "../../utils/loadArticles.js";
const sorted = loadAllArticles();
---
<Layout title="Wawasan Industri — Partpedia" description="Artikel ringkas seputar sparepart dan MRO.">
  <div class="hub">
    <p class="kicker">Knowledge Hub</p>
    <h1>Wawasan Industri</h1>
    <p class="lead">Bacaan singkat seputar part, spek, dan praktik lapangan.</p>
    <div class="list">
      {sorted.map((a) => (
        <a class="row" href={`/knowledge/${a.slug}/`}>
          <div class="thumb">
            <img
              src={a.image}
              alt=""
              loading="lazy"
              onerror={`this.onerror=null;this.src='${a.imageFallback}'`}
            />
          </div>
          <div>
            <h2>{a.title}</h2>
            <p class="ex">{a.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="back"><a href="/">← Katalog</a></p>
  </div>
  <style>
    .hub { max-width: 800px; margin: 0 auto; padding: 1.5rem 0 3rem; }
    .kicker { font-family: var(--font-mono); font-size: 0.72rem; color: var(--teal); letter-spacing: 0.1em; text-transform: uppercase; }
    h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0.35rem 0 0.5rem; }
    .lead { color: var(--muted); margin-bottom: 1.5rem; }
    .list { display: grid; gap: 0.9rem; }
    .row {
      display: grid; grid-template-columns: 140px 1fr; gap: 1rem;
      border: 1px solid var(--line); background: var(--bg-card); border-radius: 14px;
      padding: 0.65rem; color: inherit; text-decoration: none;
    }
    .row:hover { border-color: var(--amber); }
    .thumb { border-radius: 10px; overflow: hidden; background: #0e141c; min-height: 96px; }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 96px; }
    h2 { font-size: 1.02rem; margin: 0 0 0.3rem; }
    .ex { margin: 0; color: var(--muted); font-size: 0.86rem; }
    .back { margin-top: 2rem; }
    @media (max-width: 560px) { .row { grid-template-columns: 1fr; } .thumb { height: 150px; } }
  </style>
</Layout>
