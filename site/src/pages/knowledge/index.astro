---
import Layout from "../../layouts/Layout.astro";
import articles from "../../data/articles.json";

const sorted = [...articles].sort((a, b) => String(b.date).localeCompare(String(a.date)));
---
<Layout
  title="Wawasan Industri — Partpedia Knowledge"
  description="Artikel ringkas seputar bearing, kode part, pillow block, RFQ MRO, dan praktik penggantian sparepart industri."
>
  <div class="wrap-page">
    <p class="kicker">Knowledge Hub</p>
    <h1>Wawasan Industri</h1>
    <p class="lead">Bacaan singkat untuk riset part, cross-reference, dan keputusan penggantian di lapangan.</p>
    <div class="list">
      {sorted.map((a) => (
        <a class="row" href={`/knowledge/${a.slug}/`}>
          <div class="thumb" style={`background-image:url('${a.image}')`} />
          <div>
            <p class="date">{a.date}</p>
            <h2>{a.title}</h2>
            <p class="ex">{a.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="back"><a href="/">← Kembali ke katalog</a></p>
  </div>
  <style>
    .wrap-page { max-width: 800px; padding: 2rem 0 3rem; }
    .kicker {
      font-family: var(--font-mono); font-size: 0.75rem; color: var(--teal);
      letter-spacing: 0.08em; text-transform: uppercase;
    }
    h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin: 0.35rem 0 0.5rem; }
    .lead { color: var(--muted); margin-bottom: 1.75rem; }
    .list { display: grid; gap: 1rem; }
    .row {
      display: grid; grid-template-columns: 120px 1fr; gap: 1rem;
      border: 1px solid var(--line); background: var(--bg-card); border-radius: 14px;
      padding: 0.75rem; color: inherit; text-decoration: none;
    }
    .row:hover { border-color: var(--amber); }
    .thumb {
      border-radius: 10px; background-size: cover; background-position: center; min-height: 88px;
      background-color: #0e141c;
    }
    .date { margin: 0; font-size: 0.75rem; color: var(--muted); font-family: var(--font-mono); }
    h2 { font-size: 1.05rem; margin: 0.2rem 0 0.35rem; }
    .ex { margin: 0; color: var(--muted); font-size: 0.88rem; }
    .back { margin-top: 2rem; }
    @media (max-width: 560px) {
      .row { grid-template-columns: 1fr; }
      .thumb { height: 140px; }
    }
  </style>
</Layout>
