---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import { loadAllArticles } from "../../utils/loadArticles.js";

export async function getStaticPaths() {
  const list = loadAllArticles();
  return list.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const blocks = String(article.body || "")
  .trim()
  .split(/\n\n+/)
  .map((b) => b.trim())
  .filter(Boolean);

function isHeading(p) {
  return p.length < 80 && !p.endsWith(".") && !p.startsWith("-") && !/^\d+\./.test(p) && !p.includes("\n");
}

const midAt = Math.max(1, Math.floor(blocks.length / 2));
---
<Layout title={`${article.title} — Partpedia`} description={article.excerpt}>
  <div class="mag">
    <header class="mag-top">
      <a class="mag-brand" href="/">
        <img src="/logo.png" alt="Partpedia" width="36" height="36" onerror="this.style.display='none'" />
        <span>Part<span class="accent">pedia</span></span>
      </a>
      <nav class="mag-nav">
        <a href="/knowledge/">Wawasan</a>
        <a href="/">Katalog</a>
      </nav>
    </header>

    <p class="mag-kicker">Wawasan Industri</p>
    <h1 class="mag-title">{article.title}</h1>
    <p class="mag-deck">{article.excerpt}</p>

    <!-- Gambar 1: utama (hero) — upload: public/articles/{slug}.jpg -->
    <div class="mag-hero">
      <img
        src={article.image}
        alt=""
        width="1200"
        height="675"
        onerror={`this.onerror=null;this.src='${article.imageFallback}'`}
      />
    </div>

    <AdSlot slotId="article-top" />

    <div class="mag-body">
      {blocks.map((p, i) => {
        const nodes = [];
        if (i === midAt) {
          nodes.push(
            <div class="mag-mid">
              <img
                src={article.imageMid}
                alt=""
                width="1200"
                height="675"
                onerror={`this.onerror=null;this.src='${article.imageMidFallback}'`}
              />
            </div>
          );
        }
        if (p.startsWith("- ") || p.includes("\n- ")) {
          const items = p.split("\n").filter((l) => l.trim().startsWith("- "));
          nodes.push(
            <ul>
              {items.map((li) => <li>{li.replace(/^\s*-\s*/, "")}</li>)}
            </ul>
          );
        } else if (isHeading(p)) {
          nodes.push(<h2>{p}</h2>);
        } else {
          nodes.push(<p>{p}</p>);
        }
        return nodes;
      })}
    </div>

    <AdSlot slotId="article-mid" />

    <footer class="mag-foot">
      <a href="/knowledge/">← Semua wawasan</a>
      <a href="/">Jelajahi katalog →</a>
    </footer>

    <AdSlot slotId="article-bottom" />
  </div>

  <style>
    .mag { max-width: 720px; margin: 0 auto; padding: 1.25rem 0 3rem; }
    .mag-top {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      margin-bottom: 1.75rem; padding-bottom: 0.85rem; border-bottom: 1px solid var(--line);
    }
    .mag-brand {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: var(--font-display); font-weight: 800; font-size: 1.15rem;
      color: var(--ink); text-decoration: none;
    }
    .mag-brand img { border-radius: 8px; }
    .mag-brand .accent { color: var(--amber); }
    .mag-nav { display: flex; gap: 1rem; font-size: 0.88rem; }
    .mag-nav a { color: var(--muted); }
    .mag-kicker {
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--teal); margin: 0 0 0.35rem;
    }
    .mag-title {
      font-family: var(--font-display); font-size: clamp(1.75rem, 4.5vw, 2.45rem);
      line-height: 1.15; margin: 0 0 0.75rem; letter-spacing: -0.02em;
    }
    .mag-deck { font-size: 1.12rem; line-height: 1.55; color: var(--muted); margin: 0 0 1.35rem; }
    .mag-hero, .mag-mid {
      border-radius: 16px; overflow: hidden; border: 1px solid var(--line);
      background: #0e141c; margin-bottom: 1.5rem; aspect-ratio: 16 / 9;
    }
    .mag-mid { margin: 1.75rem 0; }
    .mag-hero img, .mag-mid img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .mag-body { font-size: 1.05rem; line-height: 1.75; color: #d5dde6; }
    .mag-body p { margin: 0 0 1.15rem; }
    .mag-body h2 {
      font-family: var(--font-display); font-size: 1.25rem;
      margin: 1.75rem 0 0.65rem; color: var(--ink);
    }
    .mag-body ul { margin: 0 0 1.15rem; padding-left: 1.2rem; }
    .mag-body li { margin-bottom: 0.4rem; }
    .mag-foot {
      display: flex; justify-content: space-between; gap: 1rem;
      margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); font-weight: 600;
    }
    .mag-foot a { color: var(--blue); }
  </style>
</Layout>
