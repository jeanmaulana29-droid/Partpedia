---
import Layout from "../../layouts/Layout.astro";
import { loadAllArticles } from "../../utils/loadArticles.js";
const articles = loadAllArticles();
const base = "https://github.com/jeanmaulana29-droid/Partpedia/upload/main/site/src/data/articles";
---
<Layout title="Upload artikel & gambar — Partpedia" description="Panduan upload.">
  <div class="help">
    <h1>Upload artikel & gambar</h1>
    <p class="lead">Satu folder = satu artikel. Upload sampai 3 file sekaligus: <code>isi.txt</code>, <code>1.jpg</code>, <code>2.jpg</code>.</p>

    <section>
      <h2>Artikel baru</h2>
      <ol>
        <li>Tentukan slug (huruf kecil + strip), contoh: <code>tips-v-belt</code></li>
        <li>Siapkan 3 file di komputer:
          <ul>
            <li><code>isi.txt</code> — baris1 judul, baris2 ringkasan, kosong, lalu isi</li>
            <li><code>1.jpg</code> — gambar utama</li>
            <li><code>2.jpg</code> — gambar tengah (opsional)</li>
          </ul>
        </li>
        <li>Buka link (ganti <code>tips-v-belt</code> dengan slug kamu):<br/>
          <code>{base}/tips-v-belt</code>
        </li>
        <li>Drag ketiga file → Commit</li>
      </ol>
    </section>

    <section>
      <h2>Ganti gambar artikel yang sudah ada</h2>
      <p>Klik link di bawah → drag <code>1.jpg</code> dan/atau <code>2.jpg</code> → Commit.</p>
      <ul class="list">
        {articles.map((a) => (
          <li>
            <strong>{a.title}</strong>
            <div class="links">
              <a href={`${base}/${a.slug}`} target="_blank" rel="noopener">Upload gambar / teks →</a>
              <a href={`/knowledge/${a.slug}/`}>Lihat artikel</a>
            </div>
            <code class="slug">{a.slug}</code>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <style>
    .help { max-width: 720px; margin: 0 auto; padding: 2rem 0 3rem; }
    h1 { font-size: 1.6rem; }
    .lead { color: var(--muted); }
    section { margin-top: 2rem; }
    code { font-family: var(--font-mono); font-size: 0.85em; }
    .list { list-style: none; padding: 0; }
    .list li {
      border: 1px solid var(--line); border-radius: 12px; padding: 0.85rem 1rem;
      margin-bottom: 0.65rem; background: var(--bg-card);
    }
    .links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.35rem 0; }
    .links a { color: var(--amber); font-weight: 600; }
    .slug { color: var(--muted); font-size: 0.78rem; }
  </style>
</Layout>
