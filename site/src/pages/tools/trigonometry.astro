---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Trigonometri & sudut — Smart Tools · Partpedia" description="Segitiga siku-siku: sudut θ (derajat), sisi depan (opposite), sisi samping (adjacent), hipotenusa. Isi kombinasi yang cukup untuk menyelesaikan.">
  <div class="tool-page">
    <a class="back" href="/tools/">← Semua Smart Tools</a>
    <div class="tool-card">
      <h1>Trigonometri & sudut</h1>
      <p class="desc">Segitiga siku-siku: sudut θ (derajat), sisi depan (opposite), sisi samping (adjacent), hipotenusa. Isi kombinasi yang cukup untuk menyelesaikan.</p>
      <div class="formula">sin θ = O/H · cos θ = A/H · tan θ = O/A</div>
      <div class="fields cols-2">
      <div class="field"><label for="deg">Sudut θ <span>(° derajat)</span></label><input id="deg" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>      <div class="field"><label for="opp">Sisi depan O <span>(mm)</span></label><input id="opp" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>      <div class="field"><label for="adj">Sisi samping A <span>(mm)</span></label><input id="adj" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>      <div class="field"><label for="hyp">Hipotenusa H <span>(mm)</span></label><input id="hyp" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      </div>
      <div class="actions">
        <button type="button" class="btn-calc" id="btn-calc">Hitung</button>
        <button type="button" class="btn-reset" id="btn-reset">Reset</button>
        <p class="msg" id="msg" role="status"></p>
      </div>
      <p class="hint"><strong>Satuan:</strong> gunakan satu sistem satuan yang konsisten pada semua kolom (sesuai label). Isi nilai yang diketahui, kosongkan yang ingin dicari. Kolom hasil akan ditandai warna tosca. Gunakan titik atau koma untuk desimal.</p>
    </div>
  </div>
  <script is:inline>

  function parseNum(el) {
    if (!el) return null;
    let v = String(el.value||"").trim().replace(",", ".");
    if (v === "") return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : NaN;
  }
  function fmt(x) {
    if (!Number.isFinite(x)) return "";
    const a = Math.abs(x);
    if (a !== 0 && (a < 1e-7 || a >= 1e10)) return x.toExponential(8);
    return x.toFixed(10).replace(/\.?0+$/, "");
  }
  function clearComputed(ids) {
    ids.forEach((id) => {
      const el = document.getElementById(id);
      const field = el?.closest(".field");
      field?.classList.remove("is-result");
      if (el?.dataset.computed === "1") { el.value = ""; delete el.dataset.computed; }
    });
  }
  function setResult(id, value) {
    const el = document.getElementById(id);
    if (!el) return;
    el.value = fmt(value);
    el.dataset.computed = "1";
    el.closest(".field")?.classList.add("is-result");
  }
  function wire(ids, compute) {
    const msg = document.getElementById("msg");
    ids.forEach((id) => {
      const el = document.getElementById(id);
      el?.addEventListener("input", () => {
        if (el.dataset.computed === "1") {
          delete el.dataset.computed;
          el.closest(".field")?.classList.remove("is-result");
        } else {
          clearComputed(ids);
        }
        const filled = ids.filter((i) => { const v = parseNum(document.getElementById(i)); return v !== null && !Number.isNaN(v); }).length;
        if (filled >= 2) compute();
        else if (msg) msg.textContent = "";
      });
      el?.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); compute(); } });
    });
    document.getElementById("btn-calc")?.addEventListener("click", compute);
    document.getElementById("btn-reset")?.addEventListener("click", () => {
      ids.forEach((id) => {
        const el = document.getElementById(id);
        if (el) { el.value = ""; delete el.dataset.computed; }
        el?.closest(".field")?.classList.remove("is-result");
      });
      if (msg) msg.textContent = "";
    });
  }

    (function(){
      const ids = ["deg", "opp", "adj", "hyp"];
      const msg = document.getElementById("msg");
      function compute() {
        clearComputed(ids);
        
    let deg=parseNum(document.getElementById("deg"));
    let opp=parseNum(document.getElementById("opp"));
    let adj=parseNum(document.getElementById("adj"));
    let hyp=parseNum(document.getElementById("hyp"));
    const vals=[deg,opp,adj,hyp];
    if (vals.some(v=>v!==null&&Number.isNaN(v))) { msg.textContent="Angka tidak valid"; return; }
    if (vals.some(v=>v!==null&&v<0)) { msg.textContent="Nilai sisi/sudut tidak boleh negatif"; return; }
    const rad = (d)=> d*Math.PI/180;
    const degOf = (r)=> r*180/Math.PI;
    try {
      // Prefer solving missing one when 2 known in a pair
      if (deg!==null && hyp!==null && opp===null) { setResult("opp", hyp*Math.sin(rad(deg))); msg.textContent="O = H · sin θ"; return; }
      if (deg!==null && hyp!==null && adj===null) { setResult("adj", hyp*Math.cos(rad(deg))); msg.textContent="A = H · cos θ"; return; }
      if (deg!==null && opp!==null && hyp===null) { setResult("hyp", opp/Math.sin(rad(deg))); msg.textContent="H = O / sin θ"; return; }
      if (deg!==null && adj!==null && hyp===null) { setResult("hyp", adj/Math.cos(rad(deg))); msg.textContent="H = A / cos θ"; return; }
      if (deg!==null && opp!==null && adj===null) { setResult("adj", opp/Math.tan(rad(deg))); msg.textContent="A = O / tan θ"; return; }
      if (deg!==null && adj!==null && opp===null) { setResult("opp", adj*Math.tan(rad(deg))); msg.textContent="O = A · tan θ"; return; }
      if (opp!==null && hyp!==null && deg===null) { setResult("deg", degOf(Math.asin(opp/hyp))); msg.textContent="θ = arcsin(O/H)"; return; }
      if (adj!==null && hyp!==null && deg===null) { setResult("deg", degOf(Math.acos(adj/hyp))); msg.textContent="θ = arccos(A/H)"; return; }
      if (opp!==null && adj!==null && deg===null) { setResult("deg", degOf(Math.atan(opp/adj))); msg.textContent="θ = arctan(O/A)"; return; }
      if (opp!==null && adj!==null && hyp===null) { setResult("hyp", Math.sqrt(opp*opp+adj*adj)); msg.textContent="H = √(O²+A²)"; return; }
      msg.textContent="Isi kombinasi yang cukup (mis. sudut+1 sisi, atau 2 sisi).";
    } catch(e){ msg.textContent="Kombinasi tidak valid"; }
  
      }
      wire(ids, compute);
    })();
  </script>
  <style>

  .tool-page { max-width: 720px; margin: 0 auto; padding: 1.25rem 0 3rem; }
  .back { display:inline-flex; align-items:center; gap:0.35rem; font-size:0.88rem; color: var(--muted); text-decoration:none; margin-bottom:0.85rem; }
  .back:hover { color: var(--amber); }
  .tool-card {
    border:1px solid var(--line); border-radius:22px; padding:1.25rem;
    background: radial-gradient(120% 80% at 0% 0%, rgba(45,212,191,0.08), transparent 50%), var(--bg-card);
    box-shadow: 0 18px 48px rgba(0,0,0,0.2);
  }
  .tool-card h1 { margin:0 0 0.35rem; font-family: var(--font-display); font-size:1.45rem; }
  .tool-card .desc { margin:0 0 1rem; color: var(--muted); font-size:0.92rem; line-height:1.5; }
  .formula { display:inline-block; font-family: var(--font-mono); font-size:0.85rem; color: var(--amber);
    border:1px solid rgba(240,164,58,0.35); background:rgba(240,164,58,0.08); padding:0.35rem 0.65rem; border-radius:999px; margin-bottom:1rem; }
  .fields { display:grid; gap:0.75rem; }
  @media(min-width:560px){ .fields.cols-2{ grid-template-columns:1fr 1fr;} .fields.cols-3{ grid-template-columns:1fr 1fr 1fr;} }
  .field { display:flex; flex-direction:column; gap:0.35rem; padding:0.75rem 0.85rem; border-radius:14px;
    border:1px solid var(--line); background:rgba(0,0,0,0.22); transition: border-color .15s, background .15s, box-shadow .15s; }
  .field label { font-size:0.8rem; font-weight:600; color: var(--ink); }
  .field label span { font-weight:500; color: var(--muted); font-size:0.75rem; }
  .field input { border:none; outline:none; background:transparent; color: var(--ink); font-size:1.25rem; font-weight:700; font-family: var(--font-mono); width:100%; }
  .field.is-result { border-color: rgba(45,212,191,0.65); background: rgba(45,212,191,0.12); box-shadow:0 0 0 3px rgba(45,212,191,0.12); }
  .field.is-result label { color: var(--teal); }
  .actions { display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; margin-top:1rem; }
  .btn-calc { appearance:none; border:none; cursor:pointer; font-weight:800; padding:0.7rem 1.25rem; border-radius:999px;
    background: linear-gradient(135deg,#2dd4bf,#14b8a6); color:#041016; }
  .btn-reset { appearance:none; cursor:pointer; font-weight:600; padding:0.65rem 1.1rem; border-radius:999px;
    background:transparent; border:1px solid var(--line); color: var(--ink); }
  .msg { margin:0; font-size:0.86rem; color: var(--muted); }
  .hint { margin-top:1rem; padding:0.75rem 0.9rem; border-radius:12px; border:1px solid rgba(255,255,255,0.08);
    background:rgba(255,255,255,0.03); font-size:0.84rem; color: var(--muted); line-height:1.45; }

  </style>
</Layout>
