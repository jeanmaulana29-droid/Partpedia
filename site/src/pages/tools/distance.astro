---
import Layout from "../../layouts/Layout.astro";
---
<Layout
  title="Pengukur jarak pendek — Partpedia"
  description="Ukur jarak dari titik A (pusat di permukaan) ke titik yang ditunjuk kamera. Putar atau geser HP — jarak naik/turun realtime."
>
  <div class="ds-page">
    <a class="back" href="/">← Beranda</a>

    <header class="ds-hero">
      <div class="ds-badge">A = PUSAT DI LAYAR/PERMUKAAN</div>
      <h1>Pengukur jarak pendek</h1>
      <p class="ds-lead">
        <strong>Titik A</strong> = pusat di permukaan saat Anda menandai.
        Putar HP (hanya arah kamera) atau geser posisi — jarak ke titik di crosshair
        <strong>naik saat menjauh dari A</strong> dan <strong>turun saat mendekati A</strong>, dari segala arah.
      </p>
    </header>

    <div class="setup-card" id="setup-card">
      <div class="setup-ico" aria-hidden="true">📏</div>
      <h2>Siapkan pengukuran</h2>
      <p>
        1. Buka kamera · 2. Arahkan ke titik A · 3. <strong>Tandai A</strong> ·
        4. Putar / geser arah kamera ke sekeliling — angka mengikuti realtime.
      </p>
      <p class="perm-warn">
        Izin kamera wajib. Izin orientasi hanya jika perangkat memintanya.
        Data tidak dikirim ke server.
      </p>
      <button type="button" class="btn-perm" id="btn-open">Buka kamera &amp; mulai</button>
      <p class="perm-err" id="perm-err" hidden></p>
    </div>

    <div class="view-wrap" id="view-wrap" hidden>
      <div class="stage" id="stage">
        <video id="video" playsinline muted autoplay></video>
        <canvas id="overlay"></canvas>
        <div class="crosshair" aria-hidden="true"></div>
      </div>

      <div class="readout-bar">
        <span class="ro-label" id="ro-label">Tekan Tandai A (pusat)</span>
        <span class="ro-val" id="ro-val">— mm</span>
        <span class="ro-meta" id="ro-meta">Putar kamera saja sudah menghitung</span>
      </div>

      <div class="controls">
        <button type="button" class="btn-a" id="btn-a">Tandai titik A</button>
        <button type="button" class="btn-reset" id="btn-reset">Reset</button>
        <button type="button" class="btn-stop" id="btn-stop">Tutup</button>
      </div>

      <p class="warn">
        Estimasi dari <strong>arah kamera + model permukaan</strong> (bukan laser).
        HP boleh tetap di tempat: yang dihitung adalah jarak di permukaan dari A ke titik yang sedang ditunjuk crosshair.
      </p>
    </div>
  </div>

  <script is:inline>
  (function () {
    const DEG = Math.PI / 180;
    const DEFAULT_H_MM = 1350; // internal saja, tidak ada kolom isian
    let stream = null;
    let track = null;
    let running = false;
    let raf = 0;
    let pointA = null; // { x, y, sx, sy } mm di bidang + posisi visual
    let orient = { alpha: 0, beta: 55, gamma: 0 };
    let focusDistM = null;

    const video = document.getElementById("video");
    const canvas = document.getElementById("overlay");
    const ctx = canvas ? canvas.getContext("2d") : null;
    const stage = document.getElementById("stage");
    const setupCard = document.getElementById("setup-card");
    const viewWrap = document.getElementById("view-wrap");
    const permErr = document.getElementById("perm-err");
    const roLabel = document.getElementById("ro-label");
    const roVal = document.getElementById("ro-val");
    const roMeta = document.getElementById("ro-meta");

    function needsOrientPerm() {
      return typeof DeviceOrientationEvent !== "undefined"
        && typeof DeviceOrientationEvent.requestPermission === "function";
    }

    function onOrient(e) {
      if (e.alpha != null) orient.alpha = e.alpha;
      if (e.beta != null) orient.beta = e.beta;
      if (e.gamma != null) orient.gamma = e.gamma;
    }

    function pollFocus() {
      try {
        if (!track || typeof track.getSettings !== "function") return;
        const s = track.getSettings();
        if (s && typeof s.focusDistance === "number" && s.focusDistance > 0.05 && s.focusDistance < 20) {
          focusDistM = s.focusDistance;
        }
      } catch (_) {}
    }

    /** Titik di permukaan yang sedang ditunjuk crosshair (bidang horizontal, mm) */
    function aimPoint() {
      const elev = (orient.beta - 90) * DEG; // negatif = menunduk
      let down = -elev;
      if (down < 8 * DEG) down = 8 * DEG;
      if (down > 80 * DEG) down = 80 * DEG;

      let horizMm;
      let mode = "sudut";
      if (focusDistM != null) {
        const dMm = focusDistM * 1000;
        horizMm = Math.abs(dMm * Math.cos(elev));
        if (horizMm < 80) horizMm = dMm * Math.sin(down);
        mode = "fokus";
      } else {
        horizMm = DEFAULT_H_MM / Math.tan(down);
      }
      if (!isFinite(horizMm) || horizMm < 50) return null;
      if (horizMm > 25000) horizMm = 25000;

      const yaw = orient.alpha * DEG;
      return {
        x: horizMm * Math.sin(yaw),
        y: horizMm * Math.cos(yaw),
        range: horizMm,
        mode: mode,
      };
    }

    function fmtMm(mm) {
      if (!isFinite(mm)) return "— mm";
      if (mm >= 1000) return (mm / 1000).toFixed(2) + " m";
      return Math.round(mm) + " mm";
    }

    function resizeOverlay() {
      if (!canvas || !stage) return;
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      if (w < 2 || h < 2) return;
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }
    }

    function draw() {
      if (!running || !ctx || !canvas) return;
      pollFocus();
      resizeOverlay();
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);

      const cur = aimPoint();
      const bx = w * 0.5;
      const by = h * 0.5;

      if (pointA && cur) {
        const ax = pointA.sx * w;
        const ay = pointA.sy * h;

        // garis A → B (crosshair)
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(bx, by);
        ctx.strokeStyle = "rgba(56,189,248,0.95)";
        ctx.lineWidth = 3;
        ctx.stroke();

        // titik A
        ctx.beginPath();
        ctx.arc(ax, ay, 12, 0, Math.PI * 2);
        ctx.fillStyle = "#fbbf24";
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = "#0f172a";
        ctx.stroke();
        ctx.font = "bold 13px system-ui,sans-serif";
        ctx.fillStyle = "#fbbf24";
        ctx.fillText("A", ax + 16, ay + 5);
        ctx.fillStyle = "#5eead4";
        ctx.fillText("B", bx + 14, by - 10);

        // Jarak radial di permukaan dari pusat A ke titik yang ditunjuk
        const dx = cur.x - pointA.x;
        const dy = cur.y - pointA.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (roVal) roVal.textContent = fmtMm(dist);
        if (roLabel) roLabel.textContent = "Jarak dari pusat A ke titik di crosshair";
        if (roMeta) {
          roMeta.textContent = (cur.mode === "fokus" ? "Skala fokusokus · " : "Skala sudut · ")
            + "putar kamera = angka berubah";
        }
      } else if (cur) {
        if (roVal) roVal.textContent = "D≈ " + fmtMm(cur.range);
        if (roLabel) roLabel.textContent = "Arahkan ke titik A · tekan Tandai A";
        if (roMeta) roMeta.textContent = cur.mode === "fokus" ? "Skala: fokus kamera" : "Skala: model sudut otomatis";
      } else {
        if (roVal) roVal.textContent = "— mm";
        if (roLabel) roLabel.textContent = "Miringkan kamera ke permukaan datar";
        if (roMeta) roMeta.textContent = "";
      }

      raf = requestAnimationFrame(draw);
    }

    async function openCam() {
      if (permErr) { permErr.hidden = true; permErr.textContent = ""; }
      try {
        if (!navigator.mediaDevices?.getUserMedia) throw new Error("Browser tidak mendukung kamera.");
        if (needsOrientPerm()) {
          const s = await DeviceOrientationEvent.requestPermission();
          if (s !== "granted") throw Object.assign(new Error("Izin orientasi ditolak."), { name: "NotAllowedError" });
        }
        window.addEventListener("deviceorientation", onOrient, true);

        stream = await navigator.mediaDevices.getUserMedia({
          audio: false,
          video: {
            facingMode: { ideal: "environment" },
            width: { ideal: 1280 },
            height: { ideal: 720 },
          },
        });
        track = stream.getVideoTracks()[0] || null;
        try {
          if (track && typeof track.applyConstraints === "function") {
            await track.applyConstraints({ advanced: [{ focusMode: "continuous" }] });
          }
        } catch (_) {}
        pollFocus();

        video.srcObject = stream;
        await video.play();
        running = true;
        pointA = null;
        if (setupCard) setupCard.hidden = true;
        if (viewWrap) viewWrap.hidden = false;
        if (roLabel) roLabel.textContent = "Tekan Tandai A (pusat)";
        if (roVal) roVal.textContent = "— mm";
        if (roMeta) roMeta.textContent = "Putar kamera saja sudah menghitung";
        resizeOverlay();
        draw();
      } catch (err) {
        let msg = "Gagal membuka kamera / sensor.";
        if (err?.name === "NotAllowedError") msg = "Izin ditolak. Izinkan kamera & orientasi di pengaturan situs.";
        else if (err?.message) msg = err.message;
        if (permErr) { permErr.textContent = msg; permErr.hidden = false; }
      }
    }

    function markA() {
      const cur = aimPoint();
      if (!cur) {
        if (roLabel) roLabel.textContent = "Belum bisa tandai A — miringkan ke permukaan datar";
        return;
      }
      pointA = {
        x: cur.x,
        y: cur.y,
        sx: 0.5,
        sy: 0.42,
      };
      if (roLabel) roLabel.textContent = "A ditandai · putar / geser kamera ke sekeliling";
      if (roMeta) roMeta.textContent = "Menjauh dari A = naik · mendekati A = turun";
    }

    function resetAll() {
      pointA = null;
      if (roLabel) roLabel.textContent = "Tekan Tandai A (pusat)";
      if (roVal) roVal.textContent = "— mm";
      if (roMeta) roMeta.textContent = "Putar kamera saja sudah menghitung";
    }

    function stop() {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      window.removeEventListener("deviceorientation", onOrient, true);
      if (stream) {
        stream.getTracks().forEach((t) => t.stop());
        stream = null;
      }
      track = null;
      focusDistM = null;
      if (video) video.srcObject = null;
      pointA = null;
      if (viewWrap) viewWrap.hidden = true;
      if (setupCard) setupCard.hidden = false;
    }

    document.getElementById("btn-open")?.addEventListener("click", openCam);
    document.getElementById("btn-a")?.addEventListener("click", markA);
    document.getElementById("btn-reset")?.addEventListener("click", resetAll);
    document.getElementById("btn-stop")?.addEventListener("click", stop);
    window.addEventListener("beforeunload", stop);
    window.addEventListener("resize", resizeOverlay);
  })();
  </script>

  <style>
    .ds-page { max-width: 720px; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
    .back { display: inline-flex; margin-bottom: 1rem; color: var(--muted,#94a3b8); text-decoration: none; font-size: .9rem; }
    .back:hover { color: var(--amber,#fbbf24); }
    .ds-badge {
      display: inline-block; font-size: .68rem; font-weight: 700; letter-spacing: .12em;
      color: #0f172a; background: linear-gradient(135deg,#2dd4bf,#38bdf8);
      padding: .28rem .65rem; border-radius: 999px; margin-bottom: .65rem;
    }
    .ds-hero h1 { font-size: clamp(1.5rem,4vw,2rem); margin: 0 0 .4rem; color: var(--ink,#f1f5f9); }
    .ds-lead { margin: 0; color: var(--muted,#94a3b8); line-height: 1.5; font-size: .92rem; }
    .ds-lead strong { color: #e2e8f0; }

    .setup-card {
      margin-top: 1rem; border-radius: 20px; padding: 1.35rem 1.2rem;
      border: 1px solid rgba(45,212,191,.3);
      background:
        radial-gradient(100% 80% at 50% 0%, rgba(45,212,191,.12), transparent 55%),
        var(--bg-card,#0f172a);
      box-shadow: 0 18px 48px rgba(0,0,0,.3);
    }
    .setup-ico { font-size: 2rem; margin-bottom: .5rem; }
    .setup-card h2 { margin: 0 0 .5rem; font-size: 1.2rem; }
    .setup-card p { color: var(--muted,#94a3b8); line-height: 1.5; font-size: .9rem; }
    .perm-warn {
      background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.3);
      border-radius: 12px; padding: .75rem .9rem; color: #fde68a !important;
    }
    .btn-perm {
      appearance: none; border: none; cursor: pointer; margin-top: .9rem;
      font-weight: 700; padding: .85rem 1.25rem; border-radius: 999px;
      color: #0f172a; background: linear-gradient(135deg,#5eead4,#38bdf8);
      box-shadow: 0 8px 24px rgba(45,212,191,.35);
    }
    .perm-err { margin-top: .75rem; color: #fca5a5; font-size: .88rem; }

    .stage {
      position: relative; width: 100%; margin-top: 1rem;
      border-radius: 16px; overflow: hidden; background: #000;
      aspect-ratio: 3 / 4; max-height: min(62vh, 520px);
      border: 1px solid rgba(45,212,191,.25); isolation: isolate;
    }
    #video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; z-index: 1; display: block;
    }
    #overlay {
      position: absolute; inset: 0; width: 100%; height: 100%;
      z-index: 2; pointer-events: none; display: block;
    }
    .crosshair {
      position: absolute; z-index: 3; left: 50%; top: 50%;
      width: 28px; height: 28px; transform: translate(-50%, -50%);
      pointer-events: none;
      border: 2px solid rgba(251,191,36,.95); border-radius: 50%;
      box-shadow: 0 0 0 1px rgba(0,0,0,.45);
      background:
        linear-gradient(#fbbf24,#fbbf24) center / 100% 2px no-repeat,
        linear-gradient(#fbbf24,#fbbf24) center / 2px 100% no-repeat;
    }

    .readout-bar {
      margin-top: 0.75rem; padding: 0.85rem 1rem; border-radius: 14px;
      background: rgba(15, 23, 42, 0.95);
      border: 1px solid rgba(45, 212, 191, 0.28);
      display: flex; flex-direction: column; gap: 0.15rem;
    }
    .ro-label { font-size: 0.8rem; color: #94a3b8; }
    .ro-val {
      font-size: 1.6rem; font-weight: 700; color: #5eead4;
      font-family: var(--font-mono, ui-monospace, monospace); line-height: 1.2;
    }
    .ro-meta { font-size: 0.72rem; color: #64748b; }

    .controls { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.85rem; }
    .btn-a, .btn-reset, .btn-stop {
      appearance: none; cursor: pointer; font-weight: 700;
      padding: 0.7rem 1.1rem; border-radius: 999px; border: none; font-size: 0.9rem;
    }
    .btn-a { color: #0f172a; background: linear-gradient(135deg, #fde68a, #f59e0b); }
    .btn-reset, .btn-stop {
      background: transparent; border: 1px solid rgba(148,163,184,.35); color: #e2e8f0;
    }
    .btn-stop:hover { border-color: #f87171; color: #fca5a5; }

    .warn {
      margin-top: 1rem; color: #fde68a; font-size: 0.82rem; line-height: 1.45;
      background: rgba(251,191,36,.08); border: 1px solid rgba(251,191,36,.25);
      border-radius: 12px; padding: 0.75rem 0.9rem;
    }
  </style>
</Layout>
