---
import Layout from "../../layouts/Layout.astro";
---
<Layout
  title="Pengukur jarak pendek — Partpedia"
  description="Ukur jarak titik A ke B dengan kamera + sensor gerak smartphone (mm). Estimasi konservatif — tidak menambah jarak saat HP diam."
>
  <div class="ds-page">
    <a class="back" href="/">← Beranda</a>

    <header class="ds-hero">
      <div class="ds-badge">KAMERA + IMU</div>
      <h1>Pengukur jarak pendek</h1>
      <p class="ds-lead">
        Tandai <strong>titik A</strong>, gerakkan HP ke tujuan (titik B).
        Jarak dihitung dari sensor gerak, satuan <strong>mm</strong>.
        Saat HP diam, angka <strong>tidak bertambah sendiri</strong>.
      </p>
    </header>

    <div class="setup-card" id="setup-card">
      <div class="setup-ico" aria-hidden="true">📏</div>
      <h2>Siapkan pengukuran</h2>
      <p>
        1. Buka kamera · 2. Arahkan ke titik A · 3. Tekan <strong>Tandai A</strong> ·
        4. Gerakkan HP menuju B (lurus, stabil) · 5. Berhenti di B — baca hasil.
      </p>
      <p class="perm-warn">
        Akan diminta <strong>izin kamera</strong>. Izin sensor hanya jika perangkat memintanya.
        Data tidak dikirim ke server.
      </p>
      <button type="button" class="btn-perm" id="btn-open">Buka kamera &amp; mulai</button>
      <p class="perm-err" id="perm-err" hidden></p>
    </div>

    <div class="view-wrap" id="view-wrap" hidden>
      <div class="stage" id="stage">
        <video id="video" playsinline muted autoplay></video>
        <canvas id="overlay"></canvas>
        <div class="crosshair" aria-hidden="true"></div>
      </div>

      <div class="readout-bar">
        <span class="ro-label" id="ro-label">Tekan Tandai A untuk mulai menghitung</span>
        <span class="ro-val" id="ro-val">0 mm</span>
      </div>

      <div class="controls">
        <button type="button" class="btn-a" id="btn-a">Tandai titik A</button>
        <button type="button" class="btn-reset" id="btn-reset">Reset</button>
        <button type="button" class="btn-stop" id="btn-stop">Tutup</button>
      </div>

      <p class="warn">
        Estimasi sensor HP (bukan laser). Dirancang agar <strong>tidak menambah jarak saat diam</strong>.
        Gerakan goyang kecil diabaikan. Cocok jarak pendek; hasil tetap perkiraan.
      </p>
    </div>
  </div>

  <script is:inline>
  (function () {
    let stream = null;
    let running = false;
    let measuring = false;
    let raf = 0;
    let lastT = 0;
    let markA = null;

    // Conservative IMU
    let vx = 0, vy = 0, vz = 0;
    let pathM = 0;
    let displayM = 0;
    let gx = 0, gy = 0, gz = 9.81;
    let gravReady = false;
    let stillMs = 0;
    let moveMs = 0;
    const MAX_SPEED = 2.2;      // m/s — batasi kecepatan tidak masuk akal
    const MAX_PATH = 12;        // m — batas tool jarak pendek
    const ACC_DEAD = 0.35;      // m/s² — di bawah ini dianggap noise
    const STILL_ZUPT = 150;     // ms diam → velocity = 0
    const MIN_STEP = 0.0008;    // m per frame — abaikan langkah numerik kecil

    let orient = { alpha: 0, beta: 90, gamma: 0 };

    const video = document.getElementById("video");
    const canvas = document.getElementById("overlay");
    const ctx = canvas ? canvas.getContext("2d") : null;
    const stage = document.getElementById("stage");
    const setupCard = document.getElementById("setup-card");
    const viewWrap = document.getElementById("view-wrap");
    const permErr = document.getElementById("perm-err");
    const roLabel = document.getElementById("ro-label");
    const roVal = document.getElementById("ro-val");

    function needsMotionPerm() {
      return typeof DeviceMotionEvent !== "undefined"
        && typeof DeviceMotionEvent.requestPermission === "function";
    }
    function needsOrientPerm() {
      return typeof DeviceOrientationEvent !== "undefined"
        && typeof DeviceOrientationEvent.requestPermission === "function";
    }

    function onOrient(e) {
      if (e.alpha != null) orient.alpha = e.alpha;
      if (e.beta != null) orient.beta = e.beta;
      if (e.gamma != null) orient.gamma = e.gamma;
    }

    function toWorld(ax, ay, az) {
      const a = orient.alpha * Math.PI / 180;
      const b = orient.beta * Math.PI / 180;
      const g = orient.gamma * Math.PI / 180;
      const ca = Math.cos(a), sa = Math.sin(a);
      const cb = Math.cos(b), sb = Math.sin(b);
      const cg = Math.cos(g), sg = Math.sin(g);
      const x1 = cg * ax + sg * az;
      const y1 = ay;
      const z1 = -sg * ax + cg * az;
      const x2 = x1;
      const y2 = cb * y1 - sb * z1;
      const z2 = sb * y1 + cb * z1;
      return { x: ca * x2 - sa * y2, y: sa * x2 + ca * y2, z: z2 };
    }

    function showDist() {
      const mm = displayM * 1000;
      if (roVal) {
        roVal.textContent = mm >= 1000 ? (mm / 1000).toFixed(2) + " m" : Math.round(mm) + " mm";
      }
    }

    function onMotion(e) {
      if (!running) return;
      const t = e.timeStamp || performance.now();
      if (!lastT) { lastT = t; return; }
      let dt = (t - lastT) / 1000;
      lastT = t;
      if (dt <= 0 || dt > 0.08) dt = 0.02;

      let ax = 0, ay = 0, az = 0;
      if (e.acceleration && e.acceleration.x != null) {
        ax = e.acceleration.x || 0;
        ay = e.acceleration.y || 0;
        az = e.acceleration.z || 0;
      } else if (e.accelerationIncludingGravity) {
        const ix = e.accelerationIncludingGravity.x || 0;
        const iy = e.accelerationIncludingGravity.y || 0;
        const iz = e.accelerationIncludingGravity.z || 0;
        if (!gravReady) {
          gx = ix; gy = iy; gz = iz;
          gravReady = true;
        } else {
          // gravity lambat — jangan ikut getaran tangan
          const ag = 0.96;
          gx = ag * gx + (1 - ag) * ix;
          gy = ag * gy + (1 - ag) * iy;
          gz = ag * gz + (1 - ag) * iz;
        }
        ax = ix - gx;
        ay = iy - gy;
        az = iz - gz;
      } else {
        return;
      }

      const amag = Math.sqrt(ax * ax + ay * ay + az * az);

      // Dead-zone: noise / goyangan kecil tidak dihitung
      if (amag < ACC_DEAD) {
        ax = ay = az = 0;
        stillMs += dt * 1000;
        moveMs = 0;
      } else {
        stillMs = 0;
        moveMs += dt * 1000;
      }

      // Saat diam: hentikan kecepatan → jarak tidak “jalan sendiri”
      if (stillMs > STILL_ZUPT) {
        vx = vy = vz = 0;
        if (measuring && roLabel) {
          roLabel.textContent = pathM > 0.001 ? "Diam — hasil ditahan" : "Titik A · gerakkan HP ke B";
        }
        // soft-snap tampilan ke path (tanpa naik)
        displayM = pathM;
        showDist();
        return;
      }

      if (!measuring) return;

      // Hanya akumulasi jika gerakan sudah “nyata” sebentar (hindari spike)
      const w = toWorld(ax, ay, az);
      if (moveMs < 40) {
        // gerakan terlalu singkat → jangan integrasi penuh
        return;
      }

      vx += w.x * dt;
      vy += w.y * dt;
      vz += w.z * dt;

      // Batasi kecepatan
      const sp = Math.sqrt(vx * vx + vy * vy + vz * vz);
      if (sp > MAX_SPEED) {
        const s = MAX_SPEED / sp;
        vx *= s; vy *= s; vz *= s;
      }

      // Damping kuat saat akselerasi lemah
      if (amag < ACC_DEAD * 1.5) {
        const d = Math.pow(0.92, dt * 60);
        vx *= d; vy *= d; vz *= d;
      }

      const dx = vx * dt;
      const dy = vy * dt;
      const dz = vz * dt;
      const step = Math.sqrt(dx * dx + dy * dy + dz * dz);

      if (step >= MIN_STEP) {
        pathM = Math.min(MAX_PATH, pathM + step);
      }

      // Tampilkan dengan sedikit smoothing (tidak loncat liar)
      displayM = displayM * 0.85 + pathM * 0.15;
      if (pathM - displayM < 0.002) displayM = pathM;

      showDist();
      if (roLabel) roLabel.textContent = "Mengukur… teruskan ke B, lalu diamkan";
    }

    function resizeOverlay() {
      if (!video || !canvas || !stage) return;
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      if (w < 2 || h < 2) return;
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }
    }

    function drawOverlay() {
      if (!running || !ctx || !canvas) return;
      resizeOverlay();
      const w = canvas.width;
      const h = canvas.height;
      ctx.clearRect(0, 0, w, h);
      const bx = w * 0.5;
      const by = h * 0.5;
      if (markA) {
        const ax = markA.sx * w;
        const ay = markA.sy * h;
        ctx.beginPath();
        ctx.moveTo(ax, ay);
        ctx.lineTo(bx, by);
        ctx.strokeStyle = "rgba(56,189,248,0.95)";
        ctx.lineWidth = 3;
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(ax, ay, 12, 0, Math.PI * 2);
        ctx.fillStyle = "#fbbf24";
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = "#0f172a";
        ctx.stroke();
        ctx.font = "bold 13px system-ui,sans-serif";
        ctx.fillStyle = "#fbbf24";
        ctx.fillText("A", ax + 16, ay + 5);
        ctx.fillStyle = "#5eead4";
        ctx.fillText("B", bx + 14, by - 10);
      }
      raf = requestAnimationFrame(drawOverlay);
    }

    async function openCam() {
      if (permErr) { permErr.hidden = true; permErr.textContent = ""; }
      try {
        if (!navigator.mediaDevices?.getUserMedia) throw new Error("Browser tidak mendukung kamera.");
        if (needsOrientPerm()) {
          const s = await DeviceOrientationEvent.requestPermission();
          if (s !== "granted") throw Object.assign(new Error("Izin orientasi ditolak."), { name: "NotAllowedError" });
        }
        if (needsMotionPerm()) {
          const s = await DeviceMotionEvent.requestPermission();
          if (s !== "granted") throw Object.assign(new Error("Izin sensor gerak ditolak."), { name: "NotAllowedError" });
        }
        window.addEventListener("deviceorientation", onOrient, true);
        window.addEventListener("devicemotion", onMotion, true);

        stream = await navigator.mediaDevices.getUserMedia({
          audio: false,
          video: { facingMode: { ideal: "environment" }, width: { ideal: 1280 }, height: { ideal: 720 } },
        });
        video.srcObject = stream;
        await video.play();
        running = true;
        measuring = false;
        markA = null;
        pathM = displayM = 0;
        vx = vy = vz = 0;
        lastT = 0;
        gravReady = false;
        if (setupCard) setupCard.hidden = true;
        if (viewWrap) viewWrap.hidden = false;
        if (roLabel) roLabel.textContent = "Tekan Tandai A untuk mulai menghitung";
        if (roVal) roVal.textContent = "0 mm";
        resizeOverlay();
        drawOverlay();
      } catch (err) {
        let msg = "Gagal membuka kamera / sensor.";
        if (err?.name === "NotAllowedError") msg = "Izin ditolak. Izinkan kamera & sensor di pengaturan situs.";
        else if (err?.message) msg = err.message;
        if (permErr) { permErr.textContent = msg; permErr.hidden = false; }
      }
    }

    function markAPoint() {
      markA = { sx: 0.5, sy: 0.5 };
      pathM = displayM = 0;
      vx = vy = vz = 0;
      stillMs = 0;
      moveMs = 0;
      lastT = 0;
      measuring = true;
      if (roLabel) roLabel.textContent = "Titik A · gerakkan HP ke B";
      if (roVal) roVal.textContent = "0 mm";
    }

    function resetAll() {
      measuring = false;
      markA = null;
      pathM = displayM = 0;
      vx = vy = vz = 0;
      lastT = 0;
      if (roLabel) roLabel.textContent = "Tekan Tandai A untuk mulai menghitung";
      if (roVal) roVal.textContent = "0 mm";
    }

    function stop() {
      running = false;
      measuring = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      window.removeEventListener("deviceorientation", onOrient, true);
      window.removeEventListener("devicemotion", onMotion, true);
      if (stream) {
        stream.getTracks().forEach((t) => t.stop());
        stream = null;
      }
      if (video) video.srcObject = null;
      markA = null;
      if (viewWrap) viewWrap.hidden = true;
      if (setupCard) setupCard.hidden = false;
    }

    document.getElementById("btn-open")?.addEventListener("click", openCam);
    document.getElementById("btn-a")?.addEventListener("click", markAPoint);
    document.getElementById("btn-reset")?.addEventListener("click", resetAll);
    document.getElementById("btn-stop")?.addEventListener("click", stop);
    window.addEventListener("beforeunload", stop);
    window.addEventListener("resize", resizeOverlay);
  })();
  </script>

  <style>
    .ds-page { max-width: 720px; margin: 0 auto; padding: 1.25rem 1rem 3rem; }
    .back { display: inline-flex; margin-bottom: 1rem; color: var(--muted,#94a3b8); text-decoration: none; font-size: .9rem; }
    .back:hover { color: var(--amber,#fbbf24); }
    .ds-badge {
      display: inline-block; font-size: .68rem; font-weight: 700; letter-spacing: .12em;
      color: #0f172a; background: linear-gradient(135deg,#2dd4bf,#38bdf8);
      padding: .28rem .65rem; border-radius: 999px; margin-bottom: .65rem;
    }
    .ds-hero h1 { font-size: clamp(1.5rem,4vw,2rem); margin: 0 0 .4rem; color: var(--ink,#f1f5f9); }
    .ds-lead { margin: 0 0 0.5rem; color: var(--muted,#94a3b8); line-height: 1.5; font-size: .92rem; }
    .ds-lead strong { color: #e2e8f0; }

    .setup-card {
      margin-top: 1rem; border-radius: 20px; padding: 1.35rem 1.2rem;
      border: 1px solid rgba(45,212,191,.3);
      background:
        radial-gradient(100% 80% at 50% 0%, rgba(45,212,191,.12), transparent 55%),
        var(--bg-card,#0f172a);
      box-shadow: 0 18px 48px rgba(0,0,0,.3);
    }
    .setup-ico { font-size: 2rem; margin-bottom: .5rem; }
    .setup-card h2 { margin: 0 0 .5rem; font-size: 1.2rem; }
    .setup-card p { color: var(--muted,#94a3b8); line-height: 1.5; font-size: .9rem; }
    .perm-warn {
      background: rgba(251,191,36,.1); border: 1px solid rgba(251,191,36,.3);
      border-radius: 12px; padding: .75rem .9rem; color: #fde68a !important;
    }
    .btn-perm {
      appearance: none; border: none; cursor: pointer; margin-top: .9rem;
      font-weight: 700; padding: .85rem 1.25rem; border-radius: 999px;
      color: #0f172a; background: linear-gradient(135deg,#5eead4,#38bdf8);
      box-shadow: 0 8px 24px rgba(45,212,191,.35);
    }
    .perm-err { margin-top: .75rem; color: #fca5a5; font-size: .88rem; }

    .stage {
      position: relative;
      width: 100%;
      margin-top: 1rem;
      border-radius: 16px;
      overflow: hidden;
      background: #000;
      aspect-ratio: 3 / 4;
      max-height: min(62vh, 520px);
      border: 1px solid rgba(45,212,191,.25);
      isolation: isolate;
    }
    #video {
      position: absolute; inset: 0; width: 100%; height: 100%;
      object-fit: cover; z-index: 1; display: block;
    }
    #overlay {
      position: absolute; inset: 0; width: 100%; height: 100%;
      z-index: 2; pointer-events: none; display: block;
    }
    .crosshair {
      position: absolute; z-index: 3; left: 50%; top: 50%;
      width: 28px; height: 28px; transform: translate(-50%, -50%);
      pointer-events: none;
      border: 2px solid rgba(251,191,36,.95); border-radius: 50%;
      box-shadow: 0 0 0 1px rgba(0,0,0,.45);
      background:
        linear-gradient(#fbbf24,#fbbf24) center / 100% 2px no-repeat,
        linear-gradient(#fbbf24,#fbbf24) center / 2px 100% no-repeat;
    }

    .readout-bar {
      margin-top: 0.75rem; padding: 0.85rem 1rem; border-radius: 14px;
      background: rgba(15, 23, 42, 0.95);
      border: 1px solid rgba(45, 212, 191, 0.28);
      display: flex; flex-direction: column; gap: 0.2rem;
    }
    .ro-label { font-size: 0.8rem; color: #94a3b8; }
    .ro-val {
      font-size: 1.6rem; font-weight: 700; color: #5eead4;
      font-family: var(--font-mono, ui-monospace, monospace); line-height: 1.2;
    }

    .controls { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 0.85rem; }
    .btn-a, .btn-reset, .btn-stop {
      appearance: none; cursor: pointer; font-weight: 700;
      padding: 0.7rem 1.1rem; border-radius: 999px; border: none; font-size: 0.9rem;
    }
    .btn-a { color: #0f172a; background: linear-gradient(135deg, #fde68a, #f59e0b); }
    .btn-reset, .btn-stop {
      background: transparent; border: 1px solid rgba(148,163,184,.35); color: #e2e8f0;
    }
    .btn-stop:hover { border-color: #f87171; color: #fca5a5; }

    .warn {
      margin-top: 1rem; color: #fde68a; font-size: 0.82rem; line-height: 1.45;
      background: rgba(251,191,36,.08); border: 1px solid rgba(251,191,36,.25);
      border-radius: 12px; padding: 0.75rem 0.9rem;
    }
  </style>
</Layout>
