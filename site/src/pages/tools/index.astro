---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Smart Tools — Partpedia" description="21 utilitas perhitungan industri: geometri, material, mekanik, listrik, dan produksi.">
  <section class="hub">
    <header class="hub-head">
      <p class="kicker">Smart Tools</p>
      <h1>Utilitas perhitungan industri</h1>
      <p>Pilih alat seperti membuka app — geometri, material, mekanik, listrik, hingga metrik produksi. Isi nilai yang diketahui; sisi lain dihitung otomatis.</p>
    </header>
    <div class="app-grid">
      <a class="app-icon" href="/tools/pythagoras/">
        <div class="app-face" style="background: linear-gradient(145deg, #f59e0bcc, #f59e0b66);">△</div>
        <span class="app-name">Pythagoras</span>
        <span class="app-sub">Segitiga siku-siku</span>
      </a>
      <a class="app-icon" href="/tools/trigonometry/">
        <div class="app-face" style="background: linear-gradient(145deg, #f97316cc, #f9731666);">∠</div>
        <span class="app-name">Trigonometri</span>
        <span class="app-sub">Sudut & sisi</span>
      </a>
      <a class="app-icon" href="/tools/distance-speed-time/">
        <div class="app-face" style="background: linear-gradient(145deg, #06b6d4cc, #06b6d466);">⏱️</div>
        <span class="app-name">Jarak · Kecepatan</span>
        <span class="app-sub">Waktu tempuh</span>
      </a>
      <a class="app-icon" href="/tools/circle/">
        <div class="app-face" style="background: linear-gradient(145deg, #3b82f6cc, #3b82f666);">○</div>
        <span class="app-name">Lingkaran</span>
        <span class="app-sub">Keliling · Diameter</span>
      </a>
      <a class="app-icon" href="/tools/cylinder/">
        <div class="app-face" style="background: linear-gradient(145deg, #6366f1cc, #6366f166);">🥫</div>
        <span class="app-name">Volume Tabung</span>
        <span class="app-sub">π × R² × T</span>
      </a>
      <a class="app-icon" href="/tools/box-volume/">
        <div class="app-face" style="background: linear-gradient(145deg, #8b5cf6cc, #8b5cf666);">📦</div>
        <span class="app-name">Volume Balok</span>
        <span class="app-sub">P × L × T</span>
      </a>
      <a class="app-icon" href="/tools/mass-volume-density/">
        <div class="app-face" style="background: linear-gradient(145deg, #a855f7cc, #a855f766);">⚖️</div>
        <span class="app-name">Massa · Volume</span>
        <span class="app-sub">Density</span>
      </a>
      <a class="app-icon" href="/tools/material-weight/">
        <div class="app-face" style="background: linear-gradient(145deg, #d946efcc, #d946ef66);">🧱</div>
        <span class="app-name">Berat Material</span>
        <span class="app-sub">Density × Volume</span>
      </a>
      <a class="app-icon" href="/tools/dimensions/">
        <div class="app-face" style="background: linear-gradient(145deg, #ec4899cc, #ec489966);">📏</div>
        <span class="app-name">Dimensi · Density</span>
        <span class="app-sub">P · L · T · ρ · m</span>
      </a>
      <a class="app-icon" href="/tools/pipe/">
        <div class="app-face" style="background: linear-gradient(145deg, #f43f5ecc, #f43f5e66);">⭕</div>
        <span class="app-name">Pipa OD · ID</span>
        <span class="app-sub">Thickness</span>
      </a>
      <a class="app-icon" href="/tools/rpm-speed/">
        <div class="app-face" style="background: linear-gradient(145deg, #14b8a6cc, #14b8a666);">🔄</div>
        <span class="app-name">RPM · Kecepatan</span>
        <span class="app-sub">Surface speed</span>
      </a>
      <a class="app-icon" href="/tools/gear-ratio/">
        <div class="app-face" style="background: linear-gradient(145deg, #10b981cc, #10b98166);">⚙️</div>
        <span class="app-name">Gear Ratio</span>
        <span class="app-sub">Putaran · Gigi</span>
      </a>
      <a class="app-icon" href="/tools/torque-power/">
        <div class="app-face" style="background: linear-gradient(145deg, #22c55ecc, #22c55e66);">💪</div>
        <span class="app-name">Torsi · Power</span>
        <span class="app-sub">RPM</span>
      </a>
      <a class="app-icon" href="/tools/force-mass/">
        <div class="app-face" style="background: linear-gradient(145deg, #84cc16cc, #84cc1666);">⬇️</div>
        <span class="app-name">Gaya · Massa</span>
        <span class="app-sub">Percepatan</span>
      </a>
      <a class="app-icon" href="/tools/pressure/">
        <div class="app-face" style="background: linear-gradient(145deg, #eab308cc, #eab30866);">🗜️</div>
        <span class="app-name">Tekanan · Gaya</span>
        <span class="app-sub">Area</span>
      </a>
      <a class="app-icon" href="/tools/flow/">
        <div class="app-face" style="background: linear-gradient(145deg, #0ea5e9cc, #0ea5e966);">💧</div>
        <span class="app-name">Flow · Volume</span>
        <span class="app-sub">Waktu</span>
      </a>
      <a class="app-icon" href="/tools/electrical/">
        <div class="app-face" style="background: linear-gradient(145deg, #eab308cc, #eab30866);">⚡</div>
        <span class="app-name">Listrik V·A·Ω</span>
        <span class="app-sub">Power</span>
      </a>
      <a class="app-icon" href="/tools/cycle-time/">
        <div class="app-face" style="background: linear-gradient(145deg, #f97316cc, #f9731666);">🔁</div>
        <span class="app-name">Cycle Time</span>
        <span class="app-sub">Production rate</span>
      </a>
      <a class="app-icon" href="/tools/takt-time/">
        <div class="app-face" style="background: linear-gradient(145deg, #ef4444cc, #ef444466);">🎯</div>
        <span class="app-name">Takt Time</span>
        <span class="app-sub">Waktu · Demand</span>
      </a>
      <a class="app-icon" href="/tools/reliability/">
        <div class="app-face" style="background: linear-gradient(145deg, #8b5cf6cc, #8b5cf666);">📈</div>
        <span class="app-name">MTBF · MTTR</span>
        <span class="app-sub">Availability</span>
      </a>
      <a class="app-icon" href="/tools/production-rate/">
        <div class="app-face" style="background: linear-gradient(145deg, #64748bcc, #64748b66);">🏭</div>
        <span class="app-name">Production Rate</span>
        <span class="app-sub">Qty · Waktu</span>
      </a>
    </div>
  </section>
  <style>

  .hub { max-width: 920px; margin: 0 auto; padding: 1.35rem 0 3rem; }
  .hub-head { text-align: center; margin-bottom: 1.5rem; }
  .kicker { margin:0 0 0.4rem; font-family: var(--font-mono); font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase; color: var(--teal); }
  .hub-head h1 { margin:0 0 0.45rem; font-family: var(--font-display); font-size: clamp(1.55rem,4vw,2.15rem); letter-spacing:-0.02em; }
  .hub-head p { margin:0 auto; max-width:34rem; color: var(--muted); line-height:1.55; font-size:0.98rem; }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem 0.65rem;
    justify-items: center;
  }
  @media (max-width: 520px) {
    .app-grid { grid-template-columns: repeat(3, 1fr); gap: 0.75rem 0.4rem; }
  }
  .app-icon {
    width: 100%;
    max-width: 110px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .app-icon:hover, .app-icon:focus-visible {
    transform: scale(1.08);
  }
  .app-icon:active { transform: scale(0.96); }
  .app-face {
    width: 72px; height: 72px;
    border-radius: 18px;
    display: grid; place-items: center;
    font-size: 1.85rem;
    box-shadow: 0 10px 24px rgba(0,0,0,0.28), inset 0 1px 0 rgba(255,255,255,0.25);
    border: 1px solid rgba(255,255,255,0.18);
  }
  @media (min-width: 640px) {
    .app-face { width: 84px; height: 84px; border-radius: 22px; font-size: 2.1rem; }
    .app-icon { max-width: 120px; }
  }
  .app-name {
    font-size: 0.72rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.25;
    color: var(--ink);
  }
  .app-sub {
    font-size: 0.65rem;
    color: var(--muted);
    text-align: center;
    line-height: 1.2;
    margin-top: -0.15rem;
  }

  </style>
</Layout>
