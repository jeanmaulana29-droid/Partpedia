---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Panjang Belt — Smart Tools · Partpedia" description="Perkiraan panjang belt terbuka (open belt) dari jarak poros dan diameter pulley.">
  <div class="tool-page">
    <a class="back" href="/tools/">← Semua Smart Tools</a>
    <div class="tool-card">
      <h1>Panjang Belt</h1>
      <p class="desc">Perkiraan panjang belt terbuka (open belt) dari jarak poros dan diameter pulley.</p>
      <div class="formula">L ≈ 2C + π(D₁+D₂)/2 + (D₁−D₂)²/(4C)</div>
      <div class="fields cols-2">
      <div class="field"><label for="c">Jarak poros C <span>(mm)</span></label><input id="c" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      <div class="field"><label for="d1">Diameter D₁ <span>(mm)</span></label><input id="d1" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      <div class="field"><label for="d2">Diameter D₂ <span>(mm)</span></label><input id="d2" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      <div class="field"><label for="l">Panjang L <span>(mm)</span></label><input id="l" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      </div>
      <div class="actions">
        <button type="button" class="btn-calc" id="btn-calc">Hitung</button>
        <button type="button" class="btn-reset" id="btn-reset">Reset</button>
        <p class="msg" id="msg" role="status"></p>
      </div>
      <p class="hint"><strong>Satuan:</strong> gunakan satuan pada label secara konsisten. Isi nilai yang diketahui, kosongkan yang dicari. Kolom hasil ditandai tosca. Rumus open-belt klasik. Untuk belt timing/V-belt profil khusus, verifikasi ke katalog pabrikan.</p>
    </div>
  </div>
  <script is:inline>

  function parseNum(el) {
    if (!el) return null;
    let v = String(el.value||"").trim().replace(",", ".");
    if (v === "") return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : NaN;
  }
  function fmt(x) {
    if (!Number.isFinite(x)) return "";
    const a = Math.abs(x);
    if (a !== 0 && (a < 1e-7 || a >= 1e10)) return x.toExponential(8);
    return x.toFixed(10).replace(/\.?0+$/, "");
  }
  function clearComputed(ids) {
    ids.forEach((id) => {
      const el = document.getElementById(id);
      const field = el?.closest(".field");
      field?.classList.remove("is-result");
      if (el?.dataset.computed === "1") { el.value = ""; delete el.dataset.computed; }
    });
  }
  function setResult(id, value) {
    const el = document.getElementById(id);
    if (!el) return;
    el.value = fmt(value);
    el.dataset.computed = "1";
    el.closest(".field")?.classList.add("is-result");
  }
  function wire(ids, compute) {
    const msg = document.getElementById("msg");
    ids.forEach((id) => {
      const el = document.getElementById(id);
      el?.addEventListener("input", () => {
        if (el.dataset.computed === "1") {
          delete el.dataset.computed;
          el.closest(".field")?.classList.remove("is-result");
        } else {
          clearComputed(ids);
        }
        const filled = ids.filter((i) => { const v = parseNum(document.getElementById(i)); return v !== null && !Number.isNaN(v); }).length;
        if (filled >= 2) compute();
        else if (msg) msg.textContent = "";
      });
      el?.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); compute(); } });
    });
    document.getElementById("btn-calc")?.addEventListener("click", compute);
    document.getElementById("btn-reset")?.addEventListener("click", () => {
      ids.forEach((id) => {
        const el = document.getElementById(id);
        if (el) { el.value = ""; delete el.dataset.computed; }
        el?.closest(".field")?.classList.remove("is-result");
      });
      if (msg) msg.textContent = "";
    });
  }

    (function(){
      const ids = ["c", "d1", "d2", "l"];
      const msg = document.getElementById("msg");
      function compute() {
        clearComputed(ids);
        
    const c=parseNum(document.getElementById("c"));
    const d1=parseNum(document.getElementById("d1"));
    const d2=parseNum(document.getElementById("d2"));
    const l=parseNum(document.getElementById("l"));
    if ([c,d1,d2,l].some(x=>x!==null&&(Number.isNaN(x)||x<0))) { msg.textContent="Nilai harus ≥ 0"; return; }
    if (l===null && c!==null && d1!==null && d2!==null) {
      if (c===0){ msg.textContent="C tidak boleh 0"; return; }
      const L = 2*c + Math.PI*(d1+d2)/2 + Math.pow(d1-d2,2)/(4*c);
      setResult("l", L);
      msg.textContent="L dihitung (open belt)";
      return;
    }
    // approximate C from L (iterative / quadratic simplified): use only when D known
    if (c===null && l!==null && d1!==null && d2!==null) {
      // L = 2C + π(D1+D2)/2 + (D1-D2)^2/(4C)
      // 2C + K/(4C) = L - π(D1+D2)/2  where K=(D1-D2)^2
      const rhs = l - Math.PI*(d1+d2)/2;
      const K = Math.pow(d1-d2,2);
      // 2C + K/(4C) = rhs → 8C^2 - 4*rhs*C + K = 0
      const A=8, B=-4*rhs, Cq=K;
      const disc = B*B - 4*A*Cq;
      if (disc < 0){ msg.textContent="Tidak ada solusi C"; return; }
      const c1 = (-B + Math.sqrt(disc))/(2*A);
      const c2 = (-B - Math.sqrt(disc))/(2*A);
      const cPick = Math.max(c1,c2);
      if (cPick <= 0){ msg.textContent="C hasil tidak valid"; return; }
      setResult("c", cPick);
      msg.textContent="C diaproksimasi dari L";
      return;
    }
    msg.textContent="Isi C, D₁, D₂ untuk L — atau L, D₁, D₂ untuk C";
  
      }
      wire(ids, compute);
    })();
  </script>

<style>
  .tool-page { max-width: 720px; margin: 0 auto; padding: 1.25rem 0 3rem; }
  .back { display:inline-flex; align-items:center; gap:0.35rem; font-size:0.88rem; color: var(--muted); text-decoration:none; margin-bottom:0.85rem; }
  .back:hover { color: var(--amber); }
  .tool-card {
    border:1px solid var(--line); border-radius:22px; padding:1.25rem;
    background: radial-gradient(120% 80% at 0% 0%, rgba(45,212,191,0.08), transparent 50%), var(--bg-card);
    box-shadow: 0 18px 48px rgba(0,0,0,0.2);
  }
  .tool-card h1 { margin:0 0 0.35rem; font-family: var(--font-display); font-size:1.45rem; }
  .tool-card .desc { margin:0 0 1rem; color: var(--muted); font-size:0.92rem; line-height:1.5; }
  .formula { display:inline-block; font-family: var(--font-mono); font-size:0.85rem; color: var(--amber);
    border:1px solid rgba(240,164,58,0.35); background:rgba(240,164,58,0.08); padding:0.35rem 0.65rem; border-radius:999px; margin-bottom:1rem; }
  .fields { display:grid; gap:0.75rem; }
  @media(min-width:560px){ .fields.cols-2{ grid-template-columns:1fr 1fr;} .fields.cols-3{ grid-template-columns:1fr 1fr 1fr;} .fields.cols-4{ grid-template-columns:1fr 1fr;} }
  .field { display:flex; flex-direction:column; gap:0.35rem; padding:0.75rem 0.85rem; border-radius:14px;
    border:1px solid var(--line); background:rgba(0,0,0,0.22); transition: border-color .15s, background .15s, box-shadow .15s; }
  .field label { font-size:0.8rem; font-weight:600; color: var(--ink); }
  .field label span { font-weight:500; color: var(--muted); font-size:0.75rem; }
  .field input { border:none; outline:none; background:transparent; color: var(--ink); font-size:1.25rem; font-weight:700; font-family: var(--font-mono); width:100%; }
  .field.is-result { border-color: rgba(45,212,191,0.65); background: rgba(45,212,191,0.12); box-shadow:0 0 0 3px rgba(45,212,191,0.12); }
  .field.is-result label { color: var(--teal); }
  .actions { display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; margin-top:1rem; }
  .btn-calc { appearance:none; border:none; cursor:pointer; font-weight:800; padding:0.7rem 1.25rem; border-radius:999px;
    background: linear-gradient(135deg,#2dd4bf,#14b8a6); color:#041016; }
  .btn-reset { appearance:none; cursor:pointer; font-weight:600; padding:0.65rem 1.1rem; border-radius:999px;
    background:transparent; border:1px solid var(--line); color: var(--ink); }
  .msg { margin:0; font-size:0.86rem; color: var(--muted); }
  .hint { margin-top:1rem; padding:0.75rem 0.9rem; border-radius:12px; border:1px solid rgba(255,255,255,0.08);
    background:rgba(255,255,255,0.03); font-size:0.84rem; color: var(--muted); line-height:1.45; }
</style>

</Layout>
