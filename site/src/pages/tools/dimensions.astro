---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Panjang · Lebar · Tebal · Density · Massa — Smart Tools · Partpedia" description="Density ρ (g/cm³) wajib. Panjang (m), lebar & tebal (mm), massa (kg). Kosongkan satu variabel yang dicari.">
  <div class="tool-page">
    <a class="back" href="/tools/">← Semua Smart Tools</a>
    <div class="tool-card">
      <h1>Panjang · Lebar · Tebal · Density · Massa</h1>
      <p class="desc">Density (ρ) wajib diisi. Satuan: ρ = g/cm³, P = m, L = mm, T = mm, m = kg. Kosongkan satu variabel yang dicari. Ubah nilai → hasil ikut terhitung ulang otomatis.</p>
      <div class="formula">m = ρ × P × L × T ÷ 1000</div>
      <div class="fields cols-2">
      <div class="field"><label for="rho">Density ρ <span>(g/cm³ — wajib)</span></label><input id="rho" type="number" inputmode="decimal" step="any" placeholder="mis. 7.85 baja" autocomplete="off" /></div>
      <div class="field"><label for="p">Panjang P <span>(m)</span></label><input id="p" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      <div class="field"><label for="l">Lebar L <span>(mm)</span></label><input id="l" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      <div class="field"><label for="t">Tebal T <span>(mm)</span></label><input id="t" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      <div class="field"><label for="m">Massa m <span>(kg)</span></label><input id="m" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" /></div>
      </div>
      <div class="actions">
        <button type="button" class="btn-calc" id="btn-calc">Hitung</button>
        <button type="button" class="btn-reset" id="btn-reset">Reset</button>
        <p class="msg" id="msg" role="status"></p>
      </div>
      <p class="hint"><strong>Rumus:</strong> m (kg) = ρ (g/cm³) × P (m) × L (mm) × T (mm) / 1000. Contoh baja: ρ=7.85, P=1, L=1000, T=10 → m=78.5 kg. Setelah hasil muncul, ubah angka lain — hasil terhitung ulang tanpa Reset.</p>
    </div>
  </div>
  <script is:inline>
  function parseNum(el) {
    if (!el) return null;
    let v = String(el.value || "").trim().replace(",", ".");
    if (v === "") return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : NaN;
  }
  function fmt(x) {
    if (!Number.isFinite(x)) return "";
    const a = Math.abs(x);
    if (a !== 0 && (a < 1e-7 || a >= 1e10)) return x.toExponential(8);
    return x.toFixed(10).replace(/\.?0+$/, "");
  }
  /** Sama seperti Pythagoras: hapus nilai yang tadi diisi otomatis (hasil). */
  function clearComputed(ids) {
    ids.forEach((id) => {
      const el = document.getElementById(id);
      const field = el?.closest(".field");
      field?.classList.remove("is-result");
      if (el?.dataset.computed === "1") {
        el.value = "";
        delete el.dataset.computed;
      }
    });
  }
  function setResult(id, value) {
    const el = document.getElementById(id);
    if (!el) return;
    el.value = fmt(value);
    el.dataset.computed = "1";
    el.closest(".field")?.classList.add("is-result");
  }
  function wire(ids, compute) {
    const msg = document.getElementById("msg");
    ids.forEach((id) => {
      const el = document.getElementById(id);
      el?.addEventListener("input", () => {
        if (el.dataset.computed === "1") {
          delete el.dataset.computed;
          el.closest(".field")?.classList.remove("is-result");
        } else {
          clearComputed(ids);
        }
        const rho = parseNum(document.getElementById("rho"));
        const dimIds = ["p", "l", "t", "m"];
        const dimFilled = dimIds.filter((i) => {
          const v = parseNum(document.getElementById(i));
          return v !== null && !Number.isNaN(v);
        }).length;
        if (rho !== null && !Number.isNaN(rho) && rho > 0 && dimFilled >= 3) compute();
        else if (msg) msg.textContent = "";
      });
      el?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          compute();
        }
      });
    });
    document.getElementById("btn-calc")?.addEventListener("click", compute);
    document.getElementById("btn-reset")?.addEventListener("click", () => {
      ids.forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          el.value = "";
          delete el.dataset.computed;
        }
        el?.closest(".field")?.classList.remove("is-result");
      });
      if (msg) msg.textContent = "";
    });
  }

  (function () {
    const ids = ["rho", "p", "l", "t", "m"];
    const msg = document.getElementById("msg");
    function compute() {
      clearComputed(ids);
      const rho = parseNum(document.getElementById("rho"));
      const p = parseNum(document.getElementById("p"));
      const l = parseNum(document.getElementById("l"));
      const t = parseNum(document.getElementById("t"));
      const m = parseNum(document.getElementById("m"));
      if (rho === null || Number.isNaN(rho) || rho <= 0) {
        msg.textContent = "Density ρ wajib diisi dan > 0 (g/cm³, mis. baja 7.85)";
        return;
      }
      if ([p, l, t, m].some((x) => x !== null && (Number.isNaN(x) || x < 0))) {
        msg.textContent = "Nilai harus ≥ 0";
        return;
      }
      // m = ρ × P × L × T / 1000
      const dims = [p, l, t].filter((x) => x !== null).length;
      if (m === null && p !== null && l !== null && t !== null) {
        setResult("m", (rho * p * l * t) / 1000);
        msg.textContent = "m = ρ×P×L×T / 1000";
        return;
      }
      if (m !== null && dims === 3) {
        msg.textContent = "Kosongkan salah satu dimensi yang dicari";
        return;
      }
      if (m !== null && p === null && l !== null && t !== null) {
        setResult("p", (m * 1000) / (rho * l * t));
        msg.textContent = "P = m×1000 / (ρ×L×T)";
        return;
      }
      if (m !== null && l === null && p !== null && t !== null) {
        setResult("l", (m * 1000) / (rho * p * t));
        msg.textContent = "L = m×1000 / (ρ×P×T)";
        return;
      }
      if (m !== null && t === null && p !== null && l !== null) {
        setResult("t", (m * 1000) / (rho * p * l));
        msg.textContent = "T = m×1000 / (ρ×P×L)";
        return;
      }
      msg.textContent = "Isi ρ + tiga nilai lain, kosongkan 1 yang dicari";
    }
    wire(ids, compute);
  })();
  </script>
  <style>
  .tool-page { max-width: 720px; margin: 0 auto; padding: 1.25rem 0 3rem; }
  .back { display:inline-flex; align-items:center; gap:0.35rem; font-size:0.88rem; color: var(--muted); text-decoration:none; margin-bottom:0.85rem; }
  .back:hover { color: var(--amber); }
  .tool-card {
    border:1px solid var(--line); border-radius:22px; padding:1.25rem;
    background: radial-gradient(120% 80% at 0% 0%, rgba(45,212,191,0.08), transparent 50%), var(--bg-card);
    box-shadow: 0 18px 48px rgba(0,0,0,0.2);
  }
  .tool-card h1 { margin:0 0 0.35rem; font-family: var(--font-display); font-size:1.45rem; }
  .tool-card .desc { margin:0 0 1rem; color: var(--muted); font-size:0.92rem; line-height:1.5; }
  .formula { display:inline-block; font-family: var(--font-mono); font-size:0.85rem; color: var(--amber);
    border:1px solid rgba(240,164,58,0.35); background:rgba(240,164,58,0.08); padding:0.35rem 0.65rem; border-radius:999px; margin-bottom:1rem; }
  .fields { display:grid; gap:0.75rem; }
  @media(min-width:560px){ .fields.cols-2{ grid-template-columns:1fr 1fr;} }
  .field label { display:block; font-size:0.8rem; font-weight:600; margin-bottom:0.3rem; color: var(--ink); }
  .field label span { font-weight:500; color: var(--muted); }
  .field {
    border:1px solid var(--line); border-radius:14px; padding:0.55rem 0.75rem;
    background: var(--bg-elevated);
  }
  .field input {
    width:100%; box-sizing:border-box; border:none; outline:none; background:transparent;
    color: var(--ink); padding:0.25rem 0; font-size:1.1rem; font-weight:700;
    font-family: var(--font-mono);
  }
  .field.is-result { border-color: rgba(45,212,191,0.65); background: rgba(45,212,191,0.12); box-shadow:0 0 0 3px rgba(45,212,191,0.12); }
  .field.is-result label { color: var(--teal); }
  .actions { display:flex; flex-wrap:wrap; align-items:center; gap:0.65rem; margin-top:1.1rem; }
  .btn-calc {
    border:0; border-radius:999px; padding:0.65rem 1.25rem; font-weight:700; cursor:pointer;
    background: linear-gradient(135deg, #3dcfb6, #2dd4bf); color:#0b0f14;
  }
  .btn-reset {
    border:1px solid var(--line); border-radius:999px; padding:0.6rem 1rem; font-weight:600; cursor:pointer;
    background: transparent; color: var(--muted);
  }
  .msg { margin:0; font-size:0.85rem; color: var(--teal); flex:1 1 100%; }
  .hint { margin:1rem 0 0; font-size:0.8rem; color: var(--muted); line-height:1.45; }
  </style>
</Layout>
