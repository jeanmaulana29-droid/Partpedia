---
import Layout from "../../../layouts/Layout.astro";
---
<Layout
  title="Word Search Level 5 — Cari Kata Industri | Industrial Word Search | Partpedia"
  description="Level 5: temukan 10 istilah industri internasional dalam grid 25×25. Hanya horizontal dan vertikal."
>
  <div class="ws-page">
    <a class="ws-back" href="/">← Beranda / Home</a>
    <header class="ws-hero">
      <div class="ws-badge">GAME · WORD SEARCH</div>
      <h1>Cari Kata Industri <span>Level 5</span></h1>
      <p class="ws-lead">
        <strong>Industrial Word Search</strong> — temukan 10 istilah teknis internasional.
        Arah hanya <strong>kiri ke kanan</strong> dan <strong>atas ke bawah</strong> (tanpa miring).
        Klik atau sentuh huruf satu per satu.
      </p>
      <div class="ws-meta">
        <span class="ws-chip" id="ws-progress">0 / 10 kata</span>
        <span class="ws-chip" id="ws-score">0 poin level ini</span>
        <span class="ws-chip">Grid 25×25</span>
      </div>
    </header>
    <div class="ws-board">
      <div class="ws-grid" id="ws-grid" role="grid" aria-label="Word search 25 by 25"></div>
      <p class="ws-sel" id="ws-sel"></p>
      <button type="button" class="ws-clear" id="ws-clear">Hapus pilihan huruf</button>
    </div>
    <div class="ws-words-wrap">
      <h2>Daftar kata / Word list</h2>
      <ul class="ws-words" id="ws-words"></ul>
    </div>
    <div class="ws-nav">
      <a class="ws-btn-back" href="/tools/word-search/4/">← Back</a>
      <a class="ws-btn-next" href="/tools/word-search/result/">Selesai / Result →</a>
    </div>
  </div>
  <style is:global>

.ws-page{max-width:720px;margin:0 auto;padding:1rem 0.75rem 2.5rem}
.ws-back{display:inline-flex;align-items:center;gap:0.35rem;color:#94a3b8;text-decoration:none;font-size:0.9rem;margin-bottom:0.85rem}
.ws-back:hover{color:#e2e8f0}
.ws-hero{margin-bottom:1rem}
.ws-badge{display:inline-block;font-size:0.68rem;font-weight:800;letter-spacing:0.1em;color:#fbbf24;background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.45);padding:0.28rem 0.6rem;border-radius:999px;margin-bottom:0.55rem}
.ws-hero h1{margin:0 0 0.4rem;font-size:1.45rem;color:#f8fafc;line-height:1.25}
.ws-hero h1 span{color:#38bdf8;font-weight:700}
.ws-lead{margin:0;color:#94a3b8;font-size:0.92rem;line-height:1.55}
.ws-meta{display:flex;flex-wrap:wrap;gap:0.5rem;margin:0.75rem 0 0}
.ws-chip{font-size:0.75rem;font-weight:700;color:#e2e8f0;background:rgba(30,41,59,0.9);border:1px solid rgba(148,163,184,0.25);padding:0.3rem 0.55rem;border-radius:8px}
.ws-board{background:rgba(15,23,42,0.88);border:1px solid rgba(56,189,248,0.25);border-radius:16px;padding:0.65rem;box-shadow:0 0 0 1px rgba(251,191,36,0.08),0 12px 40px rgba(0,0,0,0.35)}
.ws-grid{display:grid;grid-template-columns:repeat(25,minmax(0,1fr));gap:2px;width:100%}
button.ws-cell{
  appearance:none;-webkit-appearance:none;border:none;aspect-ratio:1;
  display:flex;align-items:center;justify-content:center;
  font-weight:800;font-size:clamp(0.45rem,2.1vw,0.72rem);
  color:#e2e8f0;background:#1e293b;border-radius:3px;cursor:pointer;
  padding:0;line-height:1;min-width:0;touch-action:manipulation;
  -webkit-tap-highlight-color:transparent;
}
button.ws-cell.sel{
  background:#0ea5e9 !important;color:#0f172a !important;
  box-shadow:inset 0 0 0 2px #38bdf8;
}
button.ws-cell.found{
  background:#1d4ed8 !important;color:#eff6ff !important;
}
.ws-sel{margin:0.55rem 0 0;font-size:0.8rem;color:#64748b;min-height:1.2em}
.ws-words-wrap{margin-top:1rem}
.ws-words-wrap h2{margin:0 0 0.5rem;font-size:0.95rem;color:#f1f5f9}
.ws-words{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:0.35rem}
@media(min-width:480px){.ws-words{grid-template-columns:repeat(5,1fr)}}
.ws-words li{
  font-size:0.72rem;font-weight:800;letter-spacing:0.03em;
  color:#cbd5e1;background:rgba(30,41,59,0.85);border-radius:8px;
  padding:0.4rem 0.35rem;text-align:center;
}
.ws-words li.got{
  color:#ffffff !important;background:#2563eb !important;text-decoration:none;
}
.ws-nav{display:flex;gap:0.6rem;margin-top:1.1rem}
.ws-nav a{flex:1;text-align:center;text-decoration:none;font-weight:800;font-size:0.9rem;padding:0.7rem 0.5rem;border-radius:12px}
.ws-btn-back{background:rgba(51,65,85,0.95);color:#e2e8f0;border:1px solid rgba(148,163,184,0.3)}
.ws-btn-next{background:linear-gradient(135deg,#f59e0b,#ea580c);color:#0f172a}
.ws-clear{margin-top:0.5rem;width:100%;background:transparent;border:1px dashed rgba(148,163,184,0.35);color:#94a3b8;border-radius:10px;padding:0.45rem;cursor:pointer;font-size:0.8rem}

  </style>
  <script is:inline>
    window.__WS__ = {"level":5,"words":["CONVEYOR","SPINDLE","CHUCK","COLLET","REAMER","DRILL","TAPER","KEYWAY","SPLINE","BUSH"],"grid":[["C","Q","B","C","S","D","J","N","V","D","S","N","D","J","F","M","H","T","S","H","E","G","S","T","U"],["T","D","U","I","O","C","M","I","S","I","T","K","C","K","J","U","I","U","E","Y","X","J","N","V","T"],["B","W","S","Q","E","M","I","D","L","A","D","V","S","C","X","W","E","D","O","B","Z","E","Q","X","S"],["P","Q","H","P","O","N","D","Y","K","P","J","L","H","T","N","L","R","C","J","Y","S","X","Z","X","O"],["H","X","K","P","O","A","L","T","N","K","R","S","B","C","K","A","Y","F","U","J","V","T","M","S","M"],["A","U","S","A","C","R","E","A","M","E","R","G","I","S","N","C","N","S","J","V","W","R","F","N","V"],["O","F","B","C","D","L","S","A","Q","R","A","V","K","T","X","O","E","H","Q","L","R","G","C","C","X"],["P","W","J","T","C","H","G","B","Z","H","H","N","A","I","J","L","E","J","O","C","A","M","R","H","O"],["K","Q","V","W","O","S","I","O","Z","D","I","H","F","U","U","L","D","O","Z","H","M","C","N","U","X"],["J","L","R","Q","S","G","R","S","V","K","S","S","D","R","K","E","V","V","W","B","W","B","M","M","S"],["A","S","Z","N","W","B","T","P","M","L","T","P","V","I","E","T","Z","F","I","M","M","N","S","F","R"],["H","L","I","F","E","J","X","X","H","P","A","I","U","O","Y","K","A","T","V","R","Y","T","S","C","J"],["U","I","O","H","X","L","S","Y","C","W","P","N","N","N","W","D","C","U","K","K","T","R","X","A","W"],["J","Z","T","K","B","F","E","A","U","P","E","D","I","Q","A","C","E","B","K","F","R","D","O","K","J"],["C","R","H","P","F","E","B","Q","H","T","R","L","A","Y","Y","X","B","V","Q","D","V","R","W","E","J"],["O","C","D","R","I","L","L","U","S","F","O","E","S","V","R","B","M","Z","D","S","P","X","Z","D","V"],["N","V","U","V","F","D","U","L","L","O","A","A","V","L","Y","H","B","C","U","Y","Y","A","F","N","K"],["V","V","Q","B","Z","U","C","L","Q","P","P","L","E","W","Q","S","I","K","Y","I","R","H","W","Q","I"],["E","A","K","F","W","D","R","S","Z","R","P","W","J","U","D","K","D","F","J","F","P","N","W","X","E"],["Y","M","R","M","K","T","L","P","J","C","Z","V","U","A","U","V","Y","M","I","C","A","W","R","Q","S"],["O","G","V","D","U","F","C","L","M","Z","Z","P","P","V","I","G","Q","T","X","H","U","V","F","W","C"],["R","Z","Q","Y","H","G","O","I","Y","I","Y","X","R","R","N","N","K","U","K","U","C","C","T","J","Y"],["O","N","C","K","M","P","C","N","I","C","A","K","E","X","S","E","F","S","T","C","C","R","C","L","Y"],["N","E","H","C","X","Q","O","E","Q","J","V","U","G","K","C","N","L","N","Q","K","M","R","Q","A","A"],["J","W","Z","L","J","S","W","W","Q","I","Q","Z","J","G","M","E","H","D","A","Q","C","E","R","I","N"]],"placed":[{"word":"KEYWAY","cells":[[9,14],[10,14],[11,14],[12,14],[13,14],[14,14]]},{"word":"CHUCK","cells":[[19,19],[20,19],[21,19],[22,19],[23,19]]},{"word":"BUSH","cells":[[0,2],[1,2],[2,2],[3,2]]},{"word":"DRILL","cells":[[15,2],[15,3],[15,4],[15,5],[15,6]]},{"word":"SPLINE","cells":[[18,7],[19,7],[20,7],[21,7],[22,7],[23,7]]},{"word":"SPINDLE","cells":[[9,11],[10,11],[11,11],[12,11],[13,11],[14,11],[15,11]]},{"word":"REAMER","cells":[[5,5],[5,6],[5,7],[5,8],[5,9],[5,10]]},{"word":"TAPER","cells":[[10,10],[11,10],[12,10],[13,10],[14,10]]},{"word":"COLLET","cells":[[5,15],[6,15],[7,15],[8,15],[9,15],[10,15]]},{"word":"CONVEYOR","cells":[[14,0],[15,0],[16,0],[17,0],[18,0],[19,0],[20,0],[21,0]]}]};
  </script>
  <script is:inline>

(function(){
  var cfg = window.__WS__;
  if (!cfg) { console.error("WS: no config"); return; }
  var SIZE = 25;
  var level = cfg.level;
  var grid = cfg.grid;
  var placed = cfg.placed;
  var words = cfg.words;
  var POINTS = 2;

  var gridEl = document.getElementById("ws-grid");
  var wordsEl = document.getElementById("ws-words");
  var progressEl = document.getElementById("ws-progress");
  var scoreEl = document.getElementById("ws-score");
  var selInfo = document.getElementById("ws-sel");
  if (!gridEl || !wordsEl) { console.error("WS: missing DOM"); return; }

  var found = {};
  var selected = [];
  var cellNodes = {};

  function storageKey(){ return "partpedia_ws_batch1"; }
  function loadState(){
    try { return JSON.parse(sessionStorage.getItem(storageKey())||"{}"); }
    catch(e){ return {}; }
  }
  function saveState(st){ sessionStorage.setItem(storageKey(), JSON.stringify(st)); }
  function ensureRun(){
    var st = loadState();
    if (!st.runId) { st = { runId: Date.now(), scores: {}, found: {} }; saveState(st); }
    if (!st.scores) st.scores = {};
    if (!st.found) st.found = {};
    return st;
  }
  function key(r,c){ return r+","+c; }

  function foundCells(){
    var s = {};
    for (var i=0;i<placed.length;i++){
      var p = placed[i];
      if (!found[p.word]) continue;
      for (var j=0;j<p.cells.length;j++) s[key(p.cells[j][0], p.cells[j][1])] = 1;
    }
    return s;
  }

  function selectionValidDirection(){
    if (selected.length < 2) return true;
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var dr = r1 - r0, dc = c1 - c0;
    if (!((dr===0 && dc===1) || (dr===1 && dc===0))) return false;
    for (var i=1;i<selected.length;i++){
      if (selected[i].r !== r0 + dr*i || selected[i].c !== c0 + dc*i) return false;
    }
    return true;
  }

  function tryMatch(){
    if (selected.length < 2) return;
    if (!selectionValidDirection()) { selected = []; paint(); return; }
    var fwd = "";
    for (var i=0;i<selected.length;i++) fwd += grid[selected[i].r][selected[i].c];
    for (i=0;i<placed.length;i++){
      var p = placed[i];
      if (found[p.word]) continue;
      if (p.word === fwd){
        found[p.word] = true;
        var st = ensureRun();
        var keys = [];
        for (var k in found) if (found[k]) keys.push(k);
        st.found[level] = keys;
        st.scores[level] = keys.length * POINTS;
        saveState(st);
        selected = [];
        paint();
        return;
      }
    }
    selected = [];
    paint();
  }

  function maybeAutoMatch(){
    var fwd = "";
    for (var i=0;i<selected.length;i++) fwd += grid[selected[i].r][selected[i].c];
    for (i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word === fwd){ tryMatch(); return; }
    }
    var maxLen = 0;
    for (i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word.length > maxLen) maxLen = placed[i].word.length;
    }
    if (selected.length >= maxLen && maxLen > 0) tryMatch();
  }

  function onCellClick(r,c){
    if (selected.length && selected[selected.length-1].r===r && selected[selected.length-1].c===c){
      selected.pop(); paint(); return;
    }
    if (selected.length === 0){
      selected = [{r:r,c:c}]; paint(); return;
    }
    var last = selected[selected.length-1];
    if (selected.length === 1){
      var dr = r - last.r, dc = c - last.c;
      if ((dr===0 && dc===1) || (dr===1 && dc===0)){
        selected.push({r:r,c:c}); paint(); maybeAutoMatch();
      } else {
        selected = [{r:r,c:c}]; paint();
      }
      return;
    }
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var ddr = r1 - r0, ddc = c1 - c0;
    var er = r0 + ddr * selected.length, ec = c0 + ddc * selected.length;
    if (r===er && c===ec){
      selected.push({r:r,c:c}); paint(); maybeAutoMatch();
    } else {
      selected = [{r:r,c:c}]; paint();
    }
  }

  function paint(){
    ensureRun();
    var fc = foundCells();
    var selSet = {};
    for (var i=0;i<selected.length;i++) selSet[key(selected[i].r,selected[i].c)] = 1;

    for (var r=0;r<SIZE;r++){
      for (var c=0;c<SIZE;c++){
        var k = key(r,c);
        var d = cellNodes[k];
        if (!d) continue;
        d.className = "ws-cell";
        d.style.background = "";
        d.style.color = "";
        if (fc[k]) {
          d.classList.add("found");
          d.style.background = "#1d4ed8";
          d.style.color = "#eff6ff";
        }
        if (selSet[k]) {
          d.classList.add("sel");
          d.style.background = "#0ea5e9";
          d.style.color = "#0f172a";
        }
      }
    }

    var children = wordsEl.children;
    for (i=0;i<children.length;i++){
      var li = children[i];
      var w = li.getAttribute("data-word");
      if (found[w]) {
        li.classList.add("got");
        li.style.background = "#2563eb";
        li.style.color = "#ffffff";
      } else {
        li.classList.remove("got");
        li.style.background = "";
        li.style.color = "";
      }
    }

    var n = 0;
    for (var kk in found) if (found[kk]) n++;
    if (progressEl) progressEl.textContent = n + " / " + words.length + " kata";
    if (scoreEl) scoreEl.textContent = (n * POINTS) + " poin level ini";
    if (selInfo){
      if (selected.length) {
        var t = "";
        for (i=0;i<selected.length;i++) t += grid[selected[i].r][selected[i].c];
        selInfo.textContent = "Pilihan: " + t;
      } else {
        selInfo.textContent = "Klik/sentuh huruf satu per satu — hanya kanan atau bawah.";
      }
    }
  }

  function buildUI(){
    gridEl.innerHTML = "";
    cellNodes = {};
    for (var r=0;r<SIZE;r++){
      for (var c=0;c<SIZE;c++){
        var d = document.createElement("button");
        d.type = "button";
        d.className = "ws-cell";
        d.textContent = grid[r][c];
        d.setAttribute("data-r", r);
        d.setAttribute("data-c", c);
        cellNodes[key(r,c)] = d;
        gridEl.appendChild(d);
      }
    }
    // event delegation
    gridEl.onclick = function(ev){
      var t = ev.target;
      if (!t || !t.getAttribute) return;
      if (t.getAttribute("data-r") == null) return;
      onCellClick(parseInt(t.getAttribute("data-r"),10), parseInt(t.getAttribute("data-c"),10));
    };

    wordsEl.innerHTML = "";
    var sorted = words.slice().sort();
    for (var i=0;i<sorted.length;i++){
      var li = document.createElement("li");
      li.textContent = sorted[i];
      li.setAttribute("data-word", sorted[i]);
      wordsEl.appendChild(li);
    }
  }

  var st0 = ensureRun();
  if (Array.isArray(st0.found[level])) {
    for (var fi=0; fi<st0.found[level].length; fi++) found[st0.found[level][fi]] = true;
  }
  buildUI();
  paint();
  window.__WS_API__ = { clearSelection: function(){ selected=[]; paint(); } };
  var clr = document.getElementById("ws-clear");
  if (clr) clr.onclick = function(){ selected=[]; paint(); };
})();

  </script>
</Layout>
