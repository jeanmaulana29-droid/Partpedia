---
import Layout from "../../../layouts/Layout.astro";
---
<Layout
  title="Word Search Level 3 — Cari Kata Industri | Industrial Word Search | Partpedia"
  description="Level 3: temukan 10 istilah industri internasional dalam grid 25×25. Hanya horizontal dan vertikal. Play free on Partpedia."
>
  <div class="ws-page">
    <a class="ws-back" href="/">← Beranda / Home</a>
    <header class="ws-hero">
      <div class="ws-badge">GAME · WORD SEARCH</div>
      <h1>Cari Kata Industri <span>Level 3</span></h1>
      <p class="ws-lead">
        <strong>Industrial Word Search</strong> — temukan 10 istilah teknis internasional.
        Arah hanya <strong>kiri ke kanan</strong> dan <strong>atas ke bawah</strong> (tanpa miring).
        Klik atau sentuh huruf satu per satu.
      </p>
      <div class="ws-meta">
        <span class="ws-chip" id="ws-progress">0 / 10 kata</span>
        <span class="ws-chip" id="ws-score">0 poin level ini</span>
        <span class="ws-chip">Grid 25×25</span>
      </div>
    </header>
    <div class="ws-board">
      <div class="ws-grid" id="ws-grid" role="grid" aria-label="Word search 25 by 25"></div>
      <p class="ws-sel" id="ws-sel"></p>
      <button type="button" class="ws-clear" id="ws-clear">Hapus pilihan huruf</button>
    </div>
    <div class="ws-words-wrap">
      <h2>Daftar kata / Word list</h2>
      <ul class="ws-words" id="ws-words"></ul>
    </div>
    <div class="ws-nav">
      <a class="ws-btn-back" href="/tools/word-search/2/">← Back</a>
      <a class="ws-btn-next" href="/tools/word-search/4/">Lanjutkan / Next →</a>
    </div>
  </div>
  <style>

.ws-page{max-width:720px;margin:0 auto;padding:1rem 0.75rem 2.5rem}
.ws-back{display:inline-flex;align-items:center;gap:0.35rem;color:#94a3b8;text-decoration:none;font-size:0.9rem;margin-bottom:0.85rem}
.ws-back:hover{color:#e2e8f0}
.ws-hero{margin-bottom:1rem}
.ws-badge{display:inline-block;font-size:0.68rem;font-weight:800;letter-spacing:0.1em;color:#fbbf24;background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.45);padding:0.28rem 0.6rem;border-radius:999px;margin-bottom:0.55rem}
.ws-hero h1{margin:0 0 0.4rem;font-size:1.45rem;color:#f8fafc;line-height:1.25}
.ws-hero h1 span{color:#38bdf8;font-weight:700}
.ws-lead{margin:0;color:#94a3b8;font-size:0.92rem;line-height:1.55}
.ws-meta{display:flex;flex-wrap:wrap;gap:0.5rem;margin:0.75rem 0 0}
.ws-chip{font-size:0.75rem;font-weight:700;color:#e2e8f0;background:rgba(30,41,59,0.9);border:1px solid rgba(148,163,184,0.25);padding:0.3rem 0.55rem;border-radius:8px}
.ws-board{background:rgba(15,23,42,0.88);border:1px solid rgba(56,189,248,0.25);border-radius:16px;padding:0.65rem;box-shadow:0 0 0 1px rgba(251,191,36,0.08),0 12px 40px rgba(0,0,0,0.35)}
.ws-grid{display:grid;grid-template-columns:repeat(25,1fr);gap:2px;width:100%}
.ws-cell{appearance:none;border:none;aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:clamp(0.45rem,2.1vw,0.72rem);color:#e2e8f0;background:#1e293b;border-radius:3px;cursor:pointer;padding:0;line-height:1;min-width:0;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
.ws-cell.sel{background:#0ea5e9;color:#0f172a;box-shadow:inset 0 0 0 1px #38bdf8}
.ws-cell.found{background:rgba(14,165,233,0.35);color:#7dd3fc}
.ws-sel{margin:0.55rem 0 0;font-size:0.8rem;color:#64748b;min-height:1.2em}
.ws-words-wrap{margin-top:1rem}
.ws-words-wrap h2{margin:0 0 0.5rem;font-size:0.95rem;color:#f1f5f9}
.ws-words{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:0.35rem}
@media(min-width:480px){.ws-words{grid-template-columns:repeat(5,1fr)}}
.ws-words li{font-size:0.72rem;font-weight:800;letter-spacing:0.03em;color:#cbd5e1;background:rgba(30,41,59,0.85);border-radius:8px;padding:0.4rem 0.35rem;text-align:center}
.ws-words li.got{color:#fff;background:#2563eb;text-decoration:none}
.ws-nav{display:flex;gap:0.6rem;margin-top:1.1rem}
.ws-nav a{flex:1;text-align:center;text-decoration:none;font-weight:800;font-size:0.9rem;padding:0.7rem 0.5rem;border-radius:12px}
.ws-btn-back{background:rgba(51,65,85,0.95);color:#e2e8f0;border:1px solid rgba(148,163,184,0.3)}
.ws-btn-next{background:linear-gradient(135deg,#f59e0b,#ea580c);color:#0f172a}
.ws-clear{margin-top:0.5rem;width:100%;background:transparent;border:1px dashed rgba(148,163,184,0.35);color:#94a3b8;border-radius:10px;padding:0.45rem;cursor:pointer;font-size:0.8rem}

  </style>
  <script is:inline>
    window.__WS__ = {"level":3,"words":["INVERTER","SENSOR","RELAY","FUSE","CONTACTOR","BREAKER","CABLE","TERMINAL","SWITCH","ENCODER"],"grid":[["E","A","Z","R","B","P","A","P","K","N","B","I","I","U","A","T","M","V","S","W","R","D","C","F","C"],["E","X","P","V","Z","V","L","C","Q","C","M","R","S","K","J","U","X","Q","P","T","K","Y","S","O","Z"],["U","G","D","F","J","X","C","X","Q","Y","R","Q","S","G","Q","P","J","B","U","L","X","E","D","D","V"],["B","P","B","N","L","U","R","Q","S","R","F","B","J","E","C","O","N","T","A","C","T","O","R","W","C"],["V","K","P","J","U","O","T","O","J","M","D","N","R","A","U","I","Q","O","P","E","A","X","T","V","B"],["E","G","A","L","E","W","E","S","D","D","A","X","O","A","X","Q","L","W","O","C","U","F","U","C","F"],["M","K","G","O","C","F","R","D","N","B","M","Y","Q","U","R","D","Q","Q","X","G","M","C","O","P","J"],["M","A","H","W","H","T","M","F","K","J","V","L","N","Q","K","D","H","Q","Q","B","M","L","F","D","S"],["L","J","U","D","Z","Y","I","F","T","O","K","L","B","C","T","Q","K","U","Z","Z","O","X","Q","B","K"],["L","P","E","M","H","N","N","C","I","Z","B","Q","J","M","S","H","W","J","T","P","L","S","Y","R","N"],["E","B","J","F","M","E","A","Y","Z","K","N","I","N","V","E","R","T","E","R","J","S","W","F","O","S"],["N","K","E","T","Q","H","L","W","D","H","Q","P","U","R","G","J","L","Y","W","Z","E","I","C","F","L"],["P","Q","N","C","T","J","J","Y","W","G","L","V","Y","R","C","T","N","G","T","S","A","T","S","U","B"],["M","K","C","Q","A","T","S","W","H","J","M","M","C","N","F","V","S","C","L","R","O","C","E","S","J"],["C","Z","O","W","W","R","A","G","F","Y","Q","V","U","V","W","M","B","E","B","Z","F","H","N","E","A"],["Y","I","D","S","J","P","Z","M","V","W","J","Y","V","E","N","R","M","G","G","N","I","M","S","R","L"],["G","B","E","Y","S","A","N","S","A","Q","Z","L","Q","Y","E","B","O","Z","O","D","Z","Y","O","W","Z"],["U","D","R","O","M","N","A","Y","M","I","L","F","V","S","D","T","K","A","S","L","S","E","R","C","E"],["Q","B","P","O","S","C","A","S","A","V","V","X","C","H","V","M","F","J","P","I","J","H","D","X","E"],["R","R","W","X","U","W","S","B","I","A","R","T","O","K","X","D","T","R","H","J","Q","G","A","A","C"],["J","E","S","P","D","J","U","J","J","N","C","C","U","F","Z","U","Y","E","P","D","P","B","U","H","V"],["Y","A","B","Z","M","L","F","R","O","H","K","Y","N","K","O","R","E","L","N","M","T","F","Z","M","F"],["K","K","H","A","L","B","R","X","P","S","T","B","J","O","P","L","E","A","C","A","B","L","E","Z","J"],["R","E","K","X","S","E","T","D","S","G","I","G","G","B","C","F","A","Y","R","K","R","G","V","D","Q"],["F","R","E","L","H","E","P","T","G","K","I","A","Z","F","R","A","N","S","E","J","E","M","F","V","Y"]],"placed":[{"word":"CABLE","cells":[[22,18],[22,19],[22,20],[22,21],[22,22]]},{"word":"ENCODER","cells":[[11,2],[12,2],[13,2],[14,2],[15,2],[16,2],[17,2]]},{"word":"TERMINAL","cells":[[4,6],[5,6],[6,6],[7,6],[8,6],[9,6],[10,6],[11,6]]},{"word":"RELAY","cells":[[19,17],[20,17],[21,17],[22,17],[23,17]]},{"word":"SWITCH","cells":[[9,21],[10,21],[11,21],[12,21],[13,21],[14,21]]},{"word":"BREAKER","cells":[[18,1],[19,1],[20,1],[21,1],[22,1],[23,1],[24,1]]},{"word":"FUSE","cells":[[11,23],[12,23],[13,23],[14,23]]},{"word":"CONTACTOR","cells":[[3,14],[3,15],[3,16],[3,17],[3,18],[3,19],[3,20],[3,21],[3,22]]},{"word":"SENSOR","cells":[[12,22],[13,22],[14,22],[15,22],[16,22],[17,22]]},{"word":"INVERTER","cells":[[10,11],[10,12],[10,13],[10,14],[10,15],[10,16],[10,17],[10,18]]}]};
  </script>
  <script is:inline>

(function(){
  var cfg = window.__WS__;
  var SIZE = 25;
  var level = cfg.level;
  var grid = cfg.grid;
  var placed = cfg.placed;
  var words = cfg.words;
  var POINTS = 2;

  var gridEl = document.getElementById("ws-grid");
  var wordsEl = document.getElementById("ws-words");
  var progressEl = document.getElementById("ws-progress");
  var scoreEl = document.getElementById("ws-score");
  var selInfo = document.getElementById("ws-sel");

  var found = {};
  var selected = [];

  function storageKey(){ return "partpedia_ws_batch1"; }
  function loadState(){
    try { return JSON.parse(sessionStorage.getItem(storageKey())||"{}"); }
    catch(e){ return {}; }
  }
  function saveState(st){ sessionStorage.setItem(storageKey(), JSON.stringify(st)); }
  function ensureRun(){
    var st = loadState();
    if (!st.runId) { st = { runId: Date.now(), scores: {}, found: {} }; saveState(st); }
    if (!st.scores) st.scores = {};
    if (!st.found) st.found = {};
    return st;
  }
  function key(r,c){ return r+","+c; }

  function foundCells(){
    var s = {};
    for (var i=0;i<placed.length;i++){
      var p = placed[i];
      if (!found[p.word]) continue;
      for (var j=0;j<p.cells.length;j++){
        s[key(p.cells[j][0], p.cells[j][1])] = 1;
      }
    }
    return s;
  }

  function selectionValidDirection(){
    if (selected.length < 2) return true;
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var dr = r1 - r0, dc = c1 - c0;
    // only right (0,1) or down (1,0)
    if (!((dr===0 && dc===1) || (dr===1 && dc===0))) return false;
    for (var i=1;i<selected.length;i++){
      if (selected[i].r !== r0 + dr*i || selected[i].c !== c0 + dc*i) return false;
    }
    return true;
  }

  function tryMatch(){
    if (selected.length < 2) return;
    if (!selectionValidDirection()) { selected = []; render(); return; }
    var fwd = selected.map(function(s){ return grid[s.r][s.c]; }).join("");
    for (var i=0;i<placed.length;i++){
      var p = placed[i];
      if (found[p.word]) continue;
      if (p.word === fwd){
        found[p.word] = true;
        var st = ensureRun();
        st.found[level] = Object.keys(found).filter(function(k){ return found[k]; });
        st.scores[level] = st.found[level].length * POINTS;
        saveState(st);
        selected = [];
        render();
        return;
      }
    }
    selected = [];
    render();
  }

  function maybeAutoMatch(){
    var fwd = selected.map(function(s){ return grid[s.r][s.c]; }).join("");
    for (var i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word === fwd){ tryMatch(); return; }
    }
    var maxLen = 0;
    for (i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word.length > maxLen) maxLen = placed[i].word.length;
    }
    if (selected.length >= maxLen && maxLen > 0) tryMatch();
  }

  function onCellClick(r,c){
    // toggle off last cell
    if (selected.length && selected[selected.length-1].r===r && selected[selected.length-1].c===c){
      selected.pop(); render(); return;
    }
    if (selected.length === 0){
      selected = [{r:r,c:c}]; render(); return;
    }
    var last = selected[selected.length-1];
    if (selected.length === 1){
      var dr = r - last.r, dc = c - last.c;
      // only one step right or down
      if ((dr===0 && dc===1) || (dr===1 && dc===0)){
        selected.push({r:r,c:c}); render(); maybeAutoMatch();
      } else {
        selected = [{r:r,c:c}]; render();
      }
      return;
    }
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var ddr = r1 - r0, ddc = c1 - c0;
    var er = r0 + ddr * selected.length, ec = c0 + ddc * selected.length;
    if (r===er && c===ec){
      selected.push({r:r,c:c}); render(); maybeAutoMatch();
    } else {
      selected = [{r:r,c:c}]; render();
    }
  }

  function render(){
    ensureRun();
    var fc = foundCells();
    var selSet = {};
    for (var i=0;i<selected.length;i++) selSet[key(selected[i].r,selected[i].c)] = 1;
    gridEl.innerHTML = "";
    for (var r=0;r<SIZE;r++){
      for (var c=0;c<SIZE;c++){
        var d = document.createElement("button");
        d.type = "button";
        d.className = "ws-cell";
        d.textContent = grid[r][c];
        var k = key(r,c);
        if (fc[k]) d.classList.add("found");
        if (selSet[k]) d.classList.add("sel");
        (function(rr,cc){ d.addEventListener("click", function(){ onCellClick(rr,cc); }); })(r,c);
        gridEl.appendChild(d);
      }
    }
    wordsEl.innerHTML = "";
    var sorted = words.slice().sort();
    for (i=0;i<sorted.length;i++){
      var li = document.createElement("li");
      li.textContent = sorted[i];
      if (found[sorted[i]]) li.classList.add("got");
      wordsEl.appendChild(li);
    }
    var n = Object.keys(found).filter(function(k){ return found[k]; }).length;
    progressEl.textContent = n + " / " + words.length + " kata";
    scoreEl.textContent = (n * POINTS) + " poin level ini";
    if (selInfo){
      selInfo.textContent = selected.length
        ? ("Pilihan: " + selected.map(function(s){ return grid[s.r][s.c]; }).join(""))
        : "Klik huruf satu per satu — hanya kanan atau bawah (tidak miring).";
    }
  }

  var st0 = ensureRun();
  if (Array.isArray(st0.found[level])) {
    for (var fi=0; fi<st0.found[level].length; fi++) found[st0.found[level][fi]] = true;
  }
  render();
  window.__WS_API__ = { clearSelection: function(){ selected=[]; render(); } };
})();

    document.getElementById("ws-clear") && document.getElementById("ws-clear").addEventListener("click", function () {
      window.__WS_API__ && window.__WS_API__.clearSelection();
    });
  </script>
</Layout>
