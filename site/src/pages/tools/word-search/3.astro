---
import Layout from "../../../layouts/Layout.astro";
---
<Layout
  title="Word Search Level 3 — Cari Kata Industri | Industrial Word Search | Partpedia"
  description="Level 3: temukan 10 istilah industri dalam grid 20×20. Hanya horizontal dan vertikal. 3 menit lalu bisa menyerah."
>
  <div class="ws-page">
    <a class="ws-back" href="/">← Beranda / Home</a>
    <header class="ws-hero">
      <div class="ws-badge">GAME · WORD SEARCH</div>
      <h1>Cari Kata Industri <span>Level 3</span></h1>
      <p class="ws-lead">
        <strong>Industrial Word Search</strong> — 10 istilah teknis internasional.
        Arah: <strong>kiri → kanan</strong> dan <strong>atas → bawah</strong> saja.
        Setelah 3 menit muncul tombol <strong>Menyerah</strong>.
      </p>
      <div class="ws-meta">
        <span class="ws-chip" id="ws-progress">0 / 10 kata</span>
        <span class="ws-chip" id="ws-score">0 poin level ini</span>
        <span class="ws-chip" id="ws-timer">Sisa 3:00</span>
        <span class="ws-chip">Grid 20×20</span>
      </div>
    </header>
    <div class="ws-board">
      <div class="ws-grid" id="ws-grid" role="grid" aria-label="Word search 20 by 20"></div>
      <p class="ws-sel" id="ws-sel"></p>
      <button type="button" class="ws-clear" id="ws-clear">Hapus pilihan huruf</button>
      <div class="ws-surrender-wrap" id="ws-surrender-wrap">
        <button type="button" class="ws-surrender" id="ws-surrender">Menyerah — tampilkan sisa kata</button>
      </div>
    </div>
    <div class="ws-words-wrap">
      <h2>Daftar kata / Word list</h2>
      <ul class="ws-words" id="ws-words"></ul>
    </div>
    <div class="ws-nav">
      <a class="ws-btn-back" href="/tools/word-search/2/">← Back</a>
      <a class="ws-btn-next" href="/tools/word-search/4/">Lanjutkan / Next →</a>
    </div>
  </div>
  <style is:global>

.ws-page{max-width:560px;margin:0 auto;padding:0.85rem 0.65rem 2.5rem;box-sizing:border-box}
.ws-back{display:inline-flex;align-items:center;gap:0.35rem;color:#94a3b8;text-decoration:none;font-size:0.88rem;margin-bottom:0.7rem}
.ws-back:hover{color:#e2e8f0}
.ws-hero{margin-bottom:0.85rem}
.ws-badge{display:inline-block;font-size:0.65rem;font-weight:800;letter-spacing:0.1em;color:#fbbf24;background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.45);padding:0.25rem 0.55rem;border-radius:999px;margin-bottom:0.45rem}
.ws-hero h1{margin:0 0 0.35rem;font-size:clamp(1.15rem,4.5vw,1.4rem);color:#f8fafc;line-height:1.25}
.ws-hero h1 span{color:#38bdf8;font-weight:700}
.ws-lead{margin:0;color:#94a3b8;font-size:0.88rem;line-height:1.5}
.ws-meta{display:flex;flex-wrap:wrap;gap:0.4rem;margin:0.65rem 0 0}
.ws-chip{font-size:0.72rem;font-weight:700;color:#e2e8f0;background:rgba(30,41,59,0.9);border:1px solid rgba(148,163,184,0.25);padding:0.28rem 0.5rem;border-radius:8px}
.ws-chip.warn{border-color:rgba(251,191,36,0.5);color:#fde68a}
.ws-board{background:rgba(15,23,42,0.92);border:1px solid rgba(56,189,248,0.28);border-radius:14px;padding:0.55rem;box-shadow:0 8px 28px rgba(0,0,0,0.35)}
.ws-grid{
  display:grid;
  grid-template-columns:repeat(20,minmax(0,1fr));
  gap:1px;
  width:100%;
  max-width:100%;
}
button.ws-cell{
  appearance:none;-webkit-appearance:none;border:none;aspect-ratio:1;
  display:flex;align-items:center;justify-content:center;
  font-weight:800;
  font-size:clamp(0.55rem,2.8vw,0.85rem);
  color:#e2e8f0;background:#1e293b;border-radius:2px;cursor:pointer;
  padding:0;line-height:1;min-width:0;touch-action:manipulation;
  -webkit-tap-highlight-color:transparent;user-select:none;
}
button.ws-cell.sel{
  background:#0ea5e9 !important;color:#0f172a !important;
  box-shadow:inset 0 0 0 2px #38bdf8;
}
button.ws-cell.found{
  background:#1d4ed8 !important;color:#eff6ff !important;
}
button.ws-cell.reveal{
  background:#2563eb !important;color:#fff !important;
}
.ws-sel{margin:0.5rem 0 0;font-size:0.78rem;color:#64748b;min-height:1.15em}
.ws-surrender-wrap{margin-top:0.65rem;display:none}
.ws-surrender-wrap.show{display:block}
.ws-surrender{
  width:100%;border:none;cursor:pointer;font-weight:800;font-size:0.9rem;
  padding:0.75rem;border-radius:12px;
  background:linear-gradient(135deg,#64748b,#475569);color:#f8fafc;
}
.ws-surrender:hover{filter:brightness(1.08)}
.ws-surrender:disabled{opacity:0.55;cursor:not-allowed}
.ws-words-wrap{margin-top:0.95rem}
.ws-words-wrap h2{margin:0 0 0.45rem;font-size:0.92rem;color:#f1f5f9}
.ws-words{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:0.32rem}
@media(min-width:420px){.ws-words{grid-template-columns:repeat(5,1fr)}}
.ws-words li{
  font-size:0.7rem;font-weight:800;letter-spacing:0.02em;
  color:#cbd5e1;background:rgba(30,41,59,0.85);border-radius:8px;
  padding:0.38rem 0.3rem;text-align:center;
}
.ws-words li.got{
  color:#ffffff !important;background:#2563eb !important;
}
.ws-words li.revealed{
  color:#ffffff !important;background:#3b82f6 !important;opacity:0.9;
}
.ws-nav{display:flex;gap:0.55rem;margin-top:1rem}
.ws-nav a{flex:1;text-align:center;text-decoration:none;font-weight:800;font-size:0.88rem;padding:0.68rem 0.45rem;border-radius:12px}
.ws-btn-back{background:rgba(51,65,85,0.95);color:#e2e8f0;border:1px solid rgba(148,163,184,0.3)}
.ws-btn-next{background:linear-gradient(135deg,#f59e0b,#ea580c);color:#0f172a}
.ws-clear{margin-top:0.45rem;width:100%;background:transparent;border:1px dashed rgba(148,163,184,0.35);color:#94a3b8;border-radius:10px;padding:0.42rem;cursor:pointer;font-size:0.78rem}

  </style>
  <script is:inline>
    window.__WS__ = {"level":3,"words":["INVERTER","SENSOR","RELAY","FUSE","CONTACTOR","BREAKER","CABLE","TERMINAL","SWITCH","ENCODER"],"grid":[["E","I","K","J","E","S","J","H","H","D","X","J","P","U","Y","T","H","T","Q","X"],["G","G","O","M","B","K","C","S","F","M","B","Q","C","E","Q","T","B","E","X","O"],["Y","U","R","G","C","F","Y","N","X","D","P","C","B","X","C","A","K","R","D","I"],["N","L","T","O","U","D","R","B","M","B","L","C","G","S","L","M","Y","M","Q","F"],["W","D","H","C","R","K","T","R","P","D","T","T","M","M","G","Y","W","I","U","Y"],["O","F","M","Z","E","Y","C","E","S","S","H","H","D","O","E","O","D","N","Q","L"],["O","K","C","U","L","K","E","A","D","L","R","J","N","O","B","E","U","A","V","Y"],["H","M","K","Z","A","C","H","K","H","K","B","K","E","C","N","L","G","L","P","P"],["T","G","J","D","Y","W","C","E","P","D","P","Q","E","B","H","O","U","D","C","K"],["R","H","R","V","R","W","O","R","H","V","P","W","J","V","G","D","Z","W","R","M"],["R","P","A","Z","B","K","N","L","P","R","C","S","I","W","L","J","Q","X","K","L"],["D","O","J","E","A","Q","T","E","W","C","A","W","N","M","M","O","M","O","M","G"],["Y","L","I","Q","I","L","A","O","L","Y","S","I","B","F","A","A","J","M","V","O"],["Q","D","L","U","Q","X","C","J","O","V","O","T","N","M","H","G","O","U","W","W"],["X","U","V","O","P","L","T","P","O","N","D","C","H","H","Y","P","W","M","N","X"],["F","B","J","C","W","W","O","E","G","I","P","H","U","R","Y","B","K","Y","X","J"],["Z","S","S","A","N","B","R","J","W","Y","T","X","E","N","C","O","D","E","R","W"],["Z","W","O","B","I","B","Y","D","B","J","O","F","K","V","W","G","A","J","C","O"],["K","K","Z","L","U","O","L","V","D","I","N","V","E","R","T","E","R","S","V","G"],["V","F","B","E","S","X","W","O","P","S","E","N","S","O","R","F","U","S","E","C"]],"placed":[{"word":"CONTACTOR","cells":[[8,6],[9,6],[10,6],[11,6],[12,6],[13,6],[14,6],[15,6],[16,6]]},{"word":"CABLE","cells":[[15,3],[16,3],[17,3],[18,3],[19,3]]},{"word":"SENSOR","cells":[[19,9],[19,10],[19,11],[19,12],[19,13],[19,14]]},{"word":"BREAKER","cells":[[3,7],[4,7],[5,7],[6,7],[7,7],[8,7],[9,7]]},{"word":"FUSE","cells":[[19,15],[19,16],[19,17],[19,18]]},{"word":"INVERTER","cells":[[18,9],[18,10],[18,11],[18,12],[18,13],[18,14],[18,15],[18,16]]},{"word":"SWITCH","cells":[[10,11],[11,11],[12,11],[13,11],[14,11],[15,11]]},{"word":"RELAY","cells":[[4,4],[5,4],[6,4],[7,4],[8,4]]},{"word":"ENCODER","cells":[[16,12],[16,13],[16,14],[16,15],[16,16],[16,17],[16,18]]},{"word":"TERMINAL","cells":[[0,17],[1,17],[2,17],[3,17],[4,17],[5,17],[6,17],[7,17]]}]};
  </script>
  <script is:inline>

(function(){
  var cfg = window.__WS__;
  if (!cfg) { console.error("WS: no config"); return; }
  var SIZE = 20;
  var level = cfg.level;
  var grid = cfg.grid;
  var placed = cfg.placed;
  var words = cfg.words;
  var POINTS = 2;
  var SURRENDER_MS = 3 * 60 * 1000;

  var gridEl = document.getElementById("ws-grid");
  var wordsEl = document.getElementById("ws-words");
  var progressEl = document.getElementById("ws-progress");
  var scoreEl = document.getElementById("ws-score");
  var timerEl = document.getElementById("ws-timer");
  var selInfo = document.getElementById("ws-sel");
  var surrWrap = document.getElementById("ws-surrender-wrap");
  var surrBtn = document.getElementById("ws-surrender");
  if (!gridEl || !wordsEl) return;

  var found = {};
  var revealed = false;
  var locked = false;
  var selected = [];
  var cellNodes = {};
  var startedAt = Date.now();
  var surrShown = false;

  function storageKey(){ return "partpedia_ws_batch1"; }
  function loadState(){
    try { return JSON.parse(sessionStorage.getItem(storageKey())||"{}"); }
    catch(e){ return {}; }
  }
  function saveState(st){ sessionStorage.setItem(storageKey(), JSON.stringify(st)); }
  function ensureRun(){
    var st = loadState();
    if (!st.runId) { st = { runId: Date.now(), scores: {}, found: {} }; saveState(st); }
    if (!st.scores) st.scores = {};
    if (!st.found) st.found = {};
    return st;
  }
  function key(r,c){ return r+","+c; }

  function foundCount(){
    var n = 0;
    for (var k in found) if (found[k]) n++;
    return n;
  }

  function saveScore(){
    var st = ensureRun();
    var keys = [];
    for (var k in found) if (found[k]) keys.push(k);
    st.found[level] = keys;
    st.scores[level] = keys.length * POINTS;
    saveState(st);
  }

  function foundCells(){
    var s = {};
    for (var i=0;i<placed.length;i++){
      var p = placed[i];
      if (!found[p.word] && !(revealed && !found[p.word])) continue;
      if (found[p.word] || revealed) {
        for (var j=0;j<p.cells.length;j++) s[key(p.cells[j][0], p.cells[j][1])] = found[p.word] ? "found" : "reveal";
      }
    }
    // after reveal, mark all placed cells
    if (revealed) {
      for (i=0;i<placed.length;i++){
        p = placed[i];
        for (j=0;j<p.cells.length;j++) {
          var kk = key(p.cells[j][0], p.cells[j][1]);
          if (found[p.word]) s[kk] = "found";
          else s[kk] = "reveal";
        }
      }
    }
    return s;
  }

  function selectionValidDirection(){
    if (selected.length < 2) return true;
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var dr = r1 - r0, dc = c1 - c0;
    if (!((dr===0 && dc===1) || (dr===1 && dc===0))) return false;
    for (var i=1;i<selected.length;i++){
      if (selected[i].r !== r0 + dr*i || selected[i].c !== c0 + dc*i) return false;
    }
    return true;
  }

  function tryMatch(){
    if (locked || selected.length < 2) return;
    if (!selectionValidDirection()) { selected = []; paint(); return; }
    var fwd = "";
    for (var i=0;i<selected.length;i++) fwd += grid[selected[i].r][selected[i].c];
    for (i=0;i<placed.length;i++){
      var p = placed[i];
      if (found[p.word]) continue;
      if (p.word === fwd){
        found[p.word] = true;
        saveScore();
        selected = [];
        paint();
        if (foundCount() >= words.length) {
          locked = true;
          if (surrWrap) surrWrap.classList.remove("show");
        }
        return;
      }
    }
    selected = [];
    paint();
  }

  function maybeAutoMatch(){
    if (locked) return;
    var fwd = "";
    for (var i=0;i<selected.length;i++) fwd += grid[selected[i].r][selected[i].c];
    for (i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word === fwd){ tryMatch(); return; }
    }
    var maxLen = 0;
    for (i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word.length > maxLen) maxLen = placed[i].word.length;
    }
    if (selected.length >= maxLen && maxLen > 0) tryMatch();
  }

  function onCellClick(r,c){
    if (locked) return;
    if (selected.length && selected[selected.length-1].r===r && selected[selected.length-1].c===c){
      selected.pop(); paint(); return;
    }
    if (selected.length === 0){
      selected = [{r:r,c:c}]; paint(); return;
    }
    var last = selected[selected.length-1];
    if (selected.length === 1){
      var dr = r - last.r, dc = c - last.c;
      if ((dr===0 && dc===1) || (dr===1 && dc===0)){
        selected.push({r:r,c:c}); paint(); maybeAutoMatch();
      } else {
        selected = [{r:r,c:c}]; paint();
      }
      return;
    }
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var ddr = r1 - r0, ddc = c1 - c0;
    var er = r0 + ddr * selected.length, ec = c0 + ddc * selected.length;
    if (r===er && c===ec){
      selected.push({r:r,c:c}); paint(); maybeAutoMatch();
    } else {
      selected = [{r:r,c:c}]; paint();
    }
  }

  function doSurrender(){
    if (locked) return;
    locked = true;
    revealed = true;
    selected = [];
    saveScore(); // only words found before surrender
    if (surrBtn) {
      surrBtn.disabled = true;
      surrBtn.textContent = "Menyerah — kata tersisa ditampilkan";
    }
    paint();
  }

  function paint(){
    ensureRun();
    var fc = foundCells();
    var selSet = {};
    for (var i=0;i<selected.length;i++) selSet[key(selected[i].r,selected[i].c)] = 1;

    for (var r=0;r<SIZE;r++){
      for (var c=0;c<SIZE;c++){
        var k = key(r,c);
        var d = cellNodes[k];
        if (!d) continue;
        d.className = "ws-cell";
        d.style.background = "";
        d.style.color = "";
        if (fc[k] === "found") {
          d.classList.add("found");
          d.style.background = "#1d4ed8";
          d.style.color = "#eff6ff";
        } else if (fc[k] === "reveal") {
          d.classList.add("reveal");
          d.style.background = "#2563eb";
          d.style.color = "#ffffff";
        }
        if (selSet[k] && !locked) {
          d.classList.add("sel");
          d.style.background = "#0ea5e9";
          d.style.color = "#0f172a";
        }
      }
    }

    var children = wordsEl.children;
    for (i=0;i<children.length;i++){
      var li = children[i];
      var w = li.getAttribute("data-word");
      if (found[w]) {
        li.classList.add("got");
        li.classList.remove("revealed");
        li.style.background = "#2563eb";
        li.style.color = "#ffffff";
      } else if (revealed) {
        li.classList.add("revealed");
        li.classList.remove("got");
        li.style.background = "#3b82f6";
        li.style.color = "#ffffff";
      } else {
        li.classList.remove("got");
        li.classList.remove("revealed");
        li.style.background = "";
        li.style.color = "";
      }
    }

    var n = foundCount();
    if (progressEl) progressEl.textContent = n + " / " + words.length + " kata";
    if (scoreEl) scoreEl.textContent = (n * POINTS) + " poin level ini";
    if (selInfo){
      if (locked && revealed) {
        selInfo.textContent = "Menyerah. Skor level: " + (n * POINTS) + " poin. Lanjut ke level berikutnya.";
      } else if (selected.length) {
        var t = "";
        for (i=0;i<selected.length;i++) t += grid[selected[i].r][selected[i].c];
        selInfo.textContent = "Pilihan: " + t;
      } else {
        selInfo.textContent = "Klik/sentuh huruf satu per satu — hanya kanan atau bawah.";
      }
    }
  }

  function buildUI(){
    gridEl.innerHTML = "";
    cellNodes = {};
    for (var r=0;r<SIZE;r++){
      for (var c=0;c<SIZE;c++){
        var d = document.createElement("button");
        d.type = "button";
        d.className = "ws-cell";
        d.textContent = grid[r][c];
        d.setAttribute("data-r", String(r));
        d.setAttribute("data-c", String(c));
        cellNodes[key(r,c)] = d;
        gridEl.appendChild(d);
      }
    }
    gridEl.onclick = function(ev){
      var t = ev.target;
      if (!t || !t.getAttribute || t.getAttribute("data-r") == null) return;
      onCellClick(parseInt(t.getAttribute("data-r"),10), parseInt(t.getAttribute("data-c"),10));
    };

    wordsEl.innerHTML = "";
    var sorted = words.slice().sort();
    for (var i=0;i<sorted.length;i++){
      var li = document.createElement("li");
      li.textContent = sorted[i];
      li.setAttribute("data-word", sorted[i]);
      wordsEl.appendChild(li);
    }
  }

  function tickTimer(){
    if (locked) return;
    var elapsed = Date.now() - startedAt;
    var left = Math.max(0, SURRENDER_MS - elapsed);
    var sec = Math.ceil(left / 1000);
    var mm = Math.floor(sec / 60);
    var ss = sec % 60;
    if (timerEl) {
      timerEl.textContent = "Sisa " + mm + ":" + (ss < 10 ? "0" : "") + ss;
    }
    if (left <= 0 && !surrShown) {
      surrShown = true;
      if (surrWrap) surrWrap.classList.add("show");
      if (timerEl) {
        timerEl.textContent = "Waktu 3 menit — bisa menyerah";
        timerEl.classList.add("warn");
      }
    }
    if (!locked) requestAnimationFrame(function(){ /* throttle */ });
  }

  var st0 = ensureRun();
  if (Array.isArray(st0.found[level])) {
    for (var fi=0; fi<st0.found[level].length; fi++) found[st0.found[level][fi]] = true;
  }
  buildUI();
  paint();

  if (surrBtn) surrBtn.onclick = doSurrender;
  var clr = document.getElementById("ws-clear");
  if (clr) clr.onclick = function(){ if (!locked) { selected=[]; paint(); } };

  setInterval(tickTimer, 500);
  tickTimer();
})();

  </script>
</Layout>
