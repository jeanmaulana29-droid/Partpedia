9],[19,10],[19,11],[19,12],[19,13],[19,14]]}]},"5":{"id":5,"words":["CONVEYOR","SPINDLE","CHUCK","COLLET","REAMER","DRILL","TAPER","KEYWAY","SPLINE","BUSH"],"grid":[["I","Y","N","D","L","H","Y","S","P","I","N","D","L","E","Y","Z","I","P","U","O"],["M","U","R","L","H","Q","J","G","I","F","Z","F","N","C","Y","O","E","N","U","L"],["N","K","V","L","J","S","U","K","T","X","L","E","B","U","Y","K","R","E","T","R"],["F","X","U","U","J","L","B","U","S","H","C","A","M","J","H","Q","C","J","H","T"],["V","P","D","V","E","A","Q","E","X","C","O","W","Z","U","S","D","R","V","C","W"],["E","X","B","C","E","L","N","P","J","H","N","J","K","Z","B","R","M","E","V","Z"],["Y","Z","K","A","J","O","W","X","V","I","V","Q","W","P","S","W","N","V","K","X"],["S","I","K","F","E","E","M","D","P","J","E","H","G","T","F","R","L","Q","L","D"],["P","X","E","C","J","O","S","V","J","A","Y","I","V","B","S","Z","Q","X","U","O"],["J","D","V","C","O","L","L","E","T","O","O","R","O","I","T","L","N","Y","K","R"],["Q","G","C","O","L","T","D","A","O","Q","R","T","C","B","N","U","W","D","N","C"],["A","I","M","T","T","R","R","Q","Y","O","Z","M","M","R","V","E","S","D","Z","L"],["S","Z","B","R","U","E","I","P","T","A","P","E","R","J","K","U","S","O","M","V"],["H","V","B","U","Y","A","L","K","Q","K","Z","I","H","C","L","L","P","F","U","Z"],["B","L","U","D","R","M","L","I","B","U","M","Y","G","W","W","O","L","P","C","S"],["W","M","X","H","J","E","W","I","R","Z","M","F","H","V","Y","M","I","O","T","P"],["X","L","Z","L","U","R","V","V","E","F","Z","C","H","U","C","K","N","P","D","C"],["Y","B","G","J","G","S","T","O","E","V","O","S","P","W","A","L","E","L","K","D"],["K","E","Y","W","A","Y","R","I","K","F","V","F","K","N","H","S","H","I","V","P"],["F","Z","B","I","H","I","T","U","T","B","B","Y","E","H","Z","F","M","C","O","M"]],"placed":[{"word":"DRILL","cells":[[10,6],[11,6],[12,6],[13,6],[14,6]]},{"word":"CHUCK","cells":[[16,11],[16,12],[16,13],[16,14],[16,15]]},{"word":"REAMER","cells":[[11,5],[12,5],[13,5],[14,5],[15,5],[16,5]]},{"word":"COLLET","cells":[[9,3],[9,4],[9,5],[9,6],[9,7],[9,8]]},{"word":"TAPER","cells":[[12,8],[12,9],[12,10],[12,11],[12,12]]},{"word":"CONVEYOR","cells":[[3,10],[4,10],[5,10],[6,10],[7,10],[8,10],[9,10],[10,10]]},{"word":"SPINDLE","cells":[[0,7],[0,8],[0,9],[0,10],[0,11],[0,12],[0,13]]},{"word":"KEYWAY","cells":[[18,0],[18,1],[18,2],[18,3],[18,4],[18,5]]},{"word":"SPLINE","cells":[[12,16],[13,16],[14,16],[15,16],[16,16],[17,16]]},{"word":"BUSH","cells":[[3,6],[3,7],[3,8],[3,9]]}]}};
  </script>
  <script is:inline>

(function(){
  var STEP = window.__WS_STEP__;
  var ALL = window.__WS_ALL__;
  var MAX = 5;
  var SIZE = 20;
  var POINTS = 2;
  var SURRENDER_MS = 3 * 60 * 1000;
  var SK = "partpedia_ws_batch1";

  function load(){ try { return JSON.parse(sessionStorage.getItem(SK)||"{}"); } catch(e){ return {}; } }
  function save(st){ sessionStorage.setItem(SK, JSON.stringify(st)); }

  function shuffleOrder(){
    var a = [1,2,3,4,5];
    for (var i=a.length-1;i>0;i--){
      var j = Math.floor(Math.random()*(i+1));
      var t=a[i]; a[i]=a[j]; a[j]=t;
    }
    return a;
  }

  function newRun(){
    return { runId: Date.now(), order: shuffleOrder(), scores: {}, found: {}, navFromGame: false };
  }

  // Entry control: internal nav keeps order; any other entry = new random run → step 1
  var st = load();
  if (st.navFromGame) {
    st.navFromGame = false;
    save(st);
  } else {
    st = newRun();
    save(st);
    if (STEP !== 1) {
      location.replace("/tools/word-search/1/");
      return;
    }
  }

  if (!st.order || st.order.length !== MAX) {
    st = newRun();
    save(st);
  }

  var puzzleId = st.order[STEP - 1];
  var puzzle = ALL[String(puzzleId)];
  if (!puzzle) { console.error("WS missing puzzle", puzzleId); return; }

  var level = STEP; // session step for score keys
  var grid = puzzle.grid;
  var placed = puzzle.placed;
  var words = puzzle.words;

  var gridEl = document.getElementById("ws-grid");
  var wordsEl = document.getElementById("ws-words");
  var progressEl = document.getElementById("ws-progress");
  var scoreEl = document.getElementById("ws-score");
  var timerEl = document.getElementById("ws-timer");
  var selInfo = document.getElementById("ws-sel");
  var surrWrap = document.getElementById("ws-surrender-wrap");
  var surrBtn = document.getElementById("ws-surrender");
  var titleStep = document.getElementById("ws-title-step");
  if (titleStep) titleStep.textContent = String(STEP);
  if (!gridEl || !wordsEl) return;

  var found = {};
  var revealed = false;
  var locked = false;
  var selected = [];
  var cellNodes = {};
  var startedAt = Date.now();
  var surrShown = false;

  // restore found for this session step
  if (Array.isArray(st.found[level])) {
    for (var fi=0; fi<st.found[level].length; fi++) found[st.found[level][fi]] = true;
  }

  function key(r,c){ return r+","+c; }
  function foundCount(){ var n=0; for (var k in found) if (found[k]) n++; return n; }
  function saveScore(){
    st = load();
    if (!st.scores) st.scores = {};
    if (!st.found) st.found = {};
    var keys = [];
    for (var k in found) if (found[k]) keys.push(k);
    st.found[level] = keys;
    st.scores[level] = keys.length * POINTS;
    save(st);
  }

  function foundCells(){
    var s = {};
    for (var i=0;i<placed.length;i++){
      var p = placed[i];
      for (var j=0;j<p.cells.length;j++){
        var kk = key(p.cells[j][0], p.cells[j][1]);
        if (found[p.word]) s[kk] = "found";
        else if (revealed) s[kk] = "reveal";
      }
    }
    return s;
  }

  function selectionValidDirection(){
    if (selected.length < 2) return true;
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var dr = r1 - r0, dc = c1 - c0;
    if (!((dr===0 && dc===1) || (dr===1 && dc===0))) return false;
    for (var i=1;i<selected.length;i++){
      if (selected[i].r !== r0 + dr*i || selected[i].c !== c0 + dc*i) return false;
    }
    return true;
  }

  function tryMatch(){
    if (locked || selected.length < 2) return;
    if (!selectionValidDirection()) { selected = []; paint(); return; }
    var fwd = "";
    for (var i=0;i<selected.length;i++) fwd += grid[selected[i].r][selected[i].c];
    for (i=0;i<placed.length;i++){
      var p = placed[i];
      if (found[p.word]) continue;
      if (p.word === fwd){
        found[p.word] = true;
        saveScore();
        selected = [];
        paint();
        if (foundCount() >= words.length) {
          locked = true;
          if (surrWrap) surrWrap.classList.remove("show");
        }
        return;
      }
    }
    selected = [];
    paint();
  }

  function maybeAutoMatch(){
    if (locked) return;
    var fwd = "";
    for (var i=0;i<selected.length;i++) fwd += grid[selected[i].r][selected[i].c];
    for (i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word === fwd){ tryMatch(); return; }
    }
    var maxLen = 0;
    for (i=0;i<placed.length;i++){
      if (!found[placed[i].word] && placed[i].word.length > maxLen) maxLen = placed[i].word.length;
    }
    if (selected.length >= maxLen && maxLen > 0) tryMatch();
  }

  function onCellClick(r,c){
    if (locked) return;
    if (selected.length && selected[selected.length-1].r===r && selected[selected.length-1].c===c){
      selected.pop(); paint(); return;
    }
    if (selected.length === 0){ selected = [{r:r,c:c}]; paint(); return; }
    var last = selected[selected.length-1];
    if (selected.length === 1){
      var dr = r - last.r, dc = c - last.c;
      if ((dr===0 && dc===1) || (dr===1 && dc===0)){
        selected.push({r:r,c:c}); paint(); maybeAutoMatch();
      } else { selected = [{r:r,c:c}]; paint(); }
      return;
    }
    var r0 = selected[0].r, c0 = selected[0].c;
    var r1 = selected[1].r, c1 = selected[1].c;
    var ddr = r1 - r0, ddc = c1 - c0;
    var er = r0 + ddr * selected.length, ec = c0 + ddc * selected.length;
    if (r===er && c===ec){ selected.push({r:r,c:c}); paint(); maybeAutoMatch(); }
    else { selected = [{r:r,c:c}]; paint(); }
  }

  function doSurrender(){
    if (locked) return;
    locked = true;
    revealed = true;
    selected = [];
    saveScore();
    if (surrBtn) {
      surrBtn.disabled = true;
      surrBtn.textContent = "Menyerah — kata tersisa ditampilkan";
    }
    paint();
  }

  function paint(){
    var fc = foundCells();
    var selSet = {};
    for (var i=0;i<selected.length;i++) selSet[key(selected[i].r,selected[i].c)] = 1;
    for (var r=0;r<SIZE;r++){
      for (var c=0;c<SIZE;c++){
        var k = key(r,c);
        var d = cellNodes[k];
        if (!d) continue;
        d.className = "ws-cell";
        d.style.background = "";
        d.style.color = "";
        if (fc[k] === "found") {
          d.classList.add("found");
          d.style.background = "#1d4ed8";
          d.style.color = "#eff6ff";
        } else if (fc[k] === "reveal") {
          d.classList.add("reveal");
          d.style.background = "#2563eb";
          d.style.color = "#ffffff";
        }
        if (selSet[k] && !locked) {
          d.classList.add("sel");
          d.style.background = "#0ea5e9";
          d.style.color = "#0f172a";
        }
      }
    }
    var children = wordsEl.children;
    for (i=0;i<children.length;i++){
      var li = children[i];
      var w = li.getAttribute("data-word");
      if (found[w]) {
        li.classList.add("got"); li.classList.remove("revealed");
        li.style.background = "#2563eb"; li.style.color = "#ffffff";
      } else if (revealed) {
        li.classList.add("revealed"); li.classList.remove("got");
        li.style.background = "#3b82f6"; li.style.color = "#ffffff";
      } else {
        li.classList.remove("got"); li.classList.remove("revealed");
        li.style.background = ""; li.style.color = "";
      }
    }
    var n = foundCount();
    if (progressEl) progressEl.textContent = n + " / " + words.length + " kata";
    if (scoreEl) scoreEl.textContent = (n * POINTS) + " poin level ini";
    if (selInfo){
      if (locked && revealed) selInfo.textContent = "Menyerah. Skor level: " + (n * POINTS) + " poin. Lanjut ke level berikutnya.";
      else if (selected.length) {
        var t = "";
        for (i=0;i<selected.length;i++) t += grid[selected[i].r][selected[i].c];
        selInfo.textContent = "Pilihan: " + t;
      } else selInfo.textContent = "Klik/sentuh huruf satu per satu — hanya kanan atau bawah.";
    }
  }

  function buildUI(){
    gridEl.innerHTML = "";
    cellNodes = {};
    for (var r=0;r<SIZE;r++){
      for (var c=0;c<SIZE;c++){
        var d = document.createElement("button");
        d.type = "button";
        d.className = "ws-cell";
        d.textContent = grid[r][c];
        d.setAttribute("data-r", String(r));
        d.setAttribute("data-c", String(c));
        cellNodes[key(r,c)] = d;
        gridEl.appendChild(d);
      }
    }
    gridEl.onclick = function(ev){
      var t = ev.target;
      if (!t || !t.getAttribute || t.getAttribute("data-r") == null) return;
      onCellClick(parseInt(t.getAttribute("data-r"),10), parseInt(t.getAttribute("data-c"),10));
    };
    wordsEl.innerHTML = "";
    var sorted = words.slice().sort();
    for (var i=0;i<sorted.length;i++){
      var li = document.createElement("li");
      li.textContent = sorted[i];
      li.setAttribute("data-word", sorted[i]);
      wordsEl.appendChild(li);
    }
  }

  function tickTimer(){
    if (locked) return;
    var elapsed = Date.now() - startedAt;
    var left = Math.max(0, SURRENDER_MS - elapsed);
    var sec = Math.ceil(left / 1000);
    var mm = Math.floor(sec / 60);
    var ss = sec % 60;
    if (timerEl) timerEl.textContent = "Sisa " + mm + ":" + (ss < 10 ? "0" : "") + ss;
    if (left <= 0 && !surrShown) {
      surrShown = true;
      if (surrWrap) surrWrap.classList.add("show");
      if (timerEl) { timerEl.textContent = "Waktu 3 menit — bisa menyerah"; timerEl.classList.add("warn"); }
    }
  }

  // Next / Back: mark internal navigation so order is kept
  function markNav(){
    var s = load();
    s.navFromGame = true;
    save(s);
  }
  var nextA = document.getElementById("ws-next");
  var backA = document.getElementById("ws-back-level");
  if (nextA) nextA.addEventListener("click", markNav);
  if (backA) backA.addEventListener("click", markNav);

  buildUI();
  paint();
  if (surrBtn) surrBtn.onclick = doSurrender;
  var clr = document.getElementById("ws-clear");
  if (clr) clr.onclick = function(){ if (!locked) { selected=[]; paint(); } };
  setInterval(tickTimer, 500);
  tickTimer();
})();

  </script>
