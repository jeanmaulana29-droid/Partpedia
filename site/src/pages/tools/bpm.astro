---
import Layout from "../../layouts/Layout.astro";
---
<Layout
  title="BPM Berat per Meter — Smart Tools · Partpedia"
  description="Hitung berat per meter (BPM) dari total berat dan panjang, atau cari berat / panjang dari BPM. Isi 2 kolom, kosongkan 1 yang dicari."
>
  <div class="tool-page">
    <a class="back" href="/tools/">← Semua Smart Tools</a>
    <div class="tool-card">
      <h1>BPM · Berat per Meter</h1>
      <p class="desc">
        Hitung berat per meter dari total berat gulungan/coil dan panjang total, atau sebaliknya.
        Isi 2 nilai yang diketahui, kosongkan 1 kolom yang ingin dicari.
      </p>
      <div class="fields cols-3">
        <div class="field">
          <label for="berat">Berat total <span>(kg)</span></label>
          <input id="berat" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" />
        </div>
        <div class="field">
          <label for="panjang">Panjang total <span>(m)</span></label>
          <input id="panjang" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" />
        </div>
        <div class="field">
          <label for="bpm">BPM <span>(kg/m)</span></label>
          <input id="bpm" type="number" inputmode="decimal" step="any" placeholder="—" autocomplete="off" />
        </div>
      </div>
      <div class="actions">
        <button type="button" class="btn-calc" id="btn-calc">Hitung</button>
        <button type="button" class="btn-reset" id="btn-reset">Reset</button>
        <p class="msg" id="msg" role="status"></p>
      </div>
      <p class="hint">
        <strong>Cara pakai:</strong>
        Isi dua kolom, kosongkan satu yang dicari.
        Contoh: isi berat (kg) + panjang (m) → BPM (kg/m).
        Atau isi BPM + panjang → berat total; isi BPM + berat → panjang total.
        Kolom hasil ditandai warna tosca. Satuan: berat dalam <strong>kg</strong>, panjang dalam <strong>meter</strong>, BPM dalam <strong>kg/m</strong>.
      </p>
    </div>
  </div>
  <script is:inline>
  (function () {
    function parseNum(el) {
      if (!el) return null;
      let v = String(el.value || "").trim().replace(",", ".");
      if (v === "") return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : NaN;
    }
    function fmt(x) {
      if (!Number.isFinite(x)) return "";
      const a = Math.abs(x);
      if (a !== 0 && (a < 1e-7 || a >= 1e10)) return x.toExponential(8);
      return x.toFixed(10).replace(/\.?0+$/, "");
    }
    const ids = ["berat", "panjang", "bpm"];
    function clearComputed(list) {
      list.forEach((id) => {
        const el = document.getElementById(id);
        el?.closest(".field")?.classList.remove("is-result");
        if (el?.dataset.computed === "1") {
          el.value = "";
          delete el.dataset.computed;
        }
      });
    }
    function setResult(id, value) {
      const el = document.getElementById(id);
      if (!el) return;
      el.value = fmt(value);
      el.dataset.computed = "1";
      el.closest(".field")?.classList.add("is-result");
    }
    function compute() {
      const msg = document.getElementById("msg");
      clearComputed(ids);
      const berat = parseNum(document.getElementById("berat"));
      const panjang = parseNum(document.getElementById("panjang"));
      const bpm = parseNum(document.getElementById("bpm"));
      if ([berat, panjang, bpm].some((v) => v !== null && Number.isNaN(v))) {
        msg.textContent = "Nilai tidak valid.";
        return;
      }
      if ([berat, panjang, bpm].some((v) => v !== null && v < 0)) {
        msg.textContent = "Nilai harus ≥ 0.";
        return;
      }
      const n = [berat, panjang, bpm].filter((v) => v !== null).length;
      if (n < 2) {
        msg.textContent = "Isi minimal 2 kolom.";
        return;
      }
      if (n > 2) {
        msg.textContent = "Kosongkan 1 kolom yang dicari.";
        return;
      }
      try {
        if (berat !== null && panjang !== null && bpm === null) {
          if (panjang === 0) throw new Error("Panjang tidak boleh 0.");
          setResult("bpm", berat / panjang);
          msg.textContent = "BPM dihitung dari berat ÷ panjang.";
        } else if (berat !== null && bpm !== null && panjang === null) {
          if (bpm === 0) throw new Error("BPM tidak boleh 0.");
          setResult("panjang", berat / bpm);
          msg.textContent = "Panjang dihitung dari berat ÷ BPM.";
        } else if (panjang !== null && bpm !== null && berat === null) {
          setResult("berat", bpm * panjang);
          msg.textContent = "Berat dihitung dari BPM × panjang.";
        }
      } catch (e) {
        msg.textContent = e.message || "Tidak valid";
      }
    }
    function wire() {
      const msg = document.getElementById("msg");
      ids.forEach((id) => {
        const el = document.getElementById(id);
        el?.addEventListener("input", () => {
          if (el.dataset.computed === "1") {
            delete el.dataset.computed;
            el.closest(".field")?.classList.remove("is-result");
          } else {
            clearComputed(ids);
          }
          const filled = ids.filter((i) => {
            const v = parseNum(document.getElementById(i));
            return v !== null && !Number.isNaN(v);
          }).length;
          if (filled >= 2) compute();
          else if (msg) msg.textContent = "";
        });
        el?.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            compute();
          }
        });
      });
      document.getElementById("btn-calc")?.addEventListener("click", compute);
      document.getElementById("btn-reset")?.addEventListener("click", () => {
        ids.forEach((id) => {
          const el = document.getElementById(id);
          if (el) {
            el.value = "";
            delete el.dataset.computed;
            el.closest(".field")?.classList.remove("is-result");
          }
        });
        if (msg) msg.textContent = "";
      });
    }
    wire();
  })();
  </script>
  <style>
  .tool-page { max-width: 720px; margin: 0 auto; padding: 1.25rem 0 3rem; }
  .back { display:inline-flex; align-items:center; gap:0.35rem; font-size:0.88rem; color: var(--muted); text-decoration:none; margin-bottom:0.85rem; }
  .back:hover { color: var(--amber); }
  .tool-card {
    border:1px solid var(--line); border-radius:22px; padding:1.25rem;
    background: radial-gradient(120% 80% at 0% 0%, rgba(45,212,191,0.08), transparent 50%), var(--bg-card);
    box-shadow: 0 18px 48px rgba(0,0,0,0.2);
  }
  .tool-card h1 { margin:0 0 0.35rem; font-family: var(--font-display); font-size:1.45rem; }
  .tool-card .desc { margin:0 0 1rem; color: var(--muted); font-size:0.92rem; line-height:1.5; }
  .fields { display:grid; gap:0.75rem; }
  @media(min-width:560px){ .fields.cols-3{ grid-template-columns:1fr 1fr 1fr;} }
  .field { display:flex; flex-direction:column; gap:0.35rem; padding:0.75rem 0.85rem; border-radius:14px;
    border:1px solid var(--line); background:rgba(0,0,0,0.22); transition: border-color .15s, background .15s, box-shadow .15s; }
  .field label { font-size:0.8rem; font-weight:600; color: var(--ink); }
  .field label span { font-weight:500; color: var(--muted); font-size:0.75rem; }
  .field input { border:none; outline:none; background:transparent; color: var(--ink); font-size:1.25rem; font-weight:700; font-family: var(--font-mono); width:100%; }
  .field.is-result { border-color: rgba(45,212,191,0.65); background: rgba(45,212,191,0.12); box-shadow:0 0 0 3px rgba(45,212,191,0.12); }
  .field.is-result label { color: var(--teal); }
  .actions { display:flex; flex-wrap:wrap; gap:0.6rem; align-items:center; margin-top:1rem; }
  .btn-calc { appearance:none; border:none; cursor:pointer; font-weight:800; padding:0.7rem 1.25rem; border-radius:999px;
    background: linear-gradient(135deg,#2dd4bf,#14b8a6); color:#041016; }
  .btn-reset { appearance:none; cursor:pointer; font-weight:600; padding:0.65rem 1.1rem; border-radius:999px;
    background:transparent; border:1px solid var(--line); color: var(--ink); }
  .msg { margin:0; font-size:0.86rem; color: var(--muted); }
  .hint { margin-top:1rem; padding:0.75rem 0.9rem; border-radius:12px; border:1px solid rgba(255,255,255,0.08);
    background:rgba(255,255,255,0.03); font-size:0.84rem; color: var(--muted); line-height:1.45; }
  </style>
</Layout>
