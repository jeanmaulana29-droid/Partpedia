tle": "Surface texture: Profile method (replaces ISO 4287 / 4288 / 1302)", "use": "Machined surfaces, sealing faces, bearing seats surface finish", "calc": true, "tab": "ra", "rank": 4}, {"code": "ISO 14405-1/2/3", "title": "Dimensional tolerancing — Linear sizes and other dimensions", "use": "When drawing must clarify two-point vs envelope size definition", "calc": false, "tab": null, "rank": 5}, {"code": "ISO 22081:2021", "title": "Geometrical tolerancing — General geometrical specifications and general size specifications", "use": "New drawings preferring current GPS defaults over ISO 2768-2", "calc": false, "tab": null, "rank": 6}, {"code": "ISO 13920", "title": "Welding — General tolerances for welded constructions", "use": "Welded frames, structures, fabrications", "calc": false, "tab": null, "rank": 7}, {"code": "ISO 965", "title": "ISO general purpose metric screw threads — Tolerances", "use": "Bolts, nuts, tapped holes — not covered by ISO 2768", "calc": false, "tab": null, "rank": 8}], "hierarchy": {"en": "On a drawing: explicit individual tolerance > fit code (ISO 286) > GD&T feature control (ISO 1101) > general note (ISO 2768 / ISO 22081).", "id": "Di gambar: toleransi individu eksplisit > kode fit (ISO 286) > GD&T (ISO 1101) > catatan umum (ISO 2768 / ISO 22081)."}};
  </script>
  <script is:inline>
  (function () {
    const S = window.__S__;

    function bandIndex(nom) {
      const bands = S.size_bands || [];
      for (let i = 0; i < bands.length; i++) {
        if (nom > bands[i].over && nom <= bands[i].to) return i;
        if (i === 0 && nom > 0 && nom <= bands[i].to) return 0;
      }
      return Math.max(0, bands.length - 1);
    }
    function fmtMm(m) {
      return (Math.round(m * 10000) / 10000).toFixed(3) + " mm";
    }

    function goTab(name) {
      document.querySelectorAll(".tab").forEach((b) => b.classList.remove("active"));
      document.querySelectorAll(".panel").forEach((p) => p.classList.remove("active"));
      document.querySelector('.tab[data-tab="' + name + '"]')?.classList.add("active");
      document.getElementById("panel-" + name)?.classList.add("active");
    }
    document.querySelectorAll(".tab").forEach((btn) => {
      btn.addEventListener("click", () => goTab(btn.dataset.tab));
    });
    document.querySelectorAll(".qchip[data-tab]").forEach((b) => {
      b.addEventListener("click", () => goTab(b.dataset.tab));
    });

    // selects
    const holeSel = document.getElementById("fit-hole");
    const shaftSel = document.getElementById("fit-shaft");
    const presetSel = document.getElementById("fit-preset");
    Object.keys(S.holes || {}).forEach((h) => {
      const o = document.createElement("option");
      o.value = h; o.textContent = h;
      if (h === "H7") o.selected = true;
      holeSel.appendChild(o);
    });
    Object.keys(S.shafts || {}).forEach((s) => {
      const o = document.createElement("option");
      o.value = s; o.textContent = s;
      if (s === "g6") o.selected = true;
      shaftSel.appendChild(o);
    });
    (S.preferred_fits || []).forEach((f) => {
      const o = document.createElement("option");
      o.value = f.id;
      o.textContent = f.id + " — " + (f.name_id || f.name_en || "");
      presetSel.appendChild(o);
    });
    presetSel.addEventListener("change", () => {
      const f = (S.preferred_fits || []).find((x) => x.id === presetSel.value);
      if (f) { holeSel.value = f.hole; shaftSel.value = f.shaft; }
    });

    function calcFit() {
      const nom = parseFloat(document.getElementById("fit-nom").value);
      const hole = holeSel.value, shaft = shaftSel.value;
      const box = document.getElementById("fit-result");
      box.hidden = false;
      if (!isFinite(nom) || nom <= 0) { box.innerHTML = "<p class='err'>Ø tidak valid.</p>"; return; }
      const i = bandIndex(nom);
      const H = S.holes?.[hole]?.[i], Sh = S.shafts?.[shaft]?.[i];
      if (!H || !Sh) { box.innerHTML = "<p class='err'>Di luar tabel.</p>"; return; }
      const holeMax = nom + H.ES/1000, holeMin = nom + H.EI/1000;
      const shaftMax = nom + Sh.es/1000, shaftMin = nom + Sh.ei/1000;
      const maxC = holeMax - shaftMin, minC = holeMin - shaftMax;
      let fitType, fitLabel;
      if (minC > 0) { fitType = "clearance"; fitLabel = "Clearance"; }
      else if (maxC < 0) { fitType = "interference"; fitLabel = "Interference"; }
      else { fitType = "transition"; fitLabel = "Transition"; }
      const band = S.size_bands[i];
      box.innerHTML = `
        <div class="rtype ${fitType}">${fitLabel} · ${hole}/${shaft}</div>
        <div class="nums">
          <div class="num-card">
            <div class="num-h">HOLE ${hole}</div>
            <div class="num-big">${fmtMm(holeMin)}</div><div class="num-sub">min · EI ${H.EI} µm</div>
            <div class="num-big">${fmtMm(holeMax)}</div><div class="num-sub">max · ES ${H.ES} µm</div>
          </div>
          <div class="num-card">
            <div class="num-h">SHAFT ${shaft}</div>
            <div class="num-big">${fmtMm(shaftMin)}</div><div class="num-sub">min · ei ${Sh.ei} µm</div>
            <div class="num-big">${fmtMm(shaftMax)}</div><div class="num-sub">max · es ${Sh.es} µm</div>
          </div>
        </div>
        <div class="rlist">
          <div class="rrow"><span>Max clearance</span><b>${fmtMm(maxC)}</b></div>
          <div class="rrow"><span>Min clearance</span><b>${fmtMm(minC)}</b></div>
          <div class="rrow"><span>Band</span><b>${band.over}–${band.to} mm</b></div>
        </div>`;
    }

    function calcIT() {
      const nom = parseFloat(document.getElementById("it-nom").value);
      const grade = document.getElementById("it-grade").value;
      const box = document.getElementById("it-result");
      const i = bandIndex(nom);
      const um = S.IT?.[grade]?.[i];
      box.hidden = false;
      if (!isFinite(nom) || um == null) { box.innerHTML = "<p class='err'>Data IT tidak ada.</p>"; return; }
      const band = S.size_bands[i];
      box.innerHTML = `
        <div class="rtype clearance">${grade}</div>
        <div class="num-solo"><div class="num-big-solo">${um} <span>µm</span></div>
        <div class="num-sub">= ${fmtMm(um/1000)}</div></div>
        <div class="rlist">
          <div class="rrow"><span>Nominal</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Band</span><b>${band.over}–${band.to} mm</b></div>
        </div>`;
    }

    function calcG() {
      const nom = parseFloat(document.getElementById("g-nom").value);
      const cls = document.getElementById("g-class").value;
      const box = document.getElementById("g-result");
      const rows = S.iso_2768_1_linear?.ranges || [];
      let row = rows.find((r) => nom > r.min - 1e-9 && nom <= r.max);
      if (nom >= 0.5 && nom <= 3) row = rows[0];
      const val = row ? row[cls] : null;
      box.hidden = false;
      if (val == null) { box.innerHTML = "<p class='err'>Kelas tidak berlaku.</p>"; return; }
      box.innerHTML = `
        <div class="rtype clearance">ISO 2768-${cls}</div>
        <div class="num-solo"><div class="num-big-solo">± ${val} <span>mm</span></div></div>
        <div class="rlist">
          <div class="rrow"><span>Min</span><b>${fmtMm(nom - val)}</b></div>
          <div class="rrow"><span>Max</span><b>${fmtMm(nom + val)}</b></div>
          <div class="rrow"><span>Rentang</span><b>${row.min}–${row.max} mm</b></div>
        </div>`;
    }

    function calcGeo() {
      const nom = parseFloat(document.getElementById("geo-nom").value);
      const cls = document.getElementById("geo-class").value;
      const box = document.getElementById("geo-result");
      const rows = S.iso_2768_2?.straightness_flatness || [];
      let row = rows.find((r) => nom > r.min - 1e-9 && nom <= r.max) || rows[rows.length - 1];
      if (nom <= 10) row = rows[0];
      const perpRows = S.iso_2768_2?.perpendicularity || [];
      let pr = perpRows.find((r) => nom > r.min - 1e-9 && nom <= r.max) || perpRows[perpRows.length - 1];
      if (nom <= 100) pr = perpRows[0];
      const run = S.iso_2768_2?.runout?.[cls];
      box.hidden = false;
      box.innerHTML = `
        <div class="rtype transition">2768-2 · ${cls}</div>
        <div class="rlist">
          <div class="rrow"><span>Flatness / Straightness</span><b>${row[cls]} mm</b></div>
          <div class="rrow"><span>Perpendicularity</span><b>${pr[cls]} mm</b></div>
          <div class="rrow"><span>Run-out</span><b>${run} mm</b></div>
        </div>`;
    }

    function calcAng() {
      const side = parseFloat(document.getElementById("ang-side").value);
      const cls = document.getElementById("ang-class").value;
      const box = document.getElementById("ang-result");
      const rows = S.iso_2768_1_angular?.ranges || [];
      let row = rows.find((r) => {
        const min = r.min_side ?? 0;
        const max = r.max_side ?? 1e9;
        if (r.max_side == null && r.min_side) return side > r.min_side;
        if (r.min_side == null) return side <= (r.max_side ?? 10);
        return side > min && side <= max;
      }) || rows[rows.length - 1];
      // fix first row: up to 10
      if (side <= 10) row = rows[0];
      else if (side <= 50) row = rows[1];
      else if (side <= 120) row = rows[2];
      else if (side <= 400) row = rows[3];
      else row = rows[4];
      const val = row[cls];
      box.hidden = false;
      box.innerHTML = `
        <div class="rtype clearance">ISO 2768 sudut</div>
        <div class="num-solo"><div class="num-big-solo">${val}</div></div>
        <div class="rlist">
          <div class="rrow"><span>Sisi pendek</span><b>${side} mm</b></div>
          <div class="rrow"><span>Kelas</span><b>${cls === "f_m" ? "f / m" : cls}</b></div>
        </div>`;
    }

    function calcCh() {
      const nom = parseFloat(document.getElementById("ch-nom").value);
      const cls = document.getElementById("ch-class").value;
      const box = document.getElementById("ch-result");
      const rows = S.iso_2768_1_chamfer?.ranges || [];
      let row = rows[0];
      if (nom > 6) row = rows[2];
      else if (nom > 3) row = rows[1];
      const val = row[cls];
      box.hidden = false;
      box.innerHTML = `
        <div class="rtype clearance">Chamfer / radius</div>
        <div class="num-solo"><div class="num-big-solo">± ${val} <span>mm</span></div></div>
        <div class="rlist">
          <div class="rrow"><span>Nominal</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Rentang tabel</span><b>${row.min}–${row.max === 9999 ? "…" : row.max} mm</b></div>
        </div>`;
    }

    document.getElementById("btn-fit").addEventListener("click", calcFit);
    document.getElementById("btn-it").addEventListener("click", calcIT);
    document.getElementById("btn-g").addEventListener("click", calcG);
    document.getElementById("btn-geo").addEventListener("click", calcGeo);
    document.getElementById("btn-ang").addEventListener("click", calcAng);
    document.getElementById("btn-ch").addEventListener("click", calcCh);

    // static lists
    const raBox = document.getElementById("ra-table");
    if (raBox && S.surface_ra) {
      raBox.innerHTML = `<table class="rt"><thead><tr><th>Proses</th><th>Ra (µm)</th></tr></thead><tbody>` +
        S.surface_ra.map((r) => `<tr><td>${r.process}</td><td><b>${r.ra_typical}</b></td></tr>`).join("") +
        `</tbody></table>`;
    }
    const ig = document.getElementById("it-guide");
    if (ig && S.it_guide) {
      ig.innerHTML = S.it_guide.map((g) => `<div class="mini-row"><b>${g.grade}</b><span>${g.typical}</span></div>`).join("");
    }
    const cat = document.getElementById("cat-list");
    if (cat && S.catalog) {
      cat.innerHTML = S.catalog.sort((a,b)=>a.rank-b.rank).map((c) =>
        `<div class="std-item">
          <div class="std-code">${c.code}${c.calc ? ' <span class="badge-calc">kalkulator</span>' : ''}</div>
          <div class="std-title">${c.title}</div>
          <div class="std-use">${c.use}</div>
          ${c.tab ? `<button type="button" class="linkish" data-goto="${c.tab}">Buka tool →</button>` : ""}
        </div>`
      ).join("");
      cat.querySelectorAll("[data-goto]").forEach((b) => b.addEventListener("click", () => goTab(b.dataset.goto)));
    }
    const gdt = document.getElementById("gdt-list");
    if (gdt && S.gdt_symbols) {
      gdt.innerHTML = S.gdt_symbols.map((g) =>
        `<span class="chip"><b>${g.name_en}</b><small>${g.name_id} · ${g.group}</small></span>`
      ).join("");
    }
    const fl = document.getElementById("fits-list");
    if (fl && S.preferred_fits) {
      fl.innerHTML = `<table class="rt"><thead><tr><th>Fit</th><th>Tipe</th><th>Pakai</th></tr></thead><tbody>` +
        S.preferred_fits.map((f) =>
          `<tr class="fit-row" data-fit="${f.id}" style="cursor:pointer"><td><b>${f.id}</b></td><td>${f.type}</td><td>${f.name_id || f.name_en || f.use || ""}</td></tr>`
        ).join("") + `</tbody></table>`;
      fl.querySelectorAll(".fit-row").forEach((tr) => {
        tr.addEventListener("click", () => {
          const f = S.preferred_fits.find((x) => x.id === tr.dataset.fit);
          if (!f) return;
          goTab("fits");
          holeSel.value = f.hole; shaftSel.value = f.shaft; presetSel.value = f.id;
          calcFit();
        });
      });
    }
    const hier = document.getElementById("hier");
    if (hier && S.hierarchy) {
      hier.innerHTML = `<strong>Hierarki gambar:</strong> ${S.hierarchy.en || ""}`;
    }

    // search parse
    function parseQuery(raw) {
      const q = (raw || "").trim();
      if (!q) return null;
      const lower = q.toLowerCase();
      let m = q.match(/(\d+(?:[.,]\d+)?)\s*([A-Za-z])(\d+)\s*[/]?\s*([a-z])(\d+)/i);
      if (m) return { type: "fit", nom: parseFloat(m[1].replace(",",".")), hole: m[2].toUpperCase()+m[3], shaft: m[4].toLowerCase()+m[5] };
      m = q.match(/([A-Za-z])(\d+)\s*[/]\s*([a-z])(\d+)/i);
      if (m) return { type: "fit", hole: m[1].toUpperCase()+m[2], shaft: m[3].toLowerCase()+m[4], nom: null };
      m = lower.match(/it\s*(\d+)\s+(\d+(?:[.,]\d+)?)/) || lower.match(/(\d+(?:[.,]\d+)?)\s*it\s*(\d+)/);
      if (m) {
        if (lower.indexOf("it") <= lower.search(/\d/)) return { type: "it", grade: "IT"+m[1], nom: parseFloat(m[2].replace(",",".")) };
        return { type: "it", nom: parseFloat(m[1].replace(",",".")), grade: "IT"+m[2] };
      }
      m = lower.match(/2768\s*-?\s*([fmcv])\s+(\d+(?:[.,]\d+)?)/);
      if (m) return { type: "g2768", cls: m[1], nom: parseFloat(m[2].replace(",",".")) };
      if (lower.includes("sudut") || lower.includes("angle") || lower.includes("angular")) {
        m = lower.match(/(\d+(?:[.,]\d+)?)/);
        const cls = lower.includes(" c") || lower.endsWith(" c") ? "c" : (lower.includes(" v") ? "v" : "f_m");
        return { type: "angle", side: m ? parseFloat(m[1].replace(",",".")) : null, cls };
      }
      if (lower.includes("chamfer") || lower.includes("radius") || lower.includes("jari")) {
        m = lower.match(/(\d+(?:[.,]\d+)?)/);
        return { type: "chamfer", nom: m ? parseFloat(m[1].replace(",",".")) : null, cls: lower.includes("c") || lower.includes("v") ? "c_v" : "f_m" };
      }
      if (lower.includes("geo") || lower.includes("kerataan") || lower.includes("flatness")) {
        m = lower.match(/(\d+(?:[.,]\d+)?)\s*([hkl])/) || lower.match(/([hkl])\s*(\d+(?:[.,]\d+)?)/);
        if (m) {
          if (/^\d/.test(m[1])) return { type: "geo", nom: parseFloat(m[1].replace(",",".")), cls: m[2].toUpperCase() };
          return { type: "geo", cls: m[1].toUpperCase(), nom: parseFloat(m[2].replace(",",".")) };
        }
        return { type: "tab", tab: "geo" };
      }
      if (lower === "ra" || lower.includes("roughness") || lower.includes("kekasaran")) return { type: "tab", tab: "ra" };
      if (lower.includes("gdt") || lower.includes("1101") || lower.includes("standar") || lower.includes("standard")) return { type: "tab", tab: "ref" };
      const fit = (S.preferred_fits || []).find((f) => f.id.toLowerCase().replace(/\s/g,"") === lower.replace(/\s/g,""));
      if (fit) return { type: "fit", hole: fit.hole, shaft: fit.shaft, nom: null };
      return null;
    }

    function applyParsed(p) {
      if (!p) return;
      if (p.type === "tab") { goTab(p.tab); return; }
      if (p.type === "fit") {
        goTab("fits");
        if (p.nom != null) document.getElementById("fit-nom").value = p.nom;
        if (p.hole && S.holes[p.hole]) holeSel.value = p.hole;
        if (p.shaft && S.shafts[p.shaft]) shaftSel.value = p.shaft;
        const pref = (S.preferred_fits || []).find((f) => f.hole === holeSel.value && f.shaft === shaftSel.value);
        if (pref) presetSel.value = pref.id;
        calcFit();
      } else if (p.type === "it") {
        goTab("it");
        if (p.nom != null) document.getElementById("it-nom").value = p.nom;
        if (p.grade) {
          const sel = document.getElementById("it-grade");
          for (const o of sel.options) if (o.value === p.grade) sel.value = p.grade;
        }
        calcIT();
      } else if (p.type === "g2768") {
        goTab("g2768");
        if (p.nom != null) document.getElementById("g-nom").value = p.nom;
        if (p.cls) document.getElementById("g-class").value = p.cls;
        calcG();
      } else if (p.type === "geo") {
        goTab("geo");
        if (p.nom != null) document.getElementById("geo-nom").value = p.nom;
        if (p.cls) document.getElementById("geo-class").value = p.cls;
        calcGeo();
      } else if (p.type === "angle") {
        goTab("angle");
        if (p.side != null) document.getElementById("ang-side").value = p.side;
        if (p.cls) document.getElementById("ang-class").value = p.cls;
        calcAng();
      } else if (p.type === "chamfer") {
        goTab("chamfer");
        if (p.nom != null) document.getElementById("ch-nom").value = p.nom;
        if (p.cls) document.getElementById("ch-class").value = p.cls;
        calcCh();
      }
    }

    const qEl = document.getElementById("q");
    const sug = document.getElementById("suggest");
    function showSuggest(raw) {
      const p = parseQuery(raw);
      const items = [];
      if (p && p.type !== "tab") {
        const labels = {
          fit: "Fit → angka hole/shaft µm",
          it: "IT → lebar µm",
          g2768: "2768 → ± mm",
          geo: "Geo → mm",
          angle: "Sudut → derajat",
          chamfer: "Chamfer → ± mm",
        };
        items.push({ t: raw.trim() || p.type, s: labels[p.type] || "hitung", p });
      }
      if (p && p.type === "tab") items.push({ t: "Buka " + p.tab, s: "tab referensi / list", p });
      (S.preferred_fits || []).forEach((f) => {
        if ((raw || "").length >= 2 && f.id.toLowerCase().includes((raw || "").toLowerCase())) {
          items.push({ t: f.id, s: "hitung limits", p: { type: "fit", hole: f.hole, shaft: f.shaft, nom: null } });
        }
      });
      if (!items.length) { sug.hidden = true; return; }
      sug.innerHTML = items.slice(0, 6).map((it, i) =>
        `<button type="button" class="sug-item" data-i="${i}"><strong>${it.t}</strong><span>${it.s}</span></button>`
      ).join("");
      sug._items = items;
      sug.hidden = false;
    }
    qEl.addEventListener("input", () => showSuggest(qEl.value));
    qEl.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        const p = parseQuery(qEl.value) || sug._items?.[0]?.p;
        if (p) { applyParsed(p); sug.hidden = true; }
      }
    });
    sug.addEventListener("click", (e) => {
      const b = e.target.closest(".sug-item");
      if (!b) return;
      applyParsed(sug._items[+b.dataset.i]?.p);
      sug.hidden = true;
    });
    document.addEventListener("click", (e) => {
      if (!e.target.closest(".search-box")) sug.hidden = true;
    });
    document.querySelectorAll(".qchip[data-q]").forEach((btn) => {
      btn.addEventListener("click", () => {
        qEl.value = btn.dataset.q;
        const p = parseQuery(btn.dataset.q);
        if (p) applyParsed(p);
      });
    });

    calcFit();
  })();
  </script>

