4, "ei": -12}, {"es": -5, "ei": -14}, {"es": -6, "ei": -17}, {"es": -7, "ei": -20}, {"es": -9, "ei": -25}, {"es": -10, "ei": -29}, {"es": -12, "ei": -34}, {"es": -14, "ei": -39}, {"es": -15, "ei": -44}, {"es": -17, "ei": -49}, {"es": -18, "ei": -54}, {"es": -20, "ei": -60}], "h6": [{"es": 0, "ei": -6}, {"es": 0, "ei": -8}, {"es": 0, "ei": -9}, {"es": 0, "ei": -11}, {"es": 0, "ei": -13}, {"es": 0, "ei": -16}, {"es": 0, "ei": -19}, {"es": 0, "ei": -22}, {"es": 0, "ei": -25}, {"es": 0, "ei": -29}, {"es": 0, "ei": -32}, {"es": 0, "ei": -36}, {"es": 0, "ei": -40}], "h7": [{"es": 0, "ei": -10}, {"es": 0, "ei": -12}, {"es": 0, "ei": -15}, {"es": 0, "ei": -18}, {"es": 0, "ei": -21}, {"es": 0, "ei": -25}, {"es": 0, "ei": -30}, {"es": 0, "ei": -35}, {"es": 0, "ei": -40}, {"es": 0, "ei": -46}, {"es": 0, "ei": -52}, {"es": 0, "ei": -57}, {"es": 0, "ei": -63}], "js6": [{"es": 3, "ei": -3}, {"es": 4, "ei": -4}, {"es": 4.5, "ei": -4.5}, {"es": 5.5, "ei": -5.5}, {"es": 6.5, "ei": -6.5}, {"es": 8, "ei": -8}, {"es": 9.5, "ei": -9.5}, {"es": 11, "ei": -11}, {"es": 12.5, "ei": -12.5}, {"es": 14.5, "ei": -14.5}, {"es": 16, "ei": -16}, {"es": 18, "ei": -18}, {"es": 20, "ei": -20}], "k6": [{"es": 6, "ei": 0}, {"es": 9, "ei": 1}, {"es": 10, "ei": 1}, {"es": 12, "ei": 1}, {"es": 15, "ei": 2}, {"es": 18, "ei": 2}, {"es": 21, "ei": 2}, {"es": 25, "ei": 3}, {"es": 28, "ei": 3}, {"es": 33, "ei": 4}, {"es": 36, "ei": 4}, {"es": 40, "ei": 4}, {"es": 45, "ei": 5}], "n6": [{"es": 10, "ei": 4}, {"es": 16, "ei": 8}, {"es": 19, "ei": 10}, {"es": 23, "ei": 12}, {"es": 28, "ei": 15}, {"es": 33, "ei": 17}, {"es": 39, "ei": 20}, {"es": 45, "ei": 23}, {"es": 52, "ei": 27}, {"es": 60, "ei": 31}, {"es": 66, "ei": 34}, {"es": 73, "ei": 37}, {"es": 80, "ei": 40}], "p6": [{"es": 12, "ei": 6}, {"es": 20, "ei": 12}, {"es": 24, "ei": 15}, {"es": 29, "ei": 18}, {"es": 35, "ei": 22}, {"es": 42, "ei": 26}, {"es": 51, "ei": 32}, {"es": 59, "ei": 37}, {"es": 68, "ei": 43}, {"es": 79, "ei": 50}, {"es": 88, "ei": 56}, {"es": 98, "ei": 62}, {"es": 108, "ei": 68}], "s6": [{"es": 20, "ei": 14}, {"es": 27, "ei": 19}, {"es": 32, "ei": 23}, {"es": 39, "ei": 28}, {"es": 48, "ei": 35}, {"es": 59, "ei": 43}, {"es": 72, "ei": 53}, {"es": 93, "ei": 71}, {"es": 101, "ei": 76}, {"es": 117, "ei": 88}, {"es": 125, "ei": 93}, {"es": 139, "ei": 103}, {"es": 153, "ei": 113}]}, "preferred_fits": [{"id": "H11/c11", "hole": "H11", "shaft": "c11", "type": "clearance", "name_id": "Longgar (loose running)", "use": "Toleransi kasar, assembly longgar"}, {"id": "H9/d9", "hole": "H9", "shaft": "d9", "type": "clearance", "name_id": "Free running", "use": "Kecepatan tinggi / suhu berubah"}, {"id": "H8/f7", "hole": "H8", "shaft": "f7", "type": "clearance", "name_id": "Close running", "use": "Poros berputar, bearing plain"}, {"id": "H7/g6", "hole": "H7", "shaft": "g6", "type": "clearance", "name_id": "Sliding", "use": "Geser presisi, pin, bushing"}, {"id": "H7/h6", "hole": "H7", "shaft": "h6", "type": "clearance", "name_id": "Location clearance", "use": "Lokasi akurat, mudah dibongkar"}, {"id": "H7/k6", "hole": "H7", "shaft": "k6", "type": "transition", "name_id": "Transition (ringan)", "use": "Lokasi akurat, pukul ringan"}, {"id": "H7/n6", "hole": "H7", "shaft": "n6", "type": "transition", "name_id": "Transition (lebih ketat)", "use": "Lokasi tetap, press ringan"}, {"id": "H7/p6", "hole": "H7", "shaft": "p6", "type": "interference", "name_id": "Press fit", "use": "Bushing, ring bearing permanen"}, {"id": "H7/s6", "hole": "H7", "shaft": "s6", "type": "interference", "name_id": "Heavy press / shrink", "use": "Beban tinggi, shrink fit"}], "iso_2768_1_linear": {"unit": "mm", "classes": ["f", "m", "c", "v"], "ranges": [{"min": 0.5, "max": 3, "f": 0.05, "m": 0.1, "c": 0.2, "v": null}, {"min": 3, "max": 6, "f": 0.05, "m": 0.1, "c": 0.3, "v": 0.5}, {"min": 6, "max": 30, "f": 0.1, "m": 0.2, "c": 0.5, "v": 1.0}, {"min": 30, "max": 120, "f": 0.15, "m": 0.3, "c": 0.8, "v": 1.5}, {"min": 120, "max": 400, "f": 0.2, "m": 0.5, "c": 1.2, "v": 2.5}, {"min": 400, "max": 1000, "f": 0.3, "m": 0.8, "c": 2.0, "v": 4.0}, {"min": 1000, "max": 2000, "f": 0.5, "m": 1.2, "c": 3.0, "v": 6.0}, {"min": 2000, "max": 4000, "f": null, "m": 2.0, "c": 4.0, "v": 8.0}]}, "iso_2768_2": {"straightness_flatness": [{"min": 0, "max": 10, "H": 0.02, "K": 0.05, "L": 0.1}, {"min": 10, "max": 30, "H": 0.05, "K": 0.1, "L": 0.2}, {"min": 30, "max": 100, "H": 0.1, "K": 0.2, "L": 0.4}, {"min": 100, "max": 300, "H": 0.2, "K": 0.4, "L": 0.8}, {"min": 300, "max": 1000, "H": 0.3, "K": 0.6, "L": 1.2}, {"min": 1000, "max": 3000, "H": 0.4, "K": 0.8, "L": 1.6}], "perpendicularity": [{"min": 0, "max": 100, "H": 0.2, "K": 0.4, "L": 0.6}, {"min": 100, "max": 300, "H": 0.3, "K": 0.6, "L": 1.0}, {"min": 300, "max": 1000, "H": 0.4, "K": 0.8, "L": 1.5}, {"min": 1000, "max": 3000, "H": 0.5, "K": 1.0, "L": 2.0}], "runout": {"H": 0.1, "K": 0.2, "L": 0.5}}};
  </script>
  <script is:inline>
  (function () {
    const S = window.__TOL_SEED__;

    function bandIndex(nom) {
      const bands = S.size_bands;
      for (let i = 0; i < bands.length; i++) {
        if (nom > bands[i].over && nom <= bands[i].to) return i;
        if (i === 0 && nom > 0 && nom <= bands[i].to) return 0;
      }
      if (nom <= 0) return 0;
      return bands.length - 1;
    }

    function fmtUm(u) {
      if (Math.abs(u) >= 1000) return (u / 1000).toFixed(3) + " mm";
      return (Math.round(u * 10) / 10) + " µm";
    }
    function fmtMm(m) {
      return (Math.round(m * 1000) / 1000).toFixed(3) + " mm";
    }

    // tabs
    document.querySelectorAll(".tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab").forEach((b) => b.classList.remove("active"));
        document.querySelectorAll(".panel").forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById("panel-" + btn.dataset.tab)?.classList.add("active");
      });
    });

    // populate selects
    const holeSel = document.getElementById("fit-hole");
    const shaftSel = document.getElementById("fit-shaft");
    const presetSel = document.getElementById("fit-preset");
    Object.keys(S.holes).forEach((h) => {
      const o = document.createElement("option");
      o.value = h; o.textContent = h;
      if (h === "H7") o.selected = true;
      holeSel.appendChild(o);
    });
    Object.keys(S.shafts).forEach((s) => {
      const o = document.createElement("option");
      o.value = s; o.textContent = s;
      if (s === "g6") o.selected = true;
      shaftSel.appendChild(o);
    });
    S.preferred_fits.forEach((f) => {
      const o = document.createElement("option");
      o.value = f.id;
      o.textContent = f.id + " — " + f.name_id;
      presetSel.appendChild(o);
    });
    presetSel.addEventListener("change", () => {
      const f = S.preferred_fits.find((x) => x.id === presetSel.value);
      if (f) {
        holeSel.value = f.hole;
        shaftSel.value = f.shaft;
      }
    });

    function calcFit() {
      const nom = parseFloat(document.getElementById("fit-nom").value);
      const hole = holeSel.value;
      const shaft = shaftSel.value;
      const box = document.getElementById("fit-result");
      if (!isFinite(nom) || nom <= 0) {
        box.hidden = false;
        box.innerHTML = "<p class='err'>Masukkan diameter nominal valid.</p>";
        return;
      }
      const i = bandIndex(nom);
      const H = S.holes[hole]?.[i];
      const Sh = S.shafts[shaft]?.[i];
      if (!H || !Sh) {
        box.hidden = false;
        box.innerHTML = "<p class='err'>Kombinasi / ukuran di luar data seed.</p>";
        return;
      }
      const holeMax = nom + H.ES / 1000;
      const holeMin = nom + H.EI / 1000;
      const shaftMax = nom + Sh.es / 1000;
      const shaftMin = nom + Sh.ei / 1000;
      const maxClear = holeMax - shaftMin;
      const minClear = holeMin - shaftMax;
      let fitType, fitLabel;
      if (minClear > 0) {
        fitType = "clearance";
        fitLabel = "Clearance fit (selalu longgar)";
      } else if (maxClear < 0) {
        fitType = "interference";
        fitLabel = "Interference fit (selalu press)";
      } else {
        fitType = "transition";
        fitLabel = "Transition fit (bisa longgar atau press)";
      }
      const preset = S.preferred_fits.find((f) => f.hole === hole && f.shaft === shaft);
      box.hidden = false;
      box.innerHTML = `
        <div class="rtype ${fitType}">${fitLabel}</div>
        ${preset ? `<p class="use"><strong>${preset.id}</strong> — ${preset.use}</p>` : ""}
        <div class="rgrid">
          <div class="rblock">
            <div class="rblock-h">Hole ${hole}</div>
            <div class="rrow"><span>Min</span><b>${fmtMm(holeMin)}</b></div>
            <div class="rrow"><span>Max</span><b>${fmtMm(holeMax)}</b></div>
          </div>
          <div class="rblock">
            <div class="rblock-h">Shaft ${shaft}</div>
            <div class="rrow"><span>Min</span><b>${fmtMm(shaftMin)}</b></div>
            <div class="rrow"><span>Max</span><b>${fmtMm(shaftMax)}</b></div>
          </div>
        </div>
        <div class="rlist">
          <div class="rrow"><span>Max clearance</span><b>${fmtMm(maxClear)}</b></div>
          <div class="rrow"><span>Min clearance</span><b>${fmtMm(minClear)}</b></div>
          <div class="rrow"><span>Band ISO</span><b>${S.size_bands[i].over}–${S.size_bands[i].to} mm</b></div>
        </div>
      `;
    }

    function calcIT() {
      const nom = parseFloat(document.getElementById("it-nom").value);
      const grade = document.getElementById("it-grade").value;
      const box = document.getElementById("it-result");
      const i = bandIndex(nom);
      const um = S.IT[grade]?.[i];
      if (!isFinite(nom) || um == null) {
        box.hidden = false;
        box.innerHTML = "<p class='err'>Data tidak tersedia.</p>";
        return;
      }
      box.hidden = false;
      box.innerHTML = `
        <div class="rlist">
          <div class="rrow"><span>Grade</span><b>${grade}</b></div>
          <div class="rrow"><span>Nominal</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Band</span><b>${S.size_bands[i].over}–${S.size_bands[i].to} mm</b></div>
          <div class="rrow"><span>Lebar IT</span><b>${um} µm (${fmtMm(um / 1000)})</b></div>
        </div>
        <p class="hint">IT = lebar zona saja. Batas atas/bawah: tab Fits.</p>
      `;
    }

    function calcG() {
      const nom = parseFloat(document.getElementById("g-nom").value);
      const cls = document.getElementById("g-class").value;
      const box = document.getElementById("g-result");
      const rows = S.iso_2768_1_linear.ranges;
      let row = null;
      for (const r of rows) {
        if (nom > r.min - 1e-9 && nom <= r.max) { row = r; break; }
        if (r.min === 0.5 && nom >= 0.5 && nom <= r.max) { row = r; break; }
      }
      if (nom >= 0.5 && nom <= 3) row = rows[0];
      const val = row ? row[cls] : null;
      box.hidden = false;
      if (val == null) {
        box.innerHTML = "<p class='err'>Kelas tidak berlaku untuk rentang ukuran ini (atau &lt; 0.5 mm — toleransi individu).</p>";
        return;
      }
      box.innerHTML = `
        <div class="rlist">
          <div class="rrow"><span>Kelas</span><b>ISO 2768-${cls}</b></div>
          <div class="rrow"><span>Nominal</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Deviasi</span><b>± ${val} mm</b></div>
          <div class="rrow"><span>Batas bawah</span><b>${fmtMm(nom - val)}</b></div>
          <div class="rrow"><span>Batas atas</span><b>${fmtMm(nom + val)}</b></div>
        </div>
      `;
    }

    function calcGeo() {
      const nom = parseFloat(document.getElementById("geo-nom").value);
      const cls = document.getElementById("geo-class").value;
      const box = document.getElementById("geo-result");
      const rows = S.iso_2768_2.straightness_flatness;
      let row = rows.find((r) => nom > r.min - 1e-9 && nom <= r.max) || rows[rows.length - 1];
      if (nom <= 10) row = rows[0];
      const val = row[cls];
      const perpRows = S.iso_2768_2.perpendicularity;
      let pr = perpRows.find((r) => nom > r.min - 1e-9 && nom <= r.max) || perpRows[perpRows.length - 1];
      if (nom <= 100) pr = perpRows[0];
      const run = S.iso_2768_2.runout[cls];
      box.hidden = false;
      box.innerHTML = `
        <div class="rlist">
          <div class="rrow"><span>Kelas</span><b>${cls}</b></div>
          <div class="rrow"><span>Panjang</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Straightness / Flatness</span><b>${val} mm</b></div>
          <div class="rrow"><span>Perpendicularity</span><b>${pr[cls]} mm</b></div>
          <div class="rrow"><span>Run-out</span><b>${run} mm</b></div>
        </div>
      `;
    }

    document.getElementById("btn-fit")?.addEventListener("click", calcFit);
    document.getElementById("btn-it")?.addEventListener("click", calcIT);
    document.getElementById("btn-g")?.addEventListener("click", calcG);
    document.getElementById("btn-geo")?.addEventListener("click", calcGeo);
    // auto first calc
    calcFit();
  })();
  </script>

