, "search_rank": 5, "keywords": ["GPS", "linear size", "envelope", "two-point size", "ukuran linear"], "summary_en": "Defines how linear size (holes, shafts, widths) is interpreted and verified under GPS.", "summary_id": "Mendefinisikan cara interpretasi dan verifikasi ukuran linear (lubang, poros, lebar) dalam sistem GPS.", "when_to_use": "When drawing must clarify two-point vs envelope size definition", "related": ["ISO 286", "ISO 1101"]}, {"id": "iso-22081", "code": "ISO 22081:2021", "title_en": "Geometrical tolerancing — General geometrical specifications and general size specifications", "title_id": "Toleransi geometris — Spesifikasi geometris umum dan ukuran umum", "category": "general", "search_rank": 6, "keywords": ["22081", "general geometrical", "replaces 2768-2"], "summary_en": "Modern GPS default geometrical specifications; replaces ISO 2768-2 on new drawings.", "summary_id": "Spesifikasi geometris default GPS modern; menggantikan ISO 2768-2 pada gambar baru.", "when_to_use": "New drawings preferring current GPS defaults over ISO 2768-2", "related": ["ISO 2768", "ISO 1101"]}, {"id": "iso-13920", "code": "ISO 13920", "title_en": "Welding — General tolerances for welded constructions", "title_id": "Pengelasan — Toleransi umum konstruksi las", "category": "welding", "search_rank": 7, "keywords": ["welding", "las", "weld tolerance", "ISO 13920"], "summary_en": "General tolerances for lengths, angles, shape and position of welded constructions.", "summary_id": "Toleransi umum panjang, sudut, bentuk dan posisi pada konstruksi las.", "when_to_use": "Welded frames, structures, fabrications", "related": ["ISO 2768", "ISO 5817"]}, {"id": "iso-965", "code": "ISO 965", "title_en": "ISO general purpose metric screw threads — Tolerances", "title_id": "Ulir metrik tujuan umum ISO — Toleransi", "category": "threads", "search_rank": 8, "keywords": ["thread", "ulir", "6g", "6H", "metric screw", "baut"], "summary_en": "Tolerance classes for metric screw threads (e.g. 6g ex