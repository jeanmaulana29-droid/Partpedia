---
import Layout from "../../../layouts/Layout.astro";
---
<Layout
  title="ISO Tolerance Library & Calculator — ISO 286, 2768, 1101, 21920 | Partpedia"
  description="Industrial ISO tolerance library: ISO 286 fits (H7/g6), ISO 2768 general tolerances (mK), ISO 1101 GD&T, surface roughness Ra, IT grades. Calculate limits & fits plus reference tables for engineers."
>
  <div class="tol-page">
    <a class="back" href="/">← Beranda</a>

    <header class="tol-hero">
      <div class="tol-badge">ISO LIBRARY · CALCULATOR</div>
      <h1>ISO Tolerance Library</h1>
      <p class="tol-lead">
        Standar toleransi industri yang paling dicari teknisi:
        <strong>ISO 286</strong> fits, <strong>ISO 2768</strong> general,
        <strong>ISO 1101</strong> GD&amp;T, <strong>ISO 21920</strong> roughness —
        plus kalkulator limits &amp; fits.
      </p>
    </header>

    <div class="tabs" role="tablist">
      <button type="button" class="tab active" data-tab="lib">Library ISO</button>
      <button type="button" class="tab" data-tab="fits">ISO 286 · Fits</button>
      <button type="button" class="tab" data-tab="it">IT Grade</button>
      <button type="button" class="tab" data-tab="g2768">ISO 2768</button>
    </div>

    <!-- LIBRARY -->
    <section class="panel active" id="panel-lib">
      <div class="card">
        <h2>Standar paling dicari</h2>
        <p class="hint">Cari nama standar, kode fit, atau kata kunci (EN/ID).</p>
        <input type="search" id="lib-search" placeholder="Contoh: H7/g6, 2768, GD&T, Ra, kerataan…" autocomplete="off" />
        <div id="lib-list" class="lib-list"></div>
      </div>
      <div class="card" style="margin-top:1rem">
        <h2>Preferred fits (ISO 286)</h2>
        <div id="fits-guide" class="table-wrap"></div>
      </div>
      <div class="card" style="margin-top:1rem">
        <h2>GD&amp;T symbols (ISO 1101)</h2>
        <div id="gdt-list" class="chip-wrap"></div>
      </div>
      <div class="card" style="margin-top:1rem">
        <h2>Surface roughness — typical Ra</h2>
        <div id="ra-list" class="table-wrap"></div>
      </div>
      <div class="card" style="margin-top:1rem">
        <h2>IT grade guide</h2>
        <div id="it-guide" class="table-wrap"></div>
      </div>
      <p class="hier" id="hier-note"></p>
    </section>

    <!-- FITS -->
    <section class="panel" id="panel-fits">
      <div class="card">
        <h2>Limits &amp; Fits (poros–lubang)</h2>
        <p class="hint">Pilih fit populer atau custom hole/shaft. Nominal dalam mm.</p>
        <div class="grid2">
          <label>Diameter nominal (mm)
            <input type="number" id="fit-nom" value="25" min="0.1" max="500" step="0.1" />
          </label>
          <label>Fit cepat
            <select id="fit-preset"><option value="">— pilih —</option></select>
          </label>
          <label>Hole
            <select id="fit-hole"></select>
          </label>
          <label>Shaft
            <select id="fit-shaft"></select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-fit">Hitung</button>
        <div class="result" id="fit-result" hidden></div>
      </div>
    </section>

    <!-- IT -->
    <section class="panel" id="panel-it">
      <div class="card">
        <h2>Lebar toleransi IT (ISO 286)</h2>
        <div class="grid2">
          <label>Ukuran nominal (mm)
            <input type="number" id="it-nom" value="50" min="0.1" max="500" step="0.1" />
          </label>
          <label>Grade
            <select id="it-grade">
              <option>IT6</option>
              <option selected>IT7</option>
              <option>IT8</option>
              <option>IT9</option>
              <option>IT10</option>
              <option>IT11</option>
              <option>IT12</option>
              <option>IT5</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-it">Hitung</button>
        <div class="result" id="it-result" hidden></div>
      </div>
    </section>

    <!-- 2768 -->
    <section class="panel" id="panel-g2768">
      <div class="card">
        <h2>Toleransi umum ISO 2768-1</h2>
        <div class="grid2">
          <label>Dimensi nominal (mm)
            <input type="number" id="g-nom" value="80" min="0.5" max="4000" step="0.1" />
          </label>
          <label>Kelas
            <select id="g-class">
              <option value="f">f — fine</option>
              <option value="m" selected>m — medium</option>
              <option value="c">c — coarse</option>
              <option value="v">v — very coarse</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-g">Hitung</button>
        <div class="result" id="g-result" hidden></div>
      </div>
      <div class="card" style="margin-top:1rem">
        <h2>ISO 2768-2 · Kerataan / kelurusan</h2>
        <div class="grid2">
          <label>Panjang nominal (mm)
            <input type="number" id="geo-nom" value="100" min="1" max="3000" step="1" />
          </label>
          <label>Kelas geo
            <select id="geo-class">
              <option>H</option>
              <option selected>K</option>
              <option>L</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-geo">Hitung</button>
        <div class="result" id="geo-result" hidden></div>
      </div>
    </section>

    <p class="disc">
      Acuan: tabel industri ISO 286, ISO 2768, ISO 1101, ISO 21920 (sumber publik).
      Bukan salinan dokumen resmi berbayar. Untuk aplikasi kritis, verifikasi ke ISO / SNI resmi.
    </p>
  </div>

