---
import Layout from "../../../layouts/Layout.astro";
---
<Layout
  title="ISO Tolerance Calculator & Reference — 286, 2768, IT, GD&T | Partpedia"
  description="Kalkulator toleransi ISO dengan angka: fits H7/g6, IT µm, 2768 ±mm, sudut, chamfer, Ra. Plus daftar standar dan simbol GD&T."
>
  <div class="tol-page">
    <a class="back" href="/">← Beranda</a>
    <header class="tol-hero">
      <div class="tol-badge">ISO · KALKULATOR + REFERENSI</div>
      <h1>Toleransi ISO</h1>
      <p class="tol-lead">Hitung angka (µm / mm) · daftar standar · simbol GD&amp;T — siap pakai di lantai produksi.</p>
    </header>

    <div class="search-box">
      <input type="search" id="q" placeholder="25 H7/g6 · IT7 50 · 2768 m 100 · sudut · Ra · GD&T…" autocomplete="off" />
      <div id="suggest" class="suggest" hidden></div>
    </div>

    <div class="quick">
      <button type="button" class="qchip" data-q="25 H7/g6">25 H7/g6</button>
      <button type="button" class="qchip" data-q="30 H7/p6">30 H7/p6</button>
      <button type="button" class="qchip" data-q="IT7 50">IT7 · 50</button>
      <button type="button" class="qchip" data-q="2768 m 100">2768-m · 100</button>
      <button type="button" class="qchip" data-q="sudut 80 m">Sudut</button>
      <button type="button" class="qchip" data-q="chamfer 4 m">Chamfer</button>
      <button type="button" class="qchip" data-tab="ra">Ra</button>
      <button type="button" class="qchip" data-tab="ref">Standar</button>
    </div>

    <div class="tabs">
      <button type="button" class="tab active" data-tab="fits">Fits 286</button>
      <button type="button" class="tab" data-tab="it">IT µm</button>
      <button type="button" class="tab" data-tab="g2768">2768 ±</button>
      <button type="button" class="tab" data-tab="geo">Geo</button>
      <button type="button" class="tab" data-tab="angle">Sudut</button>
      <button type="button" class="tab" data-tab="chamfer">Chamfer</button>
      <button type="button" class="tab" data-tab="ra">Ra</button>
      <button type="button" class="tab" data-tab="ref">Standar</button>
    </div>

    <!-- FITS -->
    <section class="panel active" id="panel-fits">
      <div class="card">
        <div class="grid2">
          <label>Ø nominal (mm)<input type="number" id="fit-nom" value="25" min="0.1" max="500" step="0.1" /></label>
          <label>Fit cepat<select id="fit-preset"><option value="">— pilih —</option></select></label>
          <label>Hole<select id="fit-hole"></select></label>
          <label>Shaft<select id="fit-shaft"></select></label>
        </div>
        <button type="button" class="btn-go" id="btn-fit">Hitung angka</button>
        <div class="result" id="fit-result" hidden></div>
      </div>
    </section>

    <!-- IT -->
    <section class="panel" id="panel-it">
      <div class="card">
        <div class="grid2">
          <label>Ø nominal (mm)<input type="number" id="it-nom" value="50" min="0.1" max="500" step="0.1" /></label>
          <label>Grade
            <select id="it-grade">
              <option>IT5</option><option>IT6</option><option selected>IT7</option>
              <option>IT8</option><option>IT9</option><option>IT10</option>
              <option>IT11</option><option>IT12</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-it">Hitung µm</button>
        <div class="result" id="it-result" hidden></div>
        <div id="it-guide" class="mini-list"></div>
      </div>
    </section>

    <!-- 2768 linear -->
    <section class="panel" id="panel-g2768">
      <div class="card">
        <div class="grid2">
          <label>Dimensi (mm)<input type="number" id="g-nom" value="80" min="0.5" max="4000" step="0.1" /></label>
          <label>Kelas
            <select id="g-class">
              <option value="f">f fine</option>
              <option value="m" selected>m medium</option>
              <option value="c">c coarse</option>
              <option value="v">v very coarse</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-g">Hitung ± mm</button>
        <div class="result" id="g-result" hidden></div>
      </div>
    </section>

    <!-- GEO -->
    <section class="panel" id="panel-geo">
      <div class="card">
        <div class="grid2">
          <label>Panjang (mm)<input type="number" id="geo-nom" value="100" min="1" max="3000" step="1" /></label>
          <label>Kelas<select id="geo-class"><option>H</option><option selected>K</option><option>L</option></select></label>
        </div>
        <button type="button" class="btn-go" id="btn-geo">Hitung mm</button>
        <div class="result" id="geo-result" hidden></div>
      </div>
    </section>

    <!-- ANGLE -->
    <section class="panel" id="panel-angle">
      <div class="card">
        <p class="hint">ISO 2768-1 — deviasi sudut (sisi lebih pendek dari sudut).</p>
        <div class="grid2">
          <label>Sisi pendek (mm)<input type="number" id="ang-side" value="40" min="1" max="5000" step="1" /></label>
          <label>Kelas
            <select id="ang-class">
              <option value="f_m">f / m</option>
              <option value="c">c</option>
              <option value="v">v</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-ang">Hitung sudut</button>
        <div class="result" id="ang-result" hidden></div>
      </div>
    </section>

    <!-- CHAMFER -->
    <section class="panel" id="panel-chamfer">
      <div class="card">
        <p class="hint">ISO 2768-1 — jari-jari luar & tinggi chamfer (broken edges).</p>
        <div class="grid2">
          <label>Ukuran nominal (mm)<input type="number" id="ch-nom" value="3" min="0.5" max="50" step="0.1" /></label>
          <label>Kelas
            <select id="ch-class">
              <option value="f_m">f / m</option>
              <option value="c_v">c / v</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-ch">Hitung ± mm</button>
        <div class="result" id="ch-result" hidden></div>
      </div>
    </section>

    <!-- RA list -->
    <section class="panel" id="panel-ra">
      <div class="card">
        <p class="hint">Ra tipikal (µm) per proses — acuan industri (ISO 21920 / praktik).</p>
        <div id="ra-table" class="table-wrap"></div>
      </div>
    </section>

    <!-- REFERENCE lists -->
    <section class="panel" id="panel-ref">
      <div class="card">
        <h2 class="h2">Standar (daftar)</h2>
        <div id="cat-list" class="std-list"></div>
      </div>
      <div class="card" style="margin-top:.75rem">
        <h2 class="h2">Simbol GD&amp;T (ISO 1101)</h2>
        <div id="gdt-list" class="chip-wrap"></div>
      </div>
      <div class="card" style="margin-top:.75rem">
        <h2 class="h2">Preferred fits</h2>
        <div id="fits-list" class="table-wrap"></div>
      </div>
      <p class="hier" id="hier"></p>
    </section>

    <p class="disc">Angka dari tabel industri ISO 286 / 2768 / praktik kekasaran. Bukan salinan dokumen resmi berbayar. Aplikasi kritis: verifikasi ISO/SNI.</p>
  </div>

