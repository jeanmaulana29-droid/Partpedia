ax": 3000, "H": 0.4, "K": 0.8, "L": 1.6}], "perpendicularity": [{"min": 0, "max": 100, "H": 0.2, "K": 0.4, "L": 0.6}, {"min": 100, "max": 300, "H": 0.3, "K": 0.6, "L": 1.0}, {"min": 300, "max": 1000, "H": 0.4, "K": 0.8, "L": 1.5}, {"min": 1000, "max": 3000, "H": 0.5, "K": 1.0, "L": 2.0}], "symmetry": [{"min": 0, "max": 100, "H": 0.5, "K": 0.5, "L": 0.5}, {"min": 100, "max": 300, "H": 0.5, "K": 0.5, "L": 1.0}, {"min": 300, "max": 1000, "H": 0.5, "K": 1.0, "L": 1.5}, {"min": 1000, "max": 3000, "H": 0.5, "K": 1.0, "L": 2.0}], "runout": {"H": 0.1, "K": 0.2, "L": 0.5}}, "common_callouts": [{"code": "ISO 2768-mK", "use_en": "Most common general CNC / sheet-metal default", "use_id": "Default CNC/sheet metal paling umum"}, {"code": "ISO 2768-fH", "use_en": "Fine precision parts, instruments", "use_id": "Part presisi halus, instrumen"}, {"code": "ISO 2768-cL", "use_en": "Coarse structural / non-critical", "use_id": "Struktural kasar / non-kritis"}, {"code": "ISO 2768-m", "use_en": "Linear only (no geometry class stated)", "use_id": "Hanya linear (tanpa kelas geometri)"}], "preferred_fits_guide": [{"id": "H11/c11", "type": "clearance", "name_en": "Loose running", "name_id": "Longgar", "use": "Rough assembly, agricultural, large clearance"}, {"id": "H9/d9", "type": "clearance", "name_en": "Free running", "name_id": "Free running", "use": "High speed, temperature variation, dirty environments"}, {"id": "H8/f7", "type": "clearance", "name_en": "Close running", "name_id": "Close running", "use": "Journal bearings, moderate speed shafts"}, {"id": "H7/g6", "type": "clearance", "name_en": "Sliding", "name_id": "Geser presisi", "use": "Sliding pins, guide bushings, accurate location with motion"}, {"id": "H7/h6", "type": "clearance", "name_en": "Locational clearance", "name_id": "Lokasi clearance", "use": "Accurate location, easy assembly/disassembly"}, {"id": "H7/k6", "type": "transition", "name_en": "Transition (light)", "name_id": "Transisi ringan", "use": "Accurate location, light keying, couplings"}, {"id": "H7/n6", "type": "transition", "name_en": "Transition (tighter)", "name_id": "Transisi ketat", "use": "More accurate location, light press"}, {"id": "H7/p6", "type": "interference", "name_en": "Press fit", "name_id": "Press fit", "use": "Bushings in housings, permanent location"}, {"id": "H7/s6", "type": "interference", "name_en": "Heavy press / shrink", "name_id": "Press berat / shrink", "use": "High load hubs, shrink fits"}], "it_grade_guide": {"note": "Smaller IT number = tighter tolerance. Typical machining ranges.", "grades": [{"grade": "IT5–IT6", "typical": "Fine grinding, honing, precision fits"}, {"grade": "IT7–IT8", "typical": "General precision machining, reaming, H7 holes"}, {"grade": "IT9–IT10", "typical": "Turning, milling general purpose"}, {"grade": "IT11–IT12", "typical": "Drilling, rough machining"}, {"grade": "IT13–IT16", "typical": "Casting, fabrication, coarse processes"}]}, "gdt_symbols": [{"name_en": "Straightness", "name_id": "Kelurusan", "group": "form"}, {"name_en": "Flatness", "name_id": "Kerataan", "group": "form"}, {"name_en": "Circularity (Roundness)", "name_id": "Kebulatan", "group": "form"}, {"name_en": "Cylindricity", "name_id": "Kesilindrisan", "group": "form"}, {"name_en": "Profile of a line", "name_id": "Profil garis", "group": "profile"}, {"name_en": "Profile of a surface", "name_id": "Profil permukaan", "group": "profile"}, {"name_en": "Perpendicularity", "name_id": "Ketegaklurusan", "group": "orientation"}, {"name_en": "Angularity", "name_id": "Kesudutan", "group": "orientation"}, {"name_en": "Parallelism", "name_id": "Kesejajaran", "group": "orientation"}, {"name_en": "Position", "name_id": "Posisi", "group": "location"}, {"name_en": "Concentricity", "name_id": "Konsentrisitas", "group": "location"}, {"name_en": "Symmetry", "name_id": "Simetri", "group": "location"}, {"name_en": "Circular run-out", "name_id": "Run-out melingkar", "group": "runout"}, {"name_en": "Total run-out", "name_id": "Run-out total", "group": "runout"}], "surface_roughness_typical_ra_um": [{"process": "Lapping / superfinishing", "ra_typical": "0.025–0.1"}, {"process": "Grinding (fine)", "ra_typical": "0.1–0.4"}, {"process": "Grinding (commercial)", "ra_typical": "0.4–0.8"}, {"process": "Turning / milling (fine)", "ra_typical": "0.8–1.6"}, {"process": "Turning / milling (general)", "ra_typical": "1.6–3.2"}, {"process": "Drilling / rough machining", "ra_typical": "3.2–12.5"}, {"process": "Casting / flame cut (rough)", "ra_typical": "12.5–50"}], "hierarchy_note": {"en": "On a drawing: explicit individual tolerance > fit code (ISO 286) > GD&T feature control (ISO 1101) > general note (ISO 2768 / ISO 22081).", "id": "Di gambar: toleransi individu eksplisit > kode fit (ISO 286) > GD&T (ISO 1101) > catatan umum (ISO 2768 / ISO 22081)."}};
  </script>
  <script is:inline>
  (function () {
    const S = window.__TOL_SEED__;
    const L = window.__ISO_LIB__;

    function bandIndex(nom) {
      const bands = S.size_bands || [];
      for (let i = 0; i < bands.length; i++) {
        if (nom > bands[i].over && nom <= bands[i].to) return i;
        if (i === 0 && nom > 0 && nom <= bands[i].to) return 0;
      }
      if (nom <= 0) return 0;
      return Math.max(0, bands.length - 1);
    }
    function fmtUm(u) {
      if (Math.abs(u) >= 1000) return (u / 1000).toFixed(3) + " mm";
      return (Math.round(u * 10) / 10) + " µm";
    }
    function fmtMm(m) {
      return (Math.round(m * 1000) / 1000).toFixed(3) + " mm";
    }

    // tabs
    document.querySelectorAll(".tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tab").forEach((b) => b.classList.remove("active"));
        document.querySelectorAll(".panel").forEach((p) => p.classList.remove("active"));
        btn.classList.add("active");
        document.getElementById("panel-" + btn.dataset.tab)?.classList.add("active");
      });
    });

    // ---- LIBRARY RENDER ----
    function renderLib(filter) {
      const q = (filter || "").toLowerCase().trim();
      const terms = q ? q.split(/\s+/).filter(Boolean) : [];
      const box = document.getElementById("lib-list");
      if (!box || !L.catalog) return;
      const items = L.catalog
        .slice()
        .sort((a, b) => a.search_rank - b.search_rank)
        .filter((c) => {
          if (!terms.length) return true;
          const hay = [c.code, c.title_en, c.title_id, c.summary_en, c.summary_id, ...(c.keywords || [])]
            .join(" ")
            .toLowerCase();
          return terms.every((t) => hay.includes(t));
        });
      box.innerHTML = items.map((c) => `
        <article class="lib-item">
          <div class="lib-code">${c.code}</div>
          <h3>${c.title_en}</h3>
          <p class="lib-id">${c.title_id}</p>
          <p class="lib-sum">${c.summary_en}</p>
          <p class="lib-use"><strong>Use:</strong> ${c.when_to_use}</p>
          ${c.note ? `<p class="lib-note">${c.note}</p>` : ""}
        </article>
      `).join("") || `<p class="hint">Tidak ada standar yang cocok.</p>`;
    }
    renderLib("");
    document.getElementById("lib-search")?.addEventListener("input", (e) => renderLib(e.target.value));

    // fits guide table
    const fg = document.getElementById("fits-guide");
    if (fg && L.preferred_fits_guide) {
      fg.innerHTML = `<table class="rt"><thead><tr><th>Fit</th><th>Type</th><th>Use</th></tr></thead><tbody>` +
        L.preferred_fits_guide.map((f) =>
          `<tr><td><strong>${f.id}</strong></td><td>${f.type}</td><td>${f.name_en} — ${f.use}</td></tr>`
        ).join("") + `</tbody></table>`;
    }

    // gdt chips
    const gd = document.getElementById("gdt-list");
    if (gd && L.gdt_symbols) {
      gd.innerHTML = L.gdt_symbols.map((g) =>
        `<span class="chip"><b>${g.name_en}</b><small>${g.name_id}</small></span>`
      ).join("");
    }

    // ra table
    const ra = document.getElementById("ra-list");
    if (ra && L.surface_roughness_typical_ra_um) {
      ra.innerHTML = `<table class="rt"><thead><tr><th>Process</th><th>Ra typical (µm)</th></tr></thead><tbody>` +
        L.surface_roughness_typical_ra_um.map((r) =>
          `<tr><td>${r.process}</td><td>${r.ra_typical}</td></tr>`
        ).join("") + `</tbody></table>`;
    }

    // it guide
    const ig = document.getElementById("it-guide");
    if (ig && L.it_grade_guide) {
      ig.innerHTML = `<table class="rt"><thead><tr><th>IT grade</th><th>Typical process</th></tr></thead><tbody>` +
        L.it_grade_guide.grades.map((g) =>
          `<tr><td><strong>${g.grade}</strong></td><td>${g.typical}</td></tr>`
        ).join("") + `</tbody></table>`;
    }

    const hn = document.getElementById("hier-note");
    if (hn && L.hierarchy_note) {
      hn.innerHTML = `<strong>Hierarchy:</strong> ${L.hierarchy_note.en}<br/><span style="opacity:.85">${L.hierarchy_note.id}</span>`;
    }

    // ---- CALCULATOR (same as before) ----
    const holeSel = document.getElementById("fit-hole");
    const shaftSel = document.getElementById("fit-shaft");
    const presetSel = document.getElementById("fit-preset");
    if (S.holes) {
      Object.keys(S.holes).forEach((h) => {
        const o = document.createElement("option");
        o.value = h; o.textContent = h;
        if (h === "H7") o.selected = true;
        holeSel.appendChild(o);
      });
    }
    if (S.shafts) {
      Object.keys(S.shafts).forEach((s) => {
        const o = document.createElement("option");
        o.value = s; o.textContent = s;
        if (s === "g6") o.selected = true;
        shaftSel.appendChild(o);
      });
    }
    (S.preferred_fits || []).forEach((f) => {
      const o = document.createElement("option");
      o.value = f.id;
      o.textContent = f.id + " — " + f.name_id;
      presetSel.appendChild(o);
    });
    presetSel?.addEventListener("change", () => {
      const f = (S.preferred_fits || []).find((x) => x.id === presetSel.value);
      if (f) { holeSel.value = f.hole; shaftSel.value = f.shaft; }
    });

    function calcFit() {
      const nom = parseFloat(document.getElementById("fit-nom").value);
      const hole = holeSel.value;
      const shaft = shaftSel.value;
      const box = document.getElementById("fit-result");
      if (!isFinite(nom) || nom <= 0) {
        box.hidden = false;
        box.innerHTML = "<p class='err'>Masukkan diameter nominal valid.</p>";
        return;
      }
      const i = bandIndex(nom);
      const H = S.holes?.[hole]?.[i];
      const Sh = S.shafts?.[shaft]?.[i];
      if (!H || !Sh) {
        box.hidden = false;
        box.innerHTML = "<p class='err'>Kombinasi / ukuran di luar data seed.</p>";
        return;
      }
      const holeMax = nom + H.ES / 1000;
      const holeMin = nom + H.EI / 1000;
      const shaftMax = nom + Sh.es / 1000;
      const shaftMin = nom + Sh.ei / 1000;
      const maxClear = holeMax - shaftMin;
      const minClear = holeMin - shaftMax;
      let fitType, fitLabel;
      if (minClear > 0) { fitType = "clearance"; fitLabel = "Clearance fit (selalu longgar)"; }
      else if (maxClear < 0) { fitType = "interference"; fitLabel = "Interference fit (selalu press)"; }
      else { fitType = "transition"; fitLabel = "Transition fit (bisa longgar atau press)"; }
      const preset = (S.preferred_fits || []).find((f) => f.hole === hole && f.shaft === shaft);
      box.hidden = false;
      box.innerHTML = `
        <div class="rtype ${fitType}">${fitLabel}</div>
        ${preset ? `<p class="use"><strong>${preset.id}</strong> — ${preset.use}</p>` : ""}
        <div class="rgrid">
          <div class="rblock">
            <div class="rblock-h">Hole ${hole}</div>
            <div class="rrow"><span>Min</span><b>${fmtMm(holeMin)}</b></div>
            <div class="rrow"><span>Max</span><b>${fmtMm(holeMax)}</b></div>
          </div>
          <div class="rblock">
            <div class="rblock-h">Shaft ${shaft}</div>
            <div class="rrow"><span>Min</span><b>${fmtMm(shaftMin)}</b></div>
            <div class="rrow"><span>Max</span><b>${fmtMm(shaftMax)}</b></div>
          </div>
        </div>
        <div class="rlist">
          <div class="rrow"><span>Max clearance</span><b>${fmtMm(maxClear)}</b></div>
          <div class="rrow"><span>Min clearance</span><b>${fmtMm(minClear)}</b></div>
          <div class="rrow"><span>Band ISO</span><b>${S.size_bands[i].over}–${S.size_bands[i].to} mm</b></div>
        </div>`;
    }

    function calcIT() {
      const nom = parseFloat(document.getElementById("it-nom").value);
      const grade = document.getElementById("it-grade").value;
      const box = document.getElementById("it-result");
      const i = bandIndex(nom);
      const um = S.IT?.[grade]?.[i];
      box.hidden = false;
      if (!isFinite(nom) || um == null) {
        box.innerHTML = "<p class='err'>Data tidak tersedia.</p>";
        return;
      }
      box.innerHTML = `
        <div class="rlist">
          <div class="rrow"><span>Grade</span><b>${grade}</b></div>
          <div class="rrow"><span>Nominal</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Band</span><b>${S.size_bands[i].over}–${S.size_bands[i].to} mm</b></div>
          <div class="rrow"><span>Lebar IT</span><b>${um} µm (${fmtMm(um / 1000)})</b></div>
        </div>
        <p class="hint">IT = lebar zona saja. Batas atas/bawah: tab Fits.</p>`;
    }

    function calcG() {
      const nom = parseFloat(document.getElementById("g-nom").value);
      const cls = document.getElementById("g-class").value;
      const box = document.getElementById("g-result");
      const rows = S.iso_2768_1_linear?.ranges || [];
      let row = rows.find((r) => nom > r.min - 1e-9 && nom <= r.max);
      if (nom >= 0.5 && nom <= 3) row = rows[0];
      const val = row ? row[cls] : null;
      box.hidden = false;
      if (val == null) {
        box.innerHTML = "<p class='err'>Kelas tidak berlaku untuk rentang ini.</p>";
        return;
      }
      box.innerHTML = `
        <div class="rlist">
          <div class="rrow"><span>Kelas</span><b>ISO 2768-${cls}</b></div>
          <div class="rrow"><span>Nominal</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Deviasi</span><b>± ${val} mm</b></div>
          <div class="rrow"><span>Batas bawah</span><b>${fmtMm(nom - val)}</b></div>
          <div class="rrow"><span>Batas atas</span><b>${fmtMm(nom + val)}</b></div>
        </div>`;
    }

    function calcGeo() {
      const nom = parseFloat(document.getElementById("geo-nom").value);
      const cls = document.getElementById("geo-class").value;
      const box = document.getElementById("geo-result");
      const rows = S.iso_2768_2?.straightness_flatness || [];
      let row = rows.find((r) => nom > r.min - 1e-9 && nom <= r.max) || rows[rows.length - 1];
      if (nom <= 10) row = rows[0];
      const val = row[cls];
      const perpRows = S.iso_2768_2?.perpendicularity || [];
      let pr = perpRows.find((r) => nom > r.min - 1e-9 && nom <= r.max) || perpRows[perpRows.length - 1];
      if (nom <= 100) pr = perpRows[0];
      const run = S.iso_2768_2?.runout?.[cls];
      box.hidden = false;
      box.innerHTML = `
        <div class="rlist">
          <div class="rrow"><span>Kelas</span><b>${cls}</b></div>
          <div class="rrow"><span>Panjang</span><b>${nom} mm</b></div>
          <div class="rrow"><span>Straightness / Flatness</span><b>${val} mm</b></div>
          <div class="rrow"><span>Perpendicularity</span><b>${pr[cls]} mm</b></div>
          <div class="rrow"><span>Run-out</span><b>${run} mm</b></div>
        </div>`;
    }

    document.getElementById("btn-fit")?.addEventListener("click", calcFit);
    document.getElementById("btn-it")?.addEventListener("click", calcIT);
    document.getElementById("btn-g")?.addEventListener("click", calcG);
    document.getElementById("btn-geo")?.addEventListener("click", calcGeo);
    calcFit();
  })();
  </script>

