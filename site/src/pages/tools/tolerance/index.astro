---
import Layout from "../../../layouts/Layout.astro";
---
<Layout
  title="Kalkulator Toleransi ISO 286 & ISO 2768 — H7/g6, IT Grade | Partpedia"
  description="Hitung toleransi poros-lubang ISO 286 (H7/g6, H7/h6, H7/p6), grade IT, dan toleransi umum ISO 2768. Batas min/max, clearance & interference — untuk teknisi & industri."
>
  <div class="tol-page">
    <a class="back" href="/">← Beranda</a>

    <header class="tol-hero">
      <div class="tol-badge">ISO 286 · ISO 2768</div>
      <h1>Kalkulator Toleransi Industri</h1>
      <p class="tol-lead">
        Hitung <strong>limits &amp; fits</strong> poros–lubang (H7/g6, H7/p6, …),
        lebar grade <strong>IT</strong>, dan toleransi umum <strong>ISO 2768</strong>.
        Hasil: batas min/max, clearance atau interference.
      </p>
    </header>

    <div class="tabs" role="tablist">
      <button type="button" class="tab active" data-tab="fits" id="tab-fits">ISO 286 · Fits</button>
      <button type="button" class="tab" data-tab="it" id="tab-it">IT Grade</button>
      <button type="button" class="tab" data-tab="g2768" id="tab-g2768">ISO 2768</button>
    </div>

    <!-- TAB FITS -->
    <section class="panel active" id="panel-fits">
      <div class="card">
        <h2>Limits &amp; Fits (poros–lubang)</h2>
        <p class="hint">Pilih fit populer atau custom hole/shaft. Nominal dalam mm.</p>
        <div class="grid2">
          <label>Diameter nominal (mm)
            <input type="number" id="fit-nom" value="25" min="0.1" max="500" step="0.1" />
          </label>
          <label>Fit cepat
            <select id="fit-preset">
              <option value="">— pilih —</option>
            </select>
          </label>
          <label>Hole
            <select id="fit-hole"></select>
          </label>
          <label>Shaft
            <select id="fit-shaft"></select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-fit">Hitung</button>
        <div class="result" id="fit-result" hidden></div>
      </div>
      <div class="seo-box">
        <h3>Fit yang sering dicari teknisi</h3>
        <ul>
          <li><strong>H7/g6</strong> — sliding / geser presisi</li>
          <li><strong>H7/h6</strong> — location clearance</li>
          <li><strong>H7/k6</strong> — transition (lokasi akurat)</li>
          <li><strong>H7/p6</strong> — press fit / interference ringan</li>
          <li><strong>H7/s6</strong> — press berat / shrink</li>
          <li><strong>H8/f7</strong> — close running</li>
          <li><strong>H9/d9</strong> — free running</li>
          <li><strong>H11/c11</strong> — loose running</li>
        </ul>
      </div>
    </section>

    <!-- TAB IT -->
    <section class="panel" id="panel-it">
      <div class="card">
        <h2>Lebar toleransi IT (ISO 286)</h2>
        <p class="hint">Masukkan ukuran nominal → dapatkan IT5–IT12 dalam µm dan mm.</p>
        <div class="grid2">
          <label>Ukuran nominal (mm)
            <input type="number" id="it-nom" value="50" min="0.1" max="500" step="0.1" />
          </label>
          <label>Grade
            <select id="it-grade">
              <option>IT6</option>
              <option selected>IT7</option>
              <option>IT8</option>
              <option>IT9</option>
              <option>IT10</option>
              <option>IT11</option>
              <option>IT12</option>
              <option>IT5</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-it">Hitung</button>
        <div class="result" id="it-result" hidden></div>
      </div>
    </section>

    <!-- TAB 2768 -->
    <section class="panel" id="panel-g2768">
      <div class="card">
        <h2>Toleransi umum ISO 2768-1</h2>
        <p class="hint">Untuk dimensi linear tanpa toleransi individu di gambar.</p>
        <div class="grid2">
          <label>Dimensi nominal (mm)
            <input type="number" id="g-nom" value="80" min="0.5" max="4000" step="0.1" />
          </label>
          <label>Kelas
            <select id="g-class">
              <option value="f">f — fine</option>
              <option value="m" selected>m — medium (paling umum)</option>
              <option value="c">c — coarse</option>
              <option value="v">v — very coarse</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-g">Hitung</button>
        <div class="result" id="g-result" hidden></div>
      </div>
      <div class="card" style="margin-top:1rem">
        <h2>ISO 2768-2 · Kerataan / kelurusan</h2>
        <div class="grid2">
          <label>Panjang nominal (mm)
            <input type="number" id="geo-nom" value="100" min="1" max="3000" step="1" />
          </label>
          <label>Kelas geo
            <select id="geo-class">
              <option>H</option>
              <option selected>K</option>
              <option>L</option>
            </select>
          </label>
        </div>
        <button type="button" class="btn-go" id="btn-geo">Hitung</button>
        <div class="result" id="geo-result" hidden></div>
      </div>
    </section>

    <p class="disc">
      Acuan: tabel industri ISO 286-1/2 &amp; ISO 2768-1/2. Bukan salinan dokumen resmi berbayar.
      Untuk aplikasi kritis, verifikasi ke standar ISO / SNI resmi.
    </p>
  </div>

  <script is:inline>
  window.__TOL_SEED__ = {"meta": {"title": "Partpedia Tolerance Seed v2", "version": 2, "disclaimer": "Nilai dari tabel industri yang merujuk ISO 286-1/2 dan ISO 2768-1/2. Bukan salinan dokumen resmi berbayar. Verifikasi ke ISO/SNI untuk aplikasi kritis.", "focus": ["ISO 286 fits (H7/g6 dll)", "ISO 2768 general", "IT grades"]}, "size_bands": [{"over": 0, "to": 3}, {"over": 3, "to": 6}, {"over": 6, "to": 10}, {"over": 10, "to": 18}, {"over": 18, "to": 30}, {"over": 30, "to": 50}, {"over": 50, "to": 80}, {"over": 80, "to": 120}, {"over": 120, "to": 180}, {"over": 180, "to": 250}, {"over": 250, "to": 315}, {"over": 315, "to": 400}, {"over": 400, "to": 500}], "IT": {"IT5": [4, 5, 6, 8, 9, 11, 13, 15, 18, 20, 23, 25, 27], "IT6": [6, 8, 9, 11, 13, 16, 19, 22, 25, 29, 32, 36, 40], "IT7": [10, 12, 15, 18, 21, 25, 30, 35, 40, 46, 52, 57, 63], "IT8": [14, 18, 22, 27, 33, 39, 46, 54, 63, 72, 81, 89, 97], "IT9": [25, 30, 36, 43, 52, 62, 74, 87, 100, 115, 130, 140, 155], "IT10": [40, 48, 58, 70, 84, 100, 120, 140, 160, 185, 210, 230, 250], "IT11": [60, 75, 90, 110, 130, 160, 190, 220, 250, 290, 320, 360, 400], "IT12": [100, 120, 150, 180, 210, 250, 300, 350, 400, 460, 520, 570, 630]}, "holes": {"H6": [{"ES": 6, "EI": 0}, {"ES": 8, "EI": 0}, {"ES": 9, "EI": 0}, {"ES": 11, "EI": 0}, {"ES": 13, "EI": 0}, {"ES": 16, "EI": 0}, {"ES": 19, "EI": 0}, {"ES": 22, "EI": 0}, {"ES": 25, "EI": 0}, {"ES": 29, "EI": 0}, {"ES": 32, "EI": 0}, {"ES": 36, "EI": 0}, {"ES": 40, "EI": 0}], "H7": [{"ES": 10, "EI": 0}, {"ES": 12, "EI": 0}, {"ES": 15, "EI": 0}, {"ES": 18, "EI": 0}, {"ES": 21, "EI": 0}, {"ES": 25, "EI": 0}, {"ES": 30, "EI": 0}, {"ES": 35, "EI": 0}, {"ES": 40, "EI": 0}, {"ES": 46, "EI": 0}, {"ES": 52, "EI": 0}, {"ES": 57, "EI": 0}, {"ES": 63, "EI": 0}], "H8": [{"ES": 14, "EI": 0}, {"ES": 18, "EI": 0}, {"ES": 22, "EI": 0}, {"ES": 27, "EI": 0}, {"ES": 33, "EI": 0}, {"ES": 39, "EI": 0}, {"ES": 46, "EI": 0}, {"ES": 54, "EI": 0}, {"ES": 63, "EI": 0}, {"ES": 72, "EI": 0}, {"ES": 81, "EI": 0}, {"