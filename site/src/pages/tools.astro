---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Smart Tools — Partpedia"
  description="Utilitas perhitungan industri Partpedia. Pythagoras: isi 2 nilai, satu sisi dihitung otomatis."
>
  <section class="tools">
    <header class="tools-head">
      <p class="kicker">Smart Tools</p>
      <h1>Utilitas perhitungan industri</h1>
      <p class="lead">
        Alat bantu cepat untuk workshop, plant, dan manufaktur — fokus pada perhitungan yang sering dipakai di lapangan.
      </p>
    </header>

    <div class="tool-panel" id="pythagoras-panel">
      <div class="tool-top">
        <div>
          <h2>Segitiga · Pythagoras</h2>
          <p class="tool-desc">
            Isi <strong>sembarang 2</strong> dari 3 kolom (sisi A, sisi B, atau sisi miring C).
            Kolom yang dikosongkan dihitung otomatis dan ditandai sebagai hasil.
          </p>
        </div>
        <div class="formula" aria-hidden="true">A² + B² = C²</div>
      </div>

      <div class="fields">
        <label class="field" data-key="a">
          <span class="label">Sisi A <em>(tinggi / kaki 1)</em></span>
          <input id="side-a" type="number" inputmode="decimal" step="any" min="0" placeholder="—" autocomplete="off" />
        </label>
        <label class="field" data-key="b">
          <span class="label">Sisi B <em>(alas / kaki 2)</em></span>
          <input id="side-b" type="number" inputmode="decimal" step="any" min="0" placeholder="—" autocomplete="off" />
        </label>
        <label class="field" data-key="c">
          <span class="label">Sisi C <em>(garis miring / hipotenusa)</em></span>
          <input id="side-c" type="number" inputmode="decimal" step="any" min="0" placeholder="—" autocomplete="off" />
        </label>
      </div>

      <div class="tool-actions">
        <button type="button" class="btn-calc" id="btn-calc">Hitung</button>
        <button type="button" class="btn-reset" id="btn-reset">Reset</button>
        <p class="msg" id="py-msg" role="status"></p>
      </div>

      <div class="hint-box">
        <strong>Cara pakai cepat:</strong> kosongkan hanya sisi yang ingin dicari → isi dua sisi lainnya → hasil muncul otomatis (atau ketuk Hitung).
        Kolom hasil berubah warna agar mudah dikenali.
      </div>
    </div>

    <p class="more-soon">Utilitas lain (unit converter, belt length, dll.) dapat ditambahkan bertahap tanpa mengubah struktur halaman ini.</p>
  </section>

  <script>
    (function () {
      const aEl = document.getElementById("side-a") as HTMLInputElement;
      const bEl = document.getElementById("side-b") as HTMLInputElement;
      const cEl = document.getElementById("side-c") as HTMLInputElement;
      const msg = document.getElementById("py-msg");
      const fields = {
        a: aEl?.closest(".field") as HTMLElement,
        b: bEl?.closest(".field") as HTMLElement,
        c: cEl?.closest(".field") as HTMLElement,
      };

      /** Parse angka: koma → titik, kosong = null */
      function num(el: HTMLInputElement | null): number | null {
        if (!el) return null;
        let v = el.value.trim().replace(",", ".");
        if (v === "") return null;
        const n = Number(v);
        return Number.isFinite(n) ? n : NaN;
      }

      function formatResult(value: number): string {
        // Presisi tinggi, buang nol berlebih (maks 10 digit signifikan setelah hitung)
        if (!Number.isFinite(value)) return "";
        const abs = Math.abs(value);
        let s: string;
        if (abs !== 0 && (abs < 1e-6 || abs >= 1e10)) {
          s = value.toExponential(8);
        } else {
          s = value.toFixed(10).replace(/\.?0+$/, "");
        }
        return s;
      }

      function clearComputedOnly() {
        Object.values(fields).forEach((f) => f?.classList.remove("is-result"));
        [aEl, bEl, cEl].forEach((el) => {
          if (el?.dataset.computed === "1") {
            el.value = "";
            delete el.dataset.computed;
          }
        });
      }

      function setResult(key: "a" | "b" | "c", value: number) {
        const el = key === "a" ? aEl : key === "b" ? bEl : cEl;
        if (!el) return;
        el.value = formatResult(value);
        el.dataset.computed = "1";
        fields[key]?.classList.add("is-result");
      }

      function compute() {
        // Hapus hanya hasil sebelumnya, jangan hapus input user
        clearComputedOnly();

        const a = num(aEl);
        const b = num(bEl);
        const c = num(cEl);

        const invalid = [a, b, c].some((v) => v !== null && (Number.isNaN(v) || v < 0));
        if (invalid) {
          if (msg) msg.textContent = "Nilai harus angka yang valid dan ≥ 0.";
          return;
        }

        const filled = [
          a !== null ? "a" : null,
          b !== null ? "b" : null,
          c !== null ? "c" : null,
        ].filter(Boolean) as ("a" | "b" | "c")[];

        if (filled.length < 2) {
          if (msg) msg.textContent = "Isi minimal 2 kolom.";
          return;
        }
        if (filled.length === 3) {
          if (msg) msg.textContent = "Kosongkan 1 kolom yang ingin dihitung.";
          return;
        }

        // A² + B² = C²  (C = hipotenusa)
        const eps = 1e-12;

        try {
          if (a !== null && b !== null && c === null) {
            // C = √(A² + B²)
            const r = Math.sqrt(a * a + b * b);
            setResult("c", r);
            if (msg) msg.textContent = "Sisi miring C = √(A² + B²).";
            return;
          }

          if (a !== null && c !== null && b === null) {
            // B = √(C² − A²), syarat C > A
            if (c + eps < a) throw new Error("Sisi miring C harus lebih besar dari sisi A.");
            if (Math.abs(c - a) < eps) {
              setResult("b", 0);
              if (msg) msg.textContent = "Sisi B = 0 (C sama dengan A).";
              return;
            }
            const r = Math.sqrt(c * c - a * a);
            setResult("b", r);
            if (msg) msg.textContent = "Sisi B = √(C² − A²).";
            return;
          }

          if (b !== null && c !== null && a === null) {
            // A = √(C² − B²), syarat C > B
            if (c + eps < b) throw new Error("Sisi miring C harus lebih besar dari sisi B.");
            if (Math.abs(c - b) < eps) {
              setResult("a", 0);
              if (msg) msg.textContent = "Sisi A = 0 (C sama dengan B).";
              return;
            }
            const r = Math.sqrt(c * c - b * b);
            setResult("a", r);
            if (msg) msg.textContent = "Sisi A = √(C² − B²).";
            return;
          }
        } catch (e: any) {
          if (msg) msg.textContent = e?.message || "Perhitungan tidak valid.";
        }
      }

      function onInput(el: HTMLInputElement) {
        // Jika user mengedit kolom hasil, anggap jadi input manual
        if (el.dataset.computed === "1") {
          delete el.dataset.computed;
          el.closest(".field")?.classList.remove("is-result");
        } else {
          // User mengubah input → buang hasil lama agar tidak tertinggal angka usang
          clearComputedOnly();
        }

        const vals = [num(aEl), num(bEl), num(cEl)];
        const count = vals.filter((v) => v !== null && !Number.isNaN(v)).length;
        if (count === 2) compute();
        else if (msg && count < 2) msg.textContent = "";
      }

      [aEl, bEl, cEl].forEach((el) => {
        el?.addEventListener("input", () => onInput(el!));
        el?.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            compute();
          }
        });
      });

      document.getElementById("btn-calc")?.addEventListener("click", compute);
      document.getElementById("btn-reset")?.addEventListener("click", () => {
        [aEl, bEl, cEl].forEach((el) => {
          if (el) {
            el.value = "";
            delete el.dataset.computed;
          }
        });
        Object.values(fields).forEach((f) => f?.classList.remove("is-result"));
        if (msg) msg.textContent = "";
      });
    })();
  </script>

  <style>
    .tools {
      max-width: 820px;
      margin: 0 auto;
      padding: 1.5rem 0 3.5rem;
    }
    .tools-head { margin-bottom: 1.35rem; }
    .kicker {
      margin: 0 0 0.4rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--teal);
    }
    .tools-head h1 {
      margin: 0 0 0.5rem;
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 4vw, 2.2rem);
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
    .lead {
      margin: 0;
      color: var(--muted);
      font-size: 1.02rem;
      line-height: 1.6;
      max-width: 36rem;
    }
    .tool-panel {
      border: 1px solid var(--line);
      border-radius: 22px;
      padding: 1.35rem 1.25rem 1.4rem;
      background:
        radial-gradient(120% 80% at 0% 0%, rgba(45,212,191,0.1), transparent 50%),
        radial-gradient(100% 70% at 100% 0%, rgba(240,164,58,0.08), transparent 45%),
        var(--bg-card);
      box-shadow: 0 20px 50px rgba(0,0,0,0.22);
    }
    .tool-top {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.2rem;
    }
    .tool-top h2 {
      margin: 0 0 0.35rem;
      font-size: 1.2rem;
      font-family: var(--font-display);
    }
    .tool-desc {
      margin: 0;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.55;
      max-width: 32rem;
    }
    .formula {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--amber);
      border: 1px solid rgba(240,164,58,0.35);
      background: rgba(240,164,58,0.08);
      padding: 0.45rem 0.75rem;
      border-radius: 999px;
      white-space: nowrap;
    }
    .fields {
      display: grid;
      gap: 0.85rem;
    }
    @media (min-width: 640px) {
      .fields { grid-template-columns: repeat(3, 1fr); }
    }
    .field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding: 0.85rem 0.9rem;
      border-radius: 16px;
      border: 1px solid var(--line);
      background: rgba(0,0,0,0.22);
      transition: border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }
    .field .label {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--ink);
    }
    .field .label em {
      font-style: normal;
      font-weight: 500;
      color: var(--muted);
      font-size: 0.78rem;
    }
    .field input {
      width: 100%;
      box-sizing: border-box;
      border: none;
      outline: none;
      background: transparent;
      color: var(--ink);
      font-size: 1.35rem;
      font-weight: 700;
      font-family: var(--font-mono);
      padding: 0.25rem 0;
    }
    .field input::placeholder { color: var(--muted); opacity: 0.5; }
    .field.is-result {
      border-color: rgba(45,212,191,0.65);
      background: rgba(45,212,191,0.12);
      box-shadow: 0 0 0 3px rgba(45,212,191,0.12);
    }
    .field.is-result .label { color: var(--teal); }
    .tool-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      margin-top: 1.15rem;
    }
    .btn-calc {
      appearance: none; border: none; cursor: pointer;
      font-weight: 800; font-size: 0.9rem; letter-spacing: 0.04em;
      padding: 0.75rem 1.35rem; border-radius: 999px;
      color: #0b0f14;
      background: linear-gradient(135deg, #2dd4bf, #14b8a6);
      box-shadow: 0 10px 26px rgba(45,212,191,0.25);
    }
    .btn-reset {
      appearance: none; cursor: pointer;
      font-weight: 600; font-size: 0.88rem;
      padding: 0.72rem 1.15rem; border-radius: 999px;
      color: var(--ink);
      background: transparent;
      border: 1px solid var(--line);
    }
    .msg {
      margin: 0;
      font-size: 0.88rem;
      color: var(--muted);
    }
    .hint-box {
      margin-top: 1.15rem;
      padding: 0.85rem 1rem;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.03);
      font-size: 0.86rem;
      color: var(--muted);
      line-height: 1.5;
      text-align: left;
    }
    .hint-box strong { color: var(--ink); }
    .more-soon {
      margin: 1.25rem 0 0;
      font-size: 0.84rem;
      color: var(--muted);
      text-align: center;
    }
  </style>
</Layout>
