---
import Layout from "../../layouts/Layout.astro";
import { loadAllQa } from "../../data/loadQa.js";

const items = loadAllQa();
---
<Layout
  title="Q&A Industri & Manufaktur — Partpedia"
  description="Pertanyaan dan jawaban praktis seputar bearing, pompa, gearbox, hidrolik, VFD, maintenance, dan operasional pabrik manufaktur."
>
  <section class="qa-hub">
    <header class="qa-head">
      <div class="qa-brand">
        <img src="/logo.png" alt="Partpedia" width="40" height="40" />
        <span class="qa-brand-name">Part<span>pedia</span></span>
      </div>
      <p class="kicker">Insight · Q&amp;A</p>
      <h1>Pertanyaan &amp; jawaban industri</h1>
      <p class="lead">
        Kumpulan Q&amp;A praktis untuk maintenance, reliability, dan operasional manufaktur —
        dari bearing dan pompa hingga hidrolik, VFD, OEE, dan K3.
      </p>
    </header>

    <div class="search-wrap">
      <label class="sr-only" for="qa-search">Cari Q&amp;A</label>
      <input
        id="qa-search"
        type="search"
        placeholder="Cari kata atau kalimat dalam pertanyaan & jawaban…"
        autocomplete="off"
        aria-label="Cari Q dan A"
      />
      <p class="search-hint" id="qa-search-hint" hidden></p>
    </div>

    <div class="qa-list" id="qa-list" role="list">
      {items.map((it, i) => {
        const blob = [it.question, it.answer, it.source, it.slug]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();
        return (
          <a
            class="qa-card"
            href={`/qa/${it.slug}/`}
            role="listitem"
            data-search={blob}
          >
            <span class="qa-num">{String(it.id || i + 1).padStart(2, "0")}</span>
            <span class="qa-q">{it.question}</span>
            <span class="qa-go" aria-hidden="true">→</span>
          </a>
        );
      })}
    </div>
    <p class="qa-empty" id="qa-empty" hidden>Tidak ada topik yang cocok. Coba kata kunci lain.</p>
  </section>

  <script>
    const input = document.getElementById("qa-search");
    const rows = Array.from(document.querySelectorAll("#qa-list .qa-card"));
    const empty = document.getElementById("qa-empty");
    const hint = document.getElementById("qa-search-hint");

    function apply() {
      const q = (input?.value || "").toLowerCase().trim();
      const terms = q ? q.split(/\s+/).filter(Boolean) : [];
      let n = 0;
      rows.forEach((row) => {
        const hay = row.getAttribute("data-search") || "";
        const ok = terms.length === 0 || terms.every((t) => hay.includes(t));
        row.style.display = ok ? "" : "none";
        if (ok) n++;
      });
      if (empty) empty.hidden = n !== 0;
      if (hint) {
        if (!q) {
          hint.hidden = true;
        } else {
          hint.hidden = false;
          hint.textContent = n === 0 ? "0 topik cocok" : `${n} topik cocok`;
        }
      }
    }
    input?.addEventListener("input", apply);
  </script>

  <style>
    .qa-hub {
      max-width: 820px;
      margin: 0 auto;
      padding: 1.5rem 0 3.5rem;
    }
    .qa-head {
      text-align: center;
      margin-bottom: 1.25rem;
    }
    .qa-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 0.85rem;
      text-decoration: none;
    }
    .qa-brand img {
      border-radius: 8px;
    }
    .qa-brand-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .qa-brand-name span { color: var(--amber); }
    .kicker {
      margin: 0 0 0.4rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--teal);
    }
    .qa-head h1 {
      margin: 0 0 0.5rem;
      font-family: var(--font-display);
      font-size: clamp(1.55rem, 4vw, 2.15rem);
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
    .lead {
      margin: 0 auto;
      max-width: 36rem;
      color: var(--muted);
      font-size: 1.02rem;
      line-height: 1.55;
    }

    .search-wrap { margin: 0 0 1.25rem; }
    #qa-search {
      width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 1.05rem;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: var(--bg-card);
      color: var(--ink);
      font-size: 1rem;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    #qa-search::placeholder { color: var(--muted); }
    #qa-search:focus {
      border-color: var(--amber);
      box-shadow: 0 0 0 3px rgba(240,164,58,0.18);
    }
    .search-hint {
      margin: 0.45rem 0 0;
      font-size: 0.82rem;
      color: var(--muted);
      text-align: left;
    }
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); border: 0;
    }

    .qa-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .qa-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0.85rem 1rem;
      align-items: center;
      padding: 1.05rem 1.15rem;
      border-radius: 16px;
      text-decoration: none;
      color: inherit;
      border: 1px solid var(--line);
      background:
        linear-gradient(145deg, rgba(45,212,191,0.06), transparent 55%),
        var(--bg-card);
      box-shadow: 0 8px 28px rgba(0,0,0,0.12);
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .qa-card:hover {
      transform: translateY(-2px);
      border-color: rgba(45,212,191,0.45);
      box-shadow: 0 14px 36px rgba(0,0,0,0.2), 0 0 0 1px rgba(45,212,191,0.12);
    }
    .qa-num {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--teal);
      background: rgba(45,212,191,0.12);
      border: 1px solid rgba(45,212,191,0.28);
      border-radius: 999px;
      padding: 0.28rem 0.55rem;
      min-width: 2.4rem;
      text-align: center;
    }
    .qa-q {
      font-weight: 650;
      font-size: 0.98rem;
      line-height: 1.4;
      color: var(--ink);
    }
    .qa-go {
      font-size: 1.15rem;
      color: var(--amber);
      opacity: 0.85;
    }
    .qa-empty {
      margin: 1rem 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 0.95rem;
    }
    @media (max-width: 560px) {
      .qa-card {
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
      }
      .qa-go { display: none; }
    }
  </style>
</Layout>
