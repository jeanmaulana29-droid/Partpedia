---
import Layout from "../../layouts/Layout.astro";
import { loadAllQa } from "../../data/loadQa.js";

const items = loadAllQa();
const site = "https://www.klikpartpedia.com";
const PAGE_SIZE = 100;
const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));

// FAQPage: up to 40 items for rich-result friendliness (all pages still indexed individually)
const faqMainEntity = items.slice(0, 40).map((it) => ({
  "@type": "Question",
  name: it.question,
  acceptedAnswer: {
    "@type": "Answer",
    text: String(it.answer || "").replace(/\s+/g, " ").trim().slice(0, 5000),
  },
}));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${site}/qa/#page`,
      url: `${site}/qa/`,
      name: "Industrial Manufacturing Q&A — Bearings, Pumps, VFD, Hydraulics, OEE | Partpedia",
      description:
        "Practical industrial Q&A for plant maintenance and manufacturing: bearing failures, pump cavitation, gearbox pitting, VFD harmonics, hydraulic contamination, OEE, LOTO, and more. Bilingual industrial terminology for global engineers.",
      inLanguage: ["id", "en"],
      isPartOf: { "@type": "WebSite", name: "Partpedia", url: site },
      numberOfItems: items.length,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Industrial Q&A", item: `${site}/qa/` },
      ],
    },
    {
      "@type": "FAQPage",
      "@id": `${site}/qa/#faq`,
      mainEntity: faqMainEntity,
    },
  ],
};
---
<Layout
  title="Industrial Manufacturing Q&A — Bearings, Pumps, VFD, Hydraulics, OEE | Partpedia"
  description="Industrial Q&A for maintenance engineers: bearing overheating, pump cavitation, gearbox pitting, VFD harmonics, hydraulic oil contamination, OEE, RCFA, LOTO. Practical answers with ISO/IEEE references — Partpedia."
  jsonLd={jsonLd}
>
  <section class="qa-hub">
    <header class="qa-head">
      <div class="qa-brand">
        <img src="/logo.png" alt="Partpedia industrial parts and MRO knowledge" width="40" height="40" />
        <span class="qa-brand-name">Part<span>pedia</span></span>
      </div>
      <p class="kicker">Insight · Industrial Q&amp;A</p>
      <h1>Industrial manufacturing Q&amp;A</h1>
      <p class="lead">
        Practical questions and answers for plant maintenance, reliability, and manufacturing operations —
        bearings, pumps, gearboxes, hydraulics, VFD harmonics, OEE, LOTO, and more.
      </p>
      <p class="lead-id">
        Kumpulan Q&amp;A praktis untuk maintenance, reliability, dan operasional manufaktur —
        dari bearing dan pompa hingga hidrolik, VFD, OEE, dan K3.
      </p>
      <p class="topics" aria-label="Topic keywords">
        Topics: bearing failure · pump cavitation · gearbox pitting · VFD harmonics · hydraulic contamination ·
        OEE · RCFA · LOTO · motor overload · belt tracking · ISO 10816 · IEEE 519 · NPSH
      </p>
    </header>

    <div class="search-wrap">
      <label class="sr-only" for="qa-search">Search industrial Q&amp;A</label>
      <input
        id="qa-search"
        type="search"
        placeholder="Search keywords in questions & answers (EN / ID)…"
        autocomplete="off"
        aria-label="Search Q and A"
      />
      <p class="search-hint" id="qa-search-hint" hidden></p>
    </div>

    <p class="page-meta" id="page-meta" data-total={items.length} data-pagesize={PAGE_SIZE}></p>

    <div class="qa-list" id="qa-list" role="list">
      {items.map((it, i) => {
        const blob = [it.question, it.answer, it.source, it.slug]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();
        const num = it.id || i + 1;
        return (
          <a
            class="qa-card"
            href={`/qa/${it.slug}/`}
            role="listitem"
            data-search={blob}
            data-idx={i}
            data-num={num}
          >
            <span class="qa-num">{String(num).padStart(2, "0")}</span>
            <span class="qa-q">{it.question}</span>
            <span class="qa-go" aria-hidden="true">→</span>
          </a>
        );
      })}
    </div>
    <p class="qa-empty" id="qa-empty" hidden>No matching topics. Try another keyword.</p>

    {/* Pagination: 1 = kartu 1–100, 2 = 101–200, … otomatis saat total naik */}
    <nav class="qa-pager" id="qa-pager" aria-label="Halaman Q&amp;A" hidden>
      <button type="button" class="pager-nav" id="pager-prev" aria-label="Halaman sebelumnya">←</button>
      <div class="pager-nums" id="pager-nums"></div>
      <button type="button" class="pager-nav" id="pager-next" aria-label="Halaman berikutnya">→</button>
    </nav>
  </section>

  <script is:inline>
    (function () {
      const PAGE_SIZE = 100;
      const input = document.getElementById("qa-search");
      const rows = Array.from(document.querySelectorAll("#qa-list .qa-card"));
      const empty = document.getElementById("qa-empty");
      const hint = document.getElementById("qa-search-hint");
      const meta = document.getElementById("page-meta");
      const pager = document.getElementById("qa-pager");
      const pagerNums = document.getElementById("pager-nums");
      const btnPrev = document.getElementById("pager-prev");
      const btnNext = document.getElementById("pager-next");

      const total = rows.length;
      const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

      function pageFromUrl() {
        try {
          const u = new URL(window.location.href);
          const p = parseInt(u.searchParams.get("page") || "1", 10);
          if (Number.isFinite(p) && p >= 1 && p <= totalPages) return p;
        } catch (_) {}
        return 1;
      }

      let currentPage = pageFromUrl();

      function setUrl(page) {
        try {
          const u = new URL(window.location.href);
          if (page <= 1) u.searchParams.delete("page");
          else u.searchParams.set("page", String(page));
          history.replaceState(null, "", u.pathname + u.search + u.hash);
        } catch (_) {}
      }

      function rangeLabel(page) {
        const start = (page - 1) * PAGE_SIZE + 1;
        const end = Math.min(page * PAGE_SIZE, total);
        return start + "–" + end;
      }

      function renderPager() {
        if (!pager || !pagerNums) return;
        // Sembunyikan pager jika total ≤ 100
        if (totalPages <= 1) {
          pager.hidden = true;
          return;
        }
        pager.hidden = false;
        pagerNums.innerHTML = "";
        for (let p = 1; p <= totalPages; p++) {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "pager-btn" + (p === currentPage ? " active" : "");
          b.textContent = String(p);
          b.setAttribute("aria-label", "Halaman " + p + " (" + rangeLabel(p) + ")");
          if (p === currentPage) b.setAttribute("aria-current", "page");
          b.addEventListener("click", () => goPage(p));
          pagerNums.appendChild(b);
        }
        if (btnPrev) btnPrev.disabled = currentPage <= 1;
        if (btnNext) btnNext.disabled = currentPage >= totalPages;
      }

      function goPage(p) {
        if (p < 1 || p > totalPages) return;
        currentPage = p;
        setUrl(p);
        // clear search when switching page via pager (optional: keep search)
        apply();
        try {
          document.getElementById("qa-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
        } catch (_) {}
      }

      function apply() {
        const q = (input?.value || "").toLowerCase().trim();
        const terms = q ? q.split(/\s+/).filter(Boolean) : [];
        const searching = terms.length > 0;

        let matchCount = 0;
        const start = (currentPage - 1) * PAGE_SIZE;
        const end = start + PAGE_SIZE;

        rows.forEach((row, i) => {
          const hay = row.getAttribute("data-search") || "";
          const match = !searching || terms.every((t) => hay.includes(t));
          if (match) matchCount++;

          let show;
          if (searching) {
            // Saat cari: tampilkan semua yang cocok (lintas halaman)
            show = match;
          } else {
            // Mode normal: hanya 100 kartu di halaman aktif
            show = match && i >= start && i < end;
          }
          row.style.display = show ? "" : "none";
        });

        if (empty) empty.hidden = matchCount !== 0;

        if (meta) {
          if (searching) {
            meta.textContent =
              matchCount === 0
                ? "0 hasil"
                : matchCount + " hasil pencarian (semua halaman)";
          } else {
            meta.textContent =
              "Menampilkan " +
              rangeLabel(currentPage) +
              " dari " +
              total +
              " topik · Halaman " +
              currentPage +
              "/" +
              totalPages;
          }
        }

        if (hint) {
          if (!searching) {
            hint.hidden = true;
          } else {
            hint.hidden = false;
            hint.textContent = matchCount === 0 ? "0 matches" : matchCount + " matches";
          }
        }

        // Pager: sembunyikan saat sedang search
        if (pager) {
          if (searching || totalPages <= 1) pager.hidden = true;
          else {
            pager.hidden = false;
            renderPager();
          }
        }
      }

      btnPrev?.addEventListener("click", () => goPage(currentPage - 1));
      btnNext?.addEventListener("click", () => goPage(currentPage + 1));
      input?.addEventListener("input", () => {
        // search: tampil semua match; reset visual page indicator optional
        apply();
      });

      renderPager();
      apply();
    })();
  </script>

  <style>
    .qa-hub {
      max-width: 820px;
      margin: 0 auto;
      padding: 1.5rem 0 3.5rem;
    }
    .qa-head {
      text-align: center;
      margin-bottom: 1.25rem;
    }
    .qa-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 0.85rem;
      text-decoration: none;
    }
    .qa-brand img {
      border-radius: 8px;
    }
    .qa-brand-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .qa-brand-name span { color: var(--amber); }
    .kicker {
      margin: 0 0 0.4rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--teal);
    }
    .qa-head h1 {
      margin: 0 0 0.5rem;
      font-family: var(--font-display);
      font-size: clamp(1.55rem, 4vw, 2.15rem);
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
    .lead {
      margin: 0 auto 0.55rem;
      max-width: 40rem;
      color: var(--muted);
      font-size: 1.02rem;
      line-height: 1.55;
    }
    .lead-id {
      margin: 0 auto 0.75rem;
      max-width: 40rem;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.5;
      opacity: 0.92;
    }
    .topics {
      margin: 0 auto;
      max-width: 42rem;
      font-size: 0.78rem;
      line-height: 1.45;
      color: #64748b;
      font-family: var(--font-mono);
    }

    .search-wrap { margin: 0 0 0.65rem; }
    #qa-search {
      width: 100%;
      box-sizing: border-box;
      padding: 0.85rem 1.05rem;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: var(--bg-card);
      color: var(--ink);
      font-size: 1rem;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    #qa-search::placeholder { color: var(--muted); }
    #qa-search:focus {
      border-color: var(--amber);
      box-shadow: 0 0 0 3px rgba(240,164,58,0.18);
    }
    .search-hint {
      margin: 0.45rem 0 0;
      font-size: 0.82rem;
      color: var(--muted);
      text-align: left;
    }
    .page-meta {
      margin: 0 0 1rem;
      font-size: 0.82rem;
      color: var(--muted);
      font-family: var(--font-mono);
    }
    .sr-only {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0,0,0,0); border: 0;
    }

    .qa-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .qa-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 0.85rem 1rem;
      align-items: center;
      padding: 1.05rem 1.15rem;
      border-radius: 16px;
      text-decoration: none;
      color: inherit;
      border: 1px solid var(--line);
      background:
        linear-gradient(145deg, rgba(45,212,191,0.06), transparent 55%),
        var(--bg-card);
      box-shadow: 0 8px 28px rgba(0,0,0,0.12);
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .qa-card:hover {
      transform: translateY(-2px);
      border-color: rgba(45,212,191,0.45);
      box-shadow: 0 14px 36px rgba(0,0,0,0.2), 0 0 0 1px rgba(45,212,191,0.12);
    }
    .qa-num {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--teal);
      background: rgba(45,212,191,0.12);
      border: 1px solid rgba(45,212,191,0.28);
      border-radius: 999px;
      padding: 0.28rem 0.55rem;
      min-width: 2.4rem;
      text-align: center;
    }
    .qa-q {
      font-weight: 650;
      font-size: 0.98rem;
      line-height: 1.4;
      color: var(--ink);
    }
    .qa-go {
      font-size: 1.15rem;
      color: var(--amber);
      opacity: 0.85;
    }
    .qa-empty {
      margin: 1rem 0 0;
      text-align: center;
      color: var(--muted);
      font-size: 0.95rem;
    }

    /* Pager */
    .qa-pager {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      margin-top: 1.75rem;
      flex-wrap: wrap;
    }
    .pager-nums {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      justify-content: center;
    }
    .pager-btn, .pager-nav {
      appearance: none;
      cursor: pointer;
      min-width: 2.4rem;
      height: 2.4rem;
      padding: 0 0.65rem;
      border-radius: 999px;
      border: 1px solid var(--line);
      background: var(--bg-card);
      color: var(--ink);
      font-weight: 700;
      font-size: 0.88rem;
      font-family: var(--font-mono);
      transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    }
    .pager-btn:hover, .pager-nav:hover:not(:disabled) {
      border-color: rgba(45,212,191,0.5);
      color: var(--teal);
    }
    .pager-btn.active {
      background: linear-gradient(135deg, #2dd4bf, #5b9fd4);
      color: #0b1f3a;
      border-color: transparent;
    }
    .pager-nav:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    @media (max-width: 560px) {
      .qa-card {
        grid-template-columns: auto 1fr;
        grid-template-rows: auto auto;
      }
      .qa-go { display: none; }
    }
  </style>
</Layout>
