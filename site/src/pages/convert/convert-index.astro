---
import Layout from "../../layouts/Layout.astro";
import converters from "../../data/converters.json";

const site = "https://www.klikpartpedia.com";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      name: "Partpedia Convert X",
      alternateName: [
        "Industrial unit converter",
        "Engineering unit conversion tools",
        "Hardness pressure torque converter",
      ],
      url: `${site}/convert/`,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      browserRequirements: "Requires JavaScript",
      inLanguage: ["en", "id"],
      isAccessibleForFree: true,
      description:
        "Free industrial unit converters for manufacturing and MRO: length, pressure, torque, hardness (HRC/HB/HV), electrical, flow rate, viscosity, density, and more. SI / ISO oriented.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: {
        "@type": "Organization",
        name: "Partpedia",
        url: `${site}/`,
      },
    },
    {
      "@type": "ItemList",
      name: "Industrial unit converters",
      numberOfItems: converters.length,
      itemListElement: converters.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        url: `${site}/convert/${c.slug}/`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: "Convert X", item: `${site}/convert/` },
      ],
    },
  ],
};
---
<Layout
  title="Convert X — Industrial Unit Converter (Pressure, Torque, Hardness) | Partpedia"
  description="Free industrial unit converter for engineers: mm/inch, MPa/psi, N·m/lbf·ft, HRC/HB/HV hardness, flow, viscosity, electrical units. Fast accurate conversion for manufacturing & MRO."
  jsonLd={jsonLd}
>
  <section class="hub">
    <header class="hub-head">
      <p class="kicker">Convert X</p>
      <h1>Industrial unit converter</h1>
      <p>Pick a category — enter one value, related units update instantly. Conversion factors aligned with common industrial practice (SI / ISO).</p>
    </header>
    <div class="app-grid">
      {converters.map((c) => (
        <a class="app-icon" href={`/convert/${c.slug}/`}>
          <div class="app-face" style={`background: linear-gradient(145deg, ${c.color}cc, ${c.color}66);`}>
            <span class="float-ico" aria-hidden="true">{c.emoji}</span>
          </div>
          <span class="app-name">{c.name}</span>
          <span class="app-sub">{c.sub}</span>
        </a>
      ))}
    </div>
  </section>
  <style>
  .hub { max-width: 920px; margin: 0 auto; padding: 1.35rem 1rem 3rem; }
  .hub-head { text-align: center; margin-bottom: 1.5rem; }
  .kicker { margin:0 0 0.4rem; font-family: var(--font-mono); font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase; color: var(--teal); }
  .hub-head h1 { margin:0 0 0.45rem; font-family: var(--font-display); font-size: clamp(1.55rem,4vw,2.15rem); letter-spacing:-0.02em; }
  .hub-head p { margin:0 auto; max-width: 40rem; color: var(--muted); font-size:0.95rem; line-height:1.5; }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem 0.65rem;
  }
  @media (min-width: 720px) {
    .app-grid { grid-template-columns: repeat(3, 1fr); gap: 1.1rem 1rem; }
  }
  .app-icon {
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    text-decoration: none; color: inherit; padding: 0.35rem;
    transition: transform 0.18s ease;
  }
  .app-icon:hover { transform: translateY(-3px); }
  .app-icon:hover .app-face { transform: scale(1.08); }
  .app-face {
    width: 4.25rem; height: 4.25rem; border-radius: 22px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.75rem; box-shadow: 0 10px 28px rgba(0,0,0,0.25);
    transition: transform 0.2s ease;
    overflow: hidden; position: relative;
  }
  @media (min-width: 720px) {
    .app-face { width: 5rem; height: 5rem; font-size: 2rem; border-radius: 24px; }
  }
  .float-ico {
    display: inline-block;
    animation: bob 2.8s ease-in-out infinite;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
  }
  .app-icon:nth-child(3n+1) .float-ico { animation-delay: 0s; }
  .app-icon:nth-child(3n+2) .float-ico { animation-delay: 0.4s; }
  .app-icon:nth-child(3n+3) .float-ico { animation-delay: 0.8s; }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-6px) rotate(4deg); }
  }
  .app-name { font-size: 0.78rem; font-weight: 700; text-align: center; line-height: 1.25; max-width: 7.5rem; }
  .app-sub { font-size: 0.68rem; color: var(--muted); text-align: center; line-height: 1.2; max-width: 7.5rem; }
  </style>
</Layout>
