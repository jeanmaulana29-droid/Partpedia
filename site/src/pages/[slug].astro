---
import Layout from "../../layouts/Layout.astro";
import AdSlot from "../../components/AdSlot.astro";
import PartPlate from "../../components/PartPlate.astro";
import Badge from "../../components/Badge.astro";
import EquivalentCodes from "../../components/EquivalentCodes.astro";
import SpecsTable from "../../components/SpecsTable.astro";
import data from "../../data/data.json";
import { getCategoryTheme } from "../../utils/theme.js";

export async function getStaticPaths() {
  return data.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const theme = getCategoryTheme(entry.category);

const relatedEntries = data
  .filter((d) => d.category === entry.category && d.slug !== entry.slug)
  .slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${entry.part_name} (${entry.part_number})`,
  description: entry.description,
  category: entry.category,
  brand: { "@type": "Brand", name: entry.brand },
  additionalProperty: [
    { "@type": "PropertyValue", name: "Kode Part", value: entry.part_number },
    { "@type": "PropertyValue", name: "Size", value: entry.size || "-" },
    { "@type": "PropertyValue", name: "Fungsi", value: entry.fungsi || "-" },
    { "@type": "PropertyValue", name: "Kegunaan", value: entry.kegunaan || entry.compatible_equipment || "-" },
    { "@type": "PropertyValue", name: "Keawetan", value: entry.durability || "-" },
    { "@type": "PropertyValue", name: "Material", value: entry.material || "-" },
    { "@type": "PropertyValue", name: "Standar Acuan", value: entry.iso_standard || "-" },
    ...Object.entries(entry.specs_table || {}).map(([name, value]) => ({
      "@type": "PropertyValue",
      name,
      value,
    })),
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "IDR",
    availability: "https://schema.org/InStock",
    url: new URL(`/sparepart/${entry.slug}/`, Astro.site).toString(),
  },
};
---

<Layout
  title={`${entry.part_name} (${entry.part_number}) — Spek, Size, Harga & Kode Pengganti`}
  description={entry.description}
  jsonLd={jsonLd}
>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Beranda</a>
    <span class="sep">/</span>
    <span>{entry.category}</span>
    <span class="sep">/</span>
    <span>{entry.part_number}</span>
  </nav>

  <div class="detail-layout">
    <div class="detail-main">
      <div class="title-row">
        <Badge label={entry.category} bg={theme.bg} fg={theme.fg} />
        {entry.subcategory && <Badge label={entry.subcategory} bg="#eceff0" fg="#3d4a52" />}
        {entry.vendor_type && (
          <Badge
            label={entry.vendor_type.length > 40 ? "Generic / multi-vendor" : entry.vendor_type}
            bg="#e8f0ee"
            fg="#2f5148"
          />
        )}
      </div>


      <div class="product-photo">
        <img
          src={`/products/${entry.slug}.jpg`}
          alt={entry.part_name}
          loading="lazy"
          onerror={`this.onerror=function(){this.onerror=function(){this.onerror=null;this.style.display='none';};this.src='/products/${entry.slug}.png';};this.src='/products/${entry.slug}.jpeg';`}
        />
      </div>
      <h1>{entry.part_name}</h1>
      <p class="lead-code">
        <span class="mono">{entry.part_number}</span>
        {entry.brand && <span class="dot">·</span>}
        {entry.brand && <span>{entry.brand}</span>}
      </p>
      <p class="lead-desc">{entry.description}</p>

      <div class="fact-grid">
        {entry.size && (
          <div class="fact">
            <span class="fact-label">Size / Dimensi</span>
            <span class="fact-value">{entry.size}</span>
          </div>
        )}
        {entry.unit && (
          <div class="fact">
            <span class="fact-label">Satuan</span>
            <span class="fact-value">{entry.unit}</span>
          </div>
        )}
        {entry.material && (
          <div class="fact">
            <span class="fact-label">Material</span>
            <span class="fact-value">{entry.material}</span>
          </div>
        )}
        {entry.iso_standard && (
          <div class="fact fact--wide">
            <span class="fact-label">Standar</span>
            <span class="fact-value">{entry.iso_standard}</span>
          </div>
        )}
      </div>

      <AdSlot slotId="slot-detail-atas" />

      <div class="info-cards">
        {entry.fungsi && (
          <article class="info-card">
            <h2>Fungsi</h2>
            <p>{entry.fungsi}</p>
          </article>
        )}
        {(entry.kegunaan || entry.compatible_equipment) && (
          <article class="info-card">
            <h2>Kegunaan / Aplikasi</h2>
            <p>{entry.kegunaan || entry.compatible_equipment}</p>
          </article>
        )}
        {entry.durability && (
          <article class="info-card info-card--durability">
            <h2>Keawetan & Maintenance</h2>
            <p>{entry.durability}</p>
          </article>
        )}
      </div>

      <h2 class="section-title">Spesifikasi Teknis</h2>
      <SpecsTable specs={entry.specs_table} />
      {entry.specification && (
        <p class="spec-raw muted">Ringkasan: {entry.specification}</p>
      )}

      <h2 class="section-title">Kode Pengganti / Cross-Reference</h2>
      {
        entry.equivalent_codes && entry.equivalent_codes.length > 0 ? (
          <EquivalentCodes codes={entry.equivalent_codes} />
        ) : (
          <p class="muted">Belum ada data cross-reference terverifikasi untuk part ini.</p>
        )
      }
      {entry.alternative_parts && (
        <p class="muted">Kode alternatif dari sumber: {entry.alternative_parts}</p>
      )}

      <div class="price-block">
        <span class="price-label">Kisaran Harga</span>
        <span class="price-value">
          {entry.price_range || "Belum tersedia"}
          {entry.unit && entry.price_range ? ` / ${entry.unit}` : ""}
        </span>
        <span class="price-disclaimer">⚠️ {entry.price_note}</span>
      </div>

      <AdSlot slotId="slot-detail-tengah" />

      <p class="source">Sumber: {entry.source_url} · Diperbarui {entry.last_updated}</p>

      <AdSlot slotId="slot-detail-bawah" />

      {
        relatedEntries.length > 0 && (
          <section class="related">
            <h2 class="section-title">Sparepart Terkait — {entry.category}</h2>
            <ul>
              {relatedEntries.map((r) => (
                <li>
                  <a href={`/sparepart/${r.slug}/`}>
                    <span class="rel-name">{r.part_name}</span>
                    <span class="rel-code">{r.part_number}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="detail-sidebar">
      <PartPlate
        partNumber={entry.part_number}
        category={entry.category}
        brand={entry.brand}
        isoStandard={entry.iso_standard}
      />
    </aside>
  </div>

  <style>
    .breadcrumb { font-size: 0.8rem; color: var(--muted); margin: 1rem 0 0.85rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
    .breadcrumb a { color: var(--muted); }
    .sep { opacity: 0.5; }
    .detail-layout { display: grid; grid-template-columns: 1fr; gap: 1.5rem; padding-bottom: 2.5rem; }
    @media (min-width: 860px) {
      .detail-layout { grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr); align-items: start; }
      .detail-sidebar { position: sticky; top: 5rem; }
    }
    .title-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.75rem; }
    .detail-main h1 { font-size: clamp(1.45rem, 3.5vw, 2.05rem); }
    .lead-code { margin: 0 0 0.65rem; color: var(--muted); }
    .lead-code .mono { font-family: var(--font-mono); font-weight: 600; color: var(--ink); }
    .lead-desc { color: var(--muted); max-width: 62ch; }
    .fact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.65rem; margin: 1.25rem 0; }
    .fact { background: var(--bg-card); border: 1px solid var(--line); border-radius: 12px; padding: 0.75rem 0.9rem; display: flex; flex-direction: column; gap: 0.25rem; }
    .fact--wide { grid-column: 1 / -1; }
    .fact-label { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
    .fact-value { font-size: 0.9rem; }
    .info-cards { display: grid; gap: 0.75rem; margin: 1rem 0; }
    .info-card { background: var(--bg-card); border: 1px solid var(--line); border-left: 3px solid var(--teal); border-radius: 12px; padding: 1rem 1.15rem; }
    .info-card--durability { border-left-color: var(--amber); }
    .info-card h2 { font-size: 0.78rem; font-family: var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.4rem; color: var(--muted); }
    .info-card p { margin: 0; font-size: 0.95rem; }
    .section-title { font-size: 1.05rem; margin-top: 2rem; margin-bottom: 0.75rem; padding-bottom: 0.35rem; border-bottom: 2px solid var(--amber); display: inline-block; }
    .muted { color: var(--muted); font-size: 0.85rem; }
    .price-block { background: var(--amber-soft); border: 1px solid rgba(240,164,58,0.35); border-radius: 12px; padding: 1.1rem 1.25rem; display: flex; flex-direction: column; gap: 0.25rem; margin: 1.5rem 0; }
    .price-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--amber); text-transform: uppercase; }
    .price-value { font-family: var(--font-mono); font-size: 1.35rem; font-weight: 600; }
    .price-disclaimer { font-size: 0.75rem; color: var(--muted); }
    .source { font-size: 0.8rem; color: var(--muted); }
    .related ul { list-style: none; padding: 0; margin: 0.5rem 0 0; display: grid; gap: 0.5rem; }
    .related li a { display: flex; justify-content: space-between; gap: 1rem; border: 1px solid var(--line); background: var(--bg-card); border-radius: 10px; padding: 0.7rem 0.95rem; color: var(--ink); }
    .rel-code { font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); }
    .buy-cta { display: inline-flex; margin: 0.75rem 0 0; font-weight: 600; color: var(--blue); }
  
  .product-photo {
    margin: 0 0 1.25rem;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: #0e141c;
    max-width: 420px;
  }
  .product-photo img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: contain;
  }
</style>

</Layout>
