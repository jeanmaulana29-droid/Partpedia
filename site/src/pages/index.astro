---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import Badge from "../components/Badge.astro";
import data from "../data/data.json";
import { getCategoryTheme } from "../utils/theme.js";

const total = data.length;
const categories = [...new Set(data.map((d) => d.category))];
const totalEquivalents = data.reduce((sum, d) => sum + (d.equivalent_codes?.length || 0), 0);
---

<Layout
  title="Partpedia — Database Harga, Spesifikasi & Kode Pengganti Sparepart Industri"
  description="Cari kode part, size, fungsi, spesifikasi, harga indikatif, dan cross-reference antar-brand untuk bearing, pelumas, sensor, PLC, VFD, alat ukur, dan komponen industri lainnya."
>
  <section class="hero">
    <span class="eyebrow">{total} sparepart terindeks · {categories.length} kategori · {totalEquivalents} kode cross-reference</span>
    <h1>Direktori sparepart industri: harga, spek, size &amp; kode pengganti.</h1>
    <p>
      Dari bearing hingga PLC, sensor, VFD, dan pelumas industri — cari kode part,
      fungsi, kegunaan, dan kisaran harga dalam satu tempat.
    </p>
    <div class="search-wrap">
      <input
        id="search"
        type="search"
        placeholder="Cari nama, kode part, size, atau kategori..."
        aria-label="Cari sparepart"
        autocomplete="off"
      />
    </div>
  </section>

  <section class="stats" aria-label="Ringkasan direktori">
    <div class="stat">
      <span class="stat-value">{total}</span>
      <span class="stat-label">Sparepart</span>
    </div>
    <div class="stat">
      <span class="stat-value">{categories.length}</span>
      <span class="stat-label">Kategori</span>
    </div>
    <div class="stat">
      <span class="stat-value">{totalEquivalents}</span>
      <span class="stat-label">Cross-Reference</span>
    </div>
  </section>

  <AdSlot slotId="slot-home-atas" />

  <section class="categories" aria-label="Filter kategori">
    {
      categories.map((c) => {
        const theme = getCategoryTheme(c);
        return (
          <button
            class="chip"
            type="button"
            data-category={c.toLowerCase()}
            style={`--chip-bg:${theme.bg}; --chip-fg:${theme.fg};`}
          >
            {c}
          </button>
        );
      })
    }
    <button class="chip chip--reset" type="button" id="reset-filter" hidden>Tampilkan semua</button>
  </section>

  <section class="grid" id="results">
    {
      data.map((item) => {
        const theme = getCategoryTheme(item.category);
        const eqCount = item.equivalent_codes?.length || 0;
        const searchBlob = [
          item.part_name,
          item.part_number,
          item.category,
          item.subcategory,
          item.brand,
          item.size,
          item.fungsi,
          item.kegunaan,
          item.alternative_parts,
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();

        return (
          <a
            class="card"
            href={`/sparepart/${item.slug}/`}
            data-search={searchBlob}
            data-category={item.category.toLowerCase()}
          >
            <div class="card-top">
              <Badge label={item.category} bg={theme.bg} fg={theme.fg} />
              {eqCount > 0 && <span class="eq-count">+{eqCount} setara</span>}
            </div>
            <span class="card-code">{item.part_number}</span>
            <h3>{item.part_name}</h3>
            {item.size && <p class="card-size">{item.size}</p>}
            {item.fungsi && <p class="card-fungsi">{item.fungsi}</p>}
            <div class="card-footer">
              <span class="card-price">{item.price_range || "Harga menyusul"}</span>
              {item.unit && <span class="card-unit">/{item.unit}</span>}
            </div>
          </a>
        );
      })
    }
  </section>

  <p id="empty-state" class="empty-state" hidden>Tidak ada hasil. Coba kata kunci atau kategori lain.</p>

  <script>
    const input = document.getElementById("search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#results .card"));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip--reset)"));
    const resetBtn = document.getElementById("reset-filter") as HTMLButtonElement | null;
    const emptyState = document.getElementById("empty-state");

    function applyFilter(query: string) {
      const q = query.toLowerCase().trim();
      let visibleCount = 0;
      cards.forEach((card) => {
        const match = (card.dataset.search ?? "").includes(q);
        card.style.display = match ? "" : "none";
        if (match) visibleCount++;
      });
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    }

    input?.addEventListener("input", (e) => {
      applyFilter((e.target as HTMLInputElement).value);
      if (resetBtn) resetBtn.hidden = (e.target as HTMLInputElement).value.trim() === "";
    });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const category = chip.dataset.category ?? "";
        if (input) input.value = category;
        applyFilter(category);
        if (resetBtn) resetBtn.hidden = false;
      });
    });

    resetBtn?.addEventListener("click", () => {
      if (input) input.value = "";
      applyFilter("");
      resetBtn.hidden = true;
    });
  </script>

  <style>
    .hero { padding: 2.25rem 0 1rem; }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      color: var(--color-teal);
      text-transform: uppercase;
    }
    .hero h1 {
      font-size: clamp(1.55rem, 4vw, 2.35rem);
      margin-top: 0.45rem;
      max-width: 18ch;
    }
    .hero p { color: var(--color-steel); max-width: 58ch; margin-top: 0.75rem; }
    .search-wrap { margin-top: 1.25rem; max-width: 520px; }
    #search {
      width: 100%;
      padding: 0.85rem 1.1rem;
      border: 1px solid var(--color-line);
      background: #fff;
      font-family: var(--font-body);
      font-size: 1rem;
      border-radius: 2px;
      box-shadow: 0 1px 0 rgba(28, 34, 38, 0.04);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid var(--color-line);
      background: #fff;
      margin: 1.75rem 0;
    }
    .stat {
      padding: 1.1rem 0.75rem;
      text-align: center;
      border-right: 1px solid var(--color-line);
    }
    .stat:last-child { border-right: none; }
    .stat-value {
      display: block;
      font-family: var(--font-mono);
      font-size: 1.55rem;
      font-weight: 600;
      color: var(--color-steel);
    }
    .stat-label {
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      color: var(--color-steel-light);
      text-transform: uppercase;
    }

    .categories { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0 0 1.5rem; }
    .chip {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      padding: 0.4rem 0.8rem;
      border-radius: 999px;
      background: var(--chip-bg, #eceff0);
      color: var(--chip-fg, #3d4a52);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .chip:hover { transform: translateY(-1px); box-shadow: 0 2px 8px rgba(28,34,38,0.08); }
    .chip--reset { background: var(--color-ink); color: #fff; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1rem;
      padding-bottom: 2rem;
    }
    .card {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--color-line);
      background: #fff;
      padding: 1.05rem 1.15rem 1.15rem;
      color: var(--color-ink);
      transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
      min-height: 210px;
    }
    .card:hover {
      border-color: var(--color-amber);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(28, 34, 38, 0.09);
    }
    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 0.55rem;
    }
    .eq-count {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      color: var(--color-teal);
      white-space: nowrap;
    }
    .card-code {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--color-steel-light);
      letter-spacing: 0.04em;
    }
    .card h3 {
      font-size: 1.05rem;
      margin: 0.25rem 0 0.4rem;
      line-height: 1.25;
    }
    .card-size {
      margin: 0 0 0.35rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-steel);
    }
    .card-fungsi {
      margin: 0;
      font-size: 0.82rem;
      color: var(--color-steel-light);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      flex: 1;
    }
    .card-footer {
      margin-top: auto;
      padding-top: 0.85rem;
      display: flex;
      align-items: baseline;
      gap: 0.35rem;
      border-top: 1px solid var(--color-line);
    }
    .card-price {
      font-family: var(--font-mono);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--color-ink);
    }
    .card-unit {
      font-size: 0.72rem;
      color: var(--color-steel-light);
    }
    .empty-state {
      color: var(--color-steel-light);
      text-align: center;
      padding: 2.5rem 0;
    }
  </style>
</Layout>
