  <p class="aff-note">Partpedia is a participant in the Amazon Services LLC Associates Program. As an Amazon Associate we may earn from qualifying purchases. “Cek harga beli” may open Amazon search results.</p>

  <script>
    // Hero auto-rotate 2s
    const slides = Array.from(document.querySelectorAll(".hero-slide"));
    const dotsWrap = document.getElementById("hero-dots");
    let idx = 0;
    slides.forEach((_, i) => {
      const d = document.createElement("button");
      d.type = "button";
      d.className = "dot" + (i === 0 ? " on" : "");
      d.addEventListener("click", () => { idx = i; paint(); });
      dotsWrap?.appendChild(d);
    });
    function paint() {
      slides.forEach((s, i) => s.classList.toggle("active", i === idx));
      dotsWrap?.querySelectorAll(".dot").forEach((d, i) => d.classList.toggle("on", i === idx));
    }
    setInterval(() => { idx = (idx + 1) % slides.length; paint(); }, 2000);

    
    // Wawasan Industri:
    // - Kartu kiri = artikel terbaru (default saat buka halaman)
    // - Geser ke kanan tiap 5 detik (artikel lebih lama)
    // - Maks 10 kartu; setelah kartu terakhir → kembali ke kiri (terbaru)
    const track = document.getElementById("feat-track");
    if (track) {
      let pause = false;
      let cardIndex = 0;
      const cards = () => Array.from(track.querySelectorAll(".feat-card"));

      const goTo = (i, smooth = true) => {
        const list = cards();
        if (!list.length) return;
        const n = list.length;
        // setelah kartu terakhir (paling kanan / paling lama) → kembali ke 0 (terbaru)
        if (i >= n) {
          cardIndex = 0;
          track.scrollTo({ left: 0, behavior: "auto" });
          return;
        }
        if (i < 0) i = 0;
        cardIndex = i;
        const target = list[cardIndex];
        if (!target) return;
        track.scrollTo({
          left: Math.max(0, target.offsetLeft - 8),
          behavior: smooth ? "smooth" : "auto",
        });
      };

      // default: ujung kiri = artikel terbaru
      requestAnimationFrame(() => {
        track.scrollTo({ left: 0, behavior: "auto" });
        cardIndex = 0;
      });

      track.addEventListener("mouseenter", () => { pause = true; });
      track.addEventListener("mouseleave", () => { pause = false; });
      track.addEventListener("touchstart", () => { pause = true; }, { passive: true });
      track.addEventListener("touchend", () => { setTimeout(() => { pause = false; }, 2500); }, { passive: true });

      setInterval(() => {
        if (pause) return;
        if (cards().length < 2) return;
        goTo(cardIndex + 1, true);
      }, 5000);
    }



    
    
    // —— Smart Find (natural language + cross-ref / equivalent) ——
    (function () {
      const ta = document.getElementById("smart-query");
      const btn = document.getElementById("smart-submit");
      const box = document.getElementById("smart-results");
      const status = document.getElementById("smart-status");
      const clearBtn = document.getElementById("smart-clear");
      if (!ta || !btn || !box) return;

      const SYNONYMS = {
        bearing: ["bearing", "bantalan", "ball bearing", "roller", "bantalan bola"],
        bantalan: ["bearing", "bantalan", "ball bearing"],
        dinamo: ["dinamo", "motor listrik", "motor"],
        pompa: ["pompa", "pump", "pompa air"],
        seal: ["seal", "oil seal", "packing", "sealing"],
        belt: ["v-belt", "belt", "sabuk", "fan belt"],
        "v-belt": ["v-belt", "sabuk", "belt"],
        gearbox: ["gearbox", "reducer", "gear reducer", "nmrv"],
        hidrolik: ["hidrolik", "hydraulic", "selang hidrolik"],
        pneumatik: ["pneumatik", "pneumatic", "silinder"],
        sensor: ["sensor", "proximity", "photoelectric"],
        inverter: ["inverter", "vfd", "variable frequency"],
        mobil: ["mobil", "kendaraan", "otomotif"],
        motor: ["motor", "sepeda motor", "kendaraan", "motor listrik"],
        traktor: ["traktor", "pertanian", "alat pertanian"],
        konveyor: ["konveyor", "conveyor"],
        kontaktor: ["kontaktor", "contactor"],
        filter: ["filter", "saringan"],
        baut: ["baut", "mur", "fastener", "hex", "washer"],
        suhu: ["suhu", "temperature", "pt100", "rtd", "thermocouple"],
        tekanan: ["tekanan", "pressure", "gauge"],
        rantai: ["rantai", "chain", "sprocket"],
        kopling: ["kopling", "coupling"],
        valve: ["valve", "katup", "solenoid"],
        plc: ["plc", "otomasi", "kontrol"],
        silinder: ["silinder", "cylinder", "pneumatic"],
        equivalent: ["equivalent", "ekuivalen", "setara", "pengganti", "ganti", "alternatif", "cross", "crossref", "interchange"],
        beli: ["beli", "membeli", "butuh", "cari", "mau", "ingin", "perlu", "order", "purchase", "buy"],
        rusak: ["rusak", "aus", "pecah", "macet", "ganti", "replacement", "broken", "worn"],
        dimensi: ["dimensi", "ukuran", "bore", "od", "tebal", "size", "diameter", "mm", "sama"],
      };

      const BRANDS = ["skf","nsk","ntn","fag","ina","koyo","nachi","timken","asahi","fyh","nok","gates","optibelt","bando","smc","festo","airtac","schneider","abb","siemens","mitsubishi","omron","wika","hiwin","thk","tsubaki","kana","parker","yuken","delta","inovance"];

      function tokens(text) {
        return String(text || "")
          .toLowerCase()
          .replace(/[^a-z0-9à-ÿ.\-\/\s×x]/gi, " ")
          .split(/\s+/)
          .filter((t) => t.length >= 2);
      }

      function extractCodes(text) {
        const t = String(text || "").toUpperCase();
        const found = new Set();
        // 6205-2RS, 6205, UCP204, LC1D09, NMRV-040, A-42, 40-15T, etc.
        const patterns = [
          /\b\d{4}[- ]?(?:2RS1?|2RSR|ZZ|2Z|RS|DDU|LLU|LLB|2NSE)?\b/g,
          /\bUC[A-Z]{0,2}\d{3,4}\b/g,
          /\bLC1D\d{2,3}\b/g,
          /\bNMRV[- ]?\d{2,3}\b/g,
          /\b(?:RS)?\d{2,3}(?:-\d)?\b/g,
          /\b\d{2,3}-\d{1,3}T\b/g,
          /\b[A-Z]{1,3}[-]?\d{2,4}\b/g,
        ];
        patterns.forEach((re) => {
          const m = t.match(re);
          if (m) m.forEach((x) => found.add(x.replace(/\s+/g, "")));
        });
        return [...found].map((x) => x.toLowerCase());
      }

      function expand(terms) {
        const out = new Set();
        terms.forEach((t) => {
          out.add(t);
          Object.keys(SYNONYMS).forEach((k) => {
            if (t.includes(k) || k.includes(t)) {
              SYNONYMS[k].forEach((s) => out.add(s));
            }
          });
          if (t.length >= 5) out.add(t.slice(0, -1));
        });
        return [...out];
      }

      function detectIntent(q, terms) {
        const s = q.toLowerCase();
        return {
          wantBuy: /beli|membeli|butuh|mau |ingin|perlu|order|purchase|buy|cari/.test(s),
          wantEquiv: /equivalent|ekuivalen|setara|pengganti|ganti|alternatif|cross|interchange|habis|tidak punya|ga ada|nggak ada|vendor/.test(s),
          wantDim: /dimensi|ukuran|bore| diameter|od |tebal|size|sama ukuran|dimensi sama/.test(s),
          brands: BRANDS.filter((b) => s.includes(b)),
          categoryHint: null,
        };
      }

      function eqBlob(item) {
        const eq = item.equivalent_codes || [];
        const parts = eq.map((x) => {
          if (typeof x === "string") return x;
          return `${x.brand || ""} ${x.code || ""}`;
        });
        parts.push(item.alternative_parts || "");
        return parts.join(" ").toLowerCase();
      }

      function score(item, expanded, rawTerms, codes, intent) {
        const blob = (item.search_blob || "").toLowerCase();
        const tags = (item.application_tags || []).join(" ").toLowerCase();
        const pn = (item.part_number || "").toLowerCase().replace(/\s+/g, "");
        const name = (item.part_name || "").toLowerCase();
        const cat = (item.category || "").toLowerCase();
        const eq = eqBlob(item);
        const size = (item.size || item.specification || "").toLowerCase();
        let s = 0;

        // Direct part-number / code match (highest)
        codes.forEach((c) => {
          const c2 = c.replace(/-/g, "");
          if (pn.includes(c) || pn.replace(/-/g, "").includes(c2)) s += 28;
          if (eq.includes(c) || eq.replace(/-/g, "").includes(c2)) s += 26;
          if (name.includes(c)) s += 12;
          if (blob.includes(c)) s += 8;
        });

        expanded.forEach((t) => {
          if (t.length < 2) return;
          if (blob.includes(t)) s += 2;
          if (tags.includes(t)) s += 3;
          if (cat.includes(t)) s += 4;
          if (pn.includes(t)) s += 6;
          if (name.includes(t)) s += 4;
          if (eq.includes(t)) s += 5;
          if (size.includes(t)) s += 3;
        });

        let hits = 0;
        rawTerms.forEach((t) => {
          if (blob.includes(t) || eq.includes(t) || tags.includes(t)) hits++;
        });
        s += hits * 2;

        // Intent boosts
        if (intent.wantEquiv) {
          if ((item.equivalent_codes || []).length) s += 6;
          intent.brands.forEach((b) => {
            if (eq.includes(b) || (item.brand || "").toLowerCase().includes(b)) s += 8;
          });
        }
        if (intent.wantDim && size) s += 3;
        if (intent.wantBuy && cat) s += 1;

        // Category keyword soft boost when query is broad ("mau beli bearing")
        const catMap = {
          bearing: "bearing",
          bantalan: "bearing",
          seal: "seal",
          "v-belt": "v-belt",
          sabuk: "v-belt",
          sprocket: "sprocket",
          rantai: "rantai",
          kontaktor: "contactor",
          contactor: "contactor",
          inverter: "inverter",
          vfd: "inverter",
          sensor: "sensor",
          filter: "filter",
          kopling: "kopling",
          valve: "valve",
          silinder: "pneumatic",
          hidrolik: "hidrolik",
        };
        Object.keys(catMap).forEach((k) => {
          if (rawTerms.some((t) => t === k || t.includes(k)) && cat.includes(catMap[k])) s += 10;
        });

        return s;
      }

      function autoSize() {
        ta.style.height = "auto";
        const h = Math.min(Math.max(ta.scrollHeight, 96), 420);
        ta.style.height = h + "px";
      }

      function syncClearBtn() {
        const has = (ta.value || "").trim().length > 0;
        if (clearBtn) clearBtn.hidden = !has;
      }

      function clearResults() {
        box.hidden = true;
        box.innerHTML = "";
        if (status) status.textContent = "";
      }

      function clearAll() {
        ta.value = "";
        autoSize();
        syncClearBtn();
        clearResults();
        ta.focus();
      }

      let catalog = null;
      async function loadCatalog() {
        if (catalog) return catalog;
        const res = await fetch("/smart-catalog.json", { cache: "no-cache" });
        catalog = await res.json();
        return catalog;
      }

      function escapeHtml(s) {
        return String(s || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;");
      }

      function formatEq(item) {
        const eq = item.equivalent_codes || [];
        if (!eq.length) return "";
        const bits = eq.slice(0, 4).map((x) => {
          if (typeof x === "string") return x;
          return `${x.brand || ""} ${x.code || ""}`.trim();
        });
        return bits.filter(Boolean).join(" · ");
      }

      async function run() {
        const q = (ta.value || "").trim();
        if (q.length < 3) {
          box.hidden = false;
          box.innerHTML = `<p class="smart-empty">Tulis minimal beberapa kata, kode part, atau jenis part (bearing, seal…).</p>`;
          if (status) status.textContent = "";
          return;
        }
        btn.disabled = true;
        if (status) status.textContent = "Mencari…";
        try {
          const list = await loadCatalog();
          const rawTerms = tokens(q);
          const expanded = expand(rawTerms);
          const codes = extractCodes(q);
          const intent = detectIntent(q, rawTerms);

          const ranked = list
            .map((item) => ({ item, s: score(item, expanded, rawTerms, codes, intent) }))
            .filter((x) => x.s > 0)
            .sort((a, b) => b.s - a.s);

          if (!ranked.length) {
            box.hidden = false;
            box.innerHTML = `<p class="smart-empty">Belum ketemu yang cocok. Coba sebutkan jenis part, kode (mis. 6205-2RS), merek setara, atau dimensi.</p>`;
            if (status) status.textContent = "0 hasil";
          } else {
            const best = ranked[0].s;
            // equivalent / code queries → tampilkan lebih banyak (sampai 5)
            const maxN = intent.wantEquiv || codes.length ? 5 : 3;
            const minScore = Math.max(4, Math.floor(best * 0.55));
            let picked = ranked.filter((x) => x.s >= minScore).slice(0, maxN);
            if (!picked.length) picked = ranked.slice(0, 1);
            if (picked.length > 1 && picked[1].s < best * 0.4) picked = picked.slice(0, 1);

            if (status) status.textContent = `${picked.length} rekomendasi terbaik`;
            box.hidden = false;
            box.innerHTML = picked
              .map(({ item }) => {
                const tags = (item.application_tags || [])
                  .filter((t) => t && !/^\d/.test(t) && t.length < 40)
                  .slice(0, 5)
                  .map((t) => `<span class="tag">${escapeHtml(t)}</span>`)
                  .join("");
                const eqLine = formatEq(item);
                const eqHtml = eqLine
                  ? `<p class="meta eq-line">Setara: ${escapeHtml(eqLine)}</p>`
                  : "";
                return `<a class="smart-card" href="/sparepart/${escapeHtml(item.slug)}/">
                  <div>
                    <h3>${escapeHtml(item.part_name || item.part_number)}</h3>
                    <p class="meta">${escapeHtml(item.part_number || "")} · ${escapeHtml(item.category || "")} · ${escapeHtml(item.brand || "")}</p>
                    ${eqHtml}
                    <div class="tags">${tags}</div>
                  </div>
                  <div class="price">${escapeHtml(item.price_range || "")}</div>
                </a>`;
              })
              .join("");
          }
        } catch (e) {
          box.hidden = false;
          box.innerHTML = `<p class="smart-empty">Gagal memuat katalog pencarian. Muat ulang halaman.</p>`;
          if (status) status.textContent = "";
        } finally {
          btn.disabled = false;
        }
      }

      btn.addEventListener("click", run);
      clearBtn?.addEventListener("click", clearAll);

      ta.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          run();
        }
      });

      ta.addEventListener("input", () => {
        autoSize();
        syncClearBtn();
        if (!(ta.value || "").trim()) clearResults();
      });

      autoSize();
      syncClearBtn();
    })();

    
// Search / filter — category chip = exact data-category (bukan text search)
    const input = document.getElementById("search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#results .card"));
    const empty = document.getElementById("empty-state");
    const resetBtn = document.getElementById("reset-filter") as HTMLButtonElement | null;
    let activeCategory = "";
    function applyAll() {
      const qq = (input?.value || "").toLowerCase().trim();
      let n = 0;
      cards.forEach((c) => {
        const catOk = !activeCategory || (c.dataset.category || "") === activeCategory;
        const textOk = !qq || (c.dataset.search || "").includes(qq);
        const ok = catOk && textOk;
        c.style.display = ok ? "" : "none";
        if (ok) n++;
      });
      if (empty) empty.hidden = n !== 0;
      if (resetBtn) resetBtn.hidden = !(activeCategory || qq);
    }
    input?.addEventListener("input", () => applyAll());
    document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip-reset)").forEach((chip) => {
      chip.addEventListener("click", () => {
        const cat = (chip.dataset.category || "").toLowerCase();
        activeCategory = activeCategory === cat ? "" : cat;
        document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip-reset)").forEach((x) => x.classList.remove("chip-on"));
        if (activeCategory) chip.classList.add("chip-on");
        applyAll();
      });
    });
    resetBtn?.addEventListener("click", () => {
      activeCategory = "";
      if (input) input.value = "";
      document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip-reset)").forEach((x) => x.classList.remove("chip-on"));
      applyAll();
    });
  </script>

  
