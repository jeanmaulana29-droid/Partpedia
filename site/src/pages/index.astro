---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import Badge from "../components/Badge.astro";
import data from "../data/data.json";
import { getCategoryTheme } from "../utils/theme.js";

const total = data.length;
const categories = [...new Set(data.map((d) => d.category))];
const totalEquivalents = data.reduce((sum, d) => sum + (d.equivalent_codes?.length || 0), 0);
---

<Layout
  title="SparepartBase — Database Harga & Spesifikasi Sparepart Mesin Industri"
  description="Direktori gratis kode part, spesifikasi, harga indikatif, dan kode pengganti/cross-reference antar-brand untuk bearing, v-belt, filter, seal, motor listrik, dan sparepart industri lainnya."
>
  <section class="hero">
    <span class="eyebrow">{total} sparepart terindeks · {totalEquivalents} kode cross-reference</span>
    <h1>Cari kode part, spesifikasi &amp; kode pengganti sparepart mesin dalam hitungan detik.</h1>
    <p>
      Direktori terbuka untuk bearing, v-belt, filter, seal, motor listrik, dan komponen
      industri lainnya — lengkap dengan cross-reference antar-brand untuk mempercepat pencarian.
    </p>
    <input
      id="search"
      type="text"
      placeholder="Cari nama part, kode, atau kategori..."
      aria-label="Cari sparepart"
    />
  </section>

  <section class="stats" aria-label="Ringkasan direktori">
    <div class="stat">
      <span class="stat-value">{total}</span>
      <span class="stat-label">Sparepart</span>
    </div>
    <div class="stat">
      <span class="stat-value">{categories.length}</span>
      <span class="stat-label">Kategori</span>
    </div>
    <div class="stat">
      <span class="stat-value">{totalEquivalents}</span>
      <span class="stat-label">Kode Cross-Reference</span>
    </div>
  </section>

  <AdSlot slotId="slot-home-atas" />

  <section class="categories" aria-label="Kategori sparepart">
    {
      categories.map((c) => {
        const theme = getCategoryTheme(c);
        return (
          <button class="chip" data-category={c.toLowerCase()} style={`--chip-bg:${theme.bg}; --chip-fg:${theme.fg};`}>
            {c}
          </button>
        );
      })
    }
    <button class="chip chip--reset" id="reset-filter" hidden>Tampilkan semua</button>
  </section>

  <section class="grid" id="results">
    {
      data.map((item) => {
        const theme = getCategoryTheme(item.category);
        const eqCount = item.equivalent_codes?.length || 0;
        return (
          <a
            class="card"
            href={`/sparepart/${item.slug}/`}
            data-search={`${item.part_name} ${item.part_number} ${item.category} ${item.brand} ${item.alternative_parts}`.toLowerCase()}
            data-category={item.category.toLowerCase()}
          >
            <div class="card-top">
              <Badge label={item.category} bg={theme.bg} fg={theme.fg} />
              {eqCount > 0 && <span class="eq-count">+{eqCount} kode setara</span>}
            </div>
            <span class="card-code">{item.part_number}</span>
            <h3>{item.part_name}</h3>
            <p class="card-price">{item.price_range}</p>
          </a>
        );
      })
    }
  </section>

  <p id="empty-state" class="empty-state" hidden>Tidak ada hasil yang cocok. Coba kata kunci lain.</p>

  <script>
    const input = document.getElementById("search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#results .card"));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip--reset)"));
    const resetBtn = document.getElementById("reset-filter") as HTMLButtonElement | null;
    const emptyState = document.getElementById("empty-state");

    function applyFilter(query: string) {
      const q = query.toLowerCase().trim();
      let visibleCount = 0;
      cards.forEach((card) => {
        const match = (card.dataset.search ?? "").includes(q);
        card.style.display = match ? "" : "none";
        if (match) visibleCount++;
      });
      if (emptyState) emptyState.hidden = visibleCount !== 0;
    }

    input?.addEventListener("input", (e) => {
      applyFilter((e.target as HTMLInputElement).value);
      if (resetBtn) resetBtn.hidden = (e.target as HTMLInputElement).value.trim() === "";
    });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const category = chip.dataset.category ?? "";
        if (input) input.value = category;
        applyFilter(category);
        if (resetBtn) resetBtn.hidden = false;
      });
    });

    resetBtn?.addEventListener("click", () => {
      if (input) input.value = "";
      applyFilter("");
      resetBtn.hidden = true;
    });
  </script>

  <style>
    .hero { padding: 2rem 0 1rem; }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--color-teal);
    }
    .hero h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); margin-top: 0.4rem; }
    .hero p { color: var(--color-steel); max-width: 55ch; }
    #search {
      width: 100%;
      max-width: 480px;
      padding: 0.75rem 1rem;
      border: 1px solid var(--color-line);
      background: #fff;
      font-family: var(--font-body);
      font-size: 1rem;
      margin-top: 1rem;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      border: 1px solid var(--color-line);
      margin: 1.5rem 0;
    }
    .stat {
      padding: 1rem;
      text-align: center;
      border-right: 1px solid var(--color-line);
    }
    .stat:last-child { border-right: none; }
    .stat-value {
      display: block;
      font-family: var(--font-mono);
      font-size: 1.6rem;
      font-weight: 600;
      color: var(--color-steel);
    }
    .stat-label {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      color: var(--color-steel-light);
      text-transform: uppercase;
    }

    .categories { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0; }
    .chip {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      padding: 0.35rem 0.75rem;
      border-radius: 999px;
      background: var(--chip-bg, #eceff0);
      color: var(--chip-fg, #3d4a52);
      transition: transform 0.15s ease;
    }
    .chip:hover { transform: translateY(-1px); }
    .chip--reset { background: var(--color-ink); color: #fff; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem;
    }
    .card {
      display: block;
      border: 1px solid var(--color-line);
      background: #fff;
      padding: 1rem 1.1rem;
      color: var(--color-ink);
      transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }
    .card:hover {
      border-color: var(--color-amber);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(28, 34, 38, 0.08);
    }
    .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; }
    .eq-count { font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-teal); }
    .card-code {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--color-steel-light);
      letter-spacing: 0.05em;
    }
    .card h3 { font-size: 1.05rem; margin: 0.3rem 0; }
    .card-price { margin: 0; font-size: 0.85rem; color: var(--color-ink); font-family: var(--font-mono); font-weight: 600; }
    .empty-state { color: var(--color-steel-light); text-align: center; padding: 2rem 0; }
  </style>
</Layout>
