---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import Badge from "../components/Badge.astro";
import data from "../data/data.json";
import { loadAllArticles } from "../utils/loadArticles.js";
import shopeeLinks from "../data/shopee-links.json";
import { getCategoryTheme } from "../utils/theme.js";

const total = data.length;
const categories = [...new Set(data.map((d) => d.category))];
const categoryIcon = {
  "Bearing": "⚙️",
  "V-Belt": "🪢",
  "Sprocket": "⭕",
  "Rantai Industri": "🔗",
  "Pulley": "🌀",
  "Kopling": "🔧",
  "Gear Reducer": "🛞",
  "Baut, Mur, & Washer": "🔩",
  "Gasket & Packing": "🟤",
  "Seal": "💍",
  "Valve Industri": "🚰",
  "Pressure Gauge & Transmitter": "⏲️",
  "Flow Meter": "📈",
  "Selang Hidrolik": "〰️",
  "Pneumatic Cylinder": "🛢️",
  "Solenoid Valve": "⚡",
  "Hydraulic Pump": "💧",
  "Fitting & Quick Coupler": "🔌",
  "Filter": "🧺",
  "Motor Listrik": "🔋",
  "PLC": "🖥️",
  "Inverter / VFD": "📶",
  "Sensor Industri": "📡",
  "Contactor & Relay": "🔘",
  "MCB / MCCB / Breaker": "🛡️",
  "Thermal Overload Relay": "🌡️",
  "Linear Guide & Ball Screw": "📏",
  "Thermocouple / RTD": "🔥",
  "Temperature Controller": "🎛️",
};
function iconFor(cat) {
  return categoryIcon[cat] || "📦";
}
const totalEquivalents = data.reduce((sum, d) => sum + (d.equivalent_codes?.length || 0), 0);
const _allInsights = loadAllArticles(); // sort terbaru → terlama di loadArticles
// Carousel: max 10 artikel terbaru (kiri = baru, kanan = lebih lama). Sisanya tidak ikut geser.
const insightArticles = _allInsights.slice(0, 10);
const heroSlides = [
  {
    title: "Industrial parts intelligence",
    sub: "Spek · size · cross-reference · estimasi harga",
    img: "https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=1600&q=80",
  },
  {
    title: "Dari bearing hingga otomasi",
    sub: "Katalog MRO untuk plant, workshop & maintenance",
    img: "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=1600&q=80",
  },
  {
    title: "Cari kode part dalam hitungan detik",
    sub: "Cross-brand equivalents untuk keputusan penggantian lebih cepat",
    img: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1600&q=80",
  },
];
const brands = [{"name": "SKF", "src": "/brands/skf.png"}, {"name": "NSK", "src": "/brands/nsk.png"}, {"name": "NTN", "src": "/brands/ntn.png"}, {"name": "FAG", "src": "/brands/fag.svg"}, {"name": "Timken", "src": "/brands/timken.svg"}, {"name": "KOYO", "src": "/brands/koyo.svg"}, {"name": "NACHI", "src": "/brands/nachi.svg"}, {"name": "Gates", "src": "/brands/gates.png"}, {"name": "Optibelt", "src": "/brands/optibelt.svg"}, {"name": "Siemens", "src": "/brands/siemens.svg"}, {"name": "Schneider", "src": "/brands/schneider.png"}, {"name": "ABB", "src": "/brands/abb.svg"}, {"name": "Omron", "src": "/brands/omron.svg"}, {"name": "SMC", "src": "/brands/smc.png"}, {"name": "Festo", "src": "/brands/festo.png"}, {"name": "Yaskawa", "src": "/brands/yaskawa.png"}, {"name": "Bosch", "src": "/brands/bosch.svg"}, {"name": "Parker", "src": "/brands/parker.svg"}, {"name": "Mitsubishi", "src": "/brands/mitsubishi.ico"}, {"name": "Danfoss", "src": "/brands/danfoss.ico"}];
const categoryImage: Record<string, string> = {
  Bearing: "https://images.unsplash.com/photo-1590959651373-a3db0f38a961?auto=format&fit=crop&w=600&q=70",
  "V-Belt": "https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&w=600&q=70",
  Filter: "https://images.unsplash.com/photo-1615900366914-79a2a0a9b13f?auto=format&fit=crop&w=600&q=70",
  Seal: "https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=600&q=70",
  "Motor Listrik": "https://images.unsplash.com/photo-1565793298595-6a901bc2a8ae?auto=format&fit=crop&w=600&q=70",
  "Gear Reducer": "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600&q=70",
  Sprocket: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=70",
  "Selang Hidrolik": "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=600&q=70",
  Kopling: "https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=600&q=70",
  "Sensor Industri": "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=70",
  PLC: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=600&q=70",
  "Inverter / VFD": "https://images.unsplash.com/photo-1558449028-b53a1269d6b3?auto=format&fit=crop&w=600&q=70",
  "Pelumas Industri": "https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=600&q=70",
  "Alat Ukur": "https://images.unsplash.com/photo-1581092334651-ddf26d9a09d0?auto=format&fit=crop&w=600&q=70",

  "Rantai Industri": "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=70",
  "Pulley": "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600&q=70",
  "Baut, Mur, & Washer": "https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=600&q=70",
  "Gasket & Packing": "https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=600&q=70",
  "Valve Industri": "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=600&q=70",
  "Pressure Gauge & Transmitter": "https://images.unsplash.com/photo-1581092334651-ddf26d9a09d0?auto=format&fit=crop&w=600&q=70",
  "Flow Meter": "https://images.unsplash.com/photo-1581092334651-ddf26d9a09d0?auto=format&fit=crop&w=600&q=70",
  "Pneumatic Cylinder": "https://images.unsplash.com/photo-1565793298595-6a901bc2a8ae?auto=format&fit=crop&w=600&q=70",
  "Solenoid Valve": "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=600&q=70",
  "Hydraulic Pump": "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=600&q=70",
  "Fitting & Quick Coupler": "https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=600&q=70",
  "Contactor & Relay": "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=600&q=70",
  "MCB / MCCB / Breaker": "https://images.unsplash.com/photo-1558449028-b53a1269d6b3?auto=format&fit=crop&w=600&q=70",
  "Thermal Overload Relay": "https://images.unsplash.com/photo-1558449028-b53a1269d6b3?auto=format&fit=crop&w=600&q=70",
  "Linear Guide & Ball Screw": "https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=600&q=70",
  "Thermocouple / RTD": "https://images.unsplash.com/photo-1581092334651-ddf26d9a09d0?auto=format&fit=crop&w=600&q=70",
  "Temperature Controller": "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=70",
  "Rantai Industri": "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=70",
  default: "https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=600&q=70",
};
/** Prioritas: image_url di data.json → /products/{slug}.jpg → gambar kategori */
function imgFor(item) {
  if (item.image_url) return item.image_url;
  // Prefer .jpg; onerror in template also tries .jpeg then .png then category
  if (item.slug) return `/products/${item.slug}.jpg`;
  return categoryImage[item.category] || categoryImage.default;
}
function imgFallback(item) {
  const cat = categoryImage[item.category] || categoryImage.default;
  if (!item.slug) return cat;
  // chain handled in onerror attribute
  return cat;
}
const shopeeMap = shopeeLinks || {};

/** Acak urutan katalog (Fisher–Yates) agar tidak berderet 0001,0002,0003… */
function shuffleCatalog(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
  }
  return a;
}
// Semua produk di beranda: urutan acak tiap build/deploy
const catalog = shuffleCatalog(data);
---

<Layout
  title="Partpedia — Katalog Sparepart Industri, Spek & Kode Pengganti"
  description="Direktori modern sparepart industri: bearing, V-belt, sensor, PLC, VFD, pelumas. Spek, size, estimasi harga & cross-reference untuk MRO dan plant maintenance."
>
  <!-- HERO SLIDER -->
  <section class="hero" aria-label="Banner utama">
    <div class="hero-slider" id="hero-slider">
      {heroSlides.map((s, i) => (
        <div class={`hero-slide ${i === 0 ? "active" : ""}`} style={`background-image:url('${s.img}')`}>
          <div class="hero-overlay">
            <p class="eyebrow">{total}+ parts · {categories.length} categories · live catalog</p>
            <h1>{s.title}</h1>
            <p class="hero-sub">{s.sub}</p>
            <div class="hero-cta">
              <a class="btn btn-primary" href="#catalog" data-i18n="hero_cta1">Jelajahi katalog</a>
              <a class="btn btn-ghost" href="/knowledge/" data-i18n="hero_cta2">Knowledge hub</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="hero-dots" id="hero-dots" aria-hidden="true"></div>
  </section>

  <!-- BRAND STRIP -->
  <section class="brands" id="brands" aria-label="Brand referensi industri">
    <p class="brands-label" data-i18n="brands_label">Referensi lintas merek yang sering dicari di industri</p>
    <div class="brands-track">
      {brands.map((b) => (
        <span class="brand-pill" title={b.name}>
          <img src={b.src} alt={b.name} width="120" height="40" loading="lazy"
            onerror={`this.style.display='none';this.nextElementSibling.style.display='inline'`} />
          <span class="brand-fallback">{b.name}</span>
        </span>
      ))}
      {brands.map((b) => (
        <span class="brand-pill" title={b.name} aria-hidden="true">
          <img src={b.src} alt="" width="120" height="40" loading="lazy"
            onerror={`this.style.display='none';this.nextElementSibling.style.display='inline'`} />
          <span class="brand-fallback">{b.name}</span>
        </span>
      ))}
    </div>
  </section>

  <AdSlot slotId="home-top" />

  <!-- STATS -->
  <section class="stats" aria-label="Ringkasan">
    <div class="stat"><span class="v">{total}</span><span class="l">Parts indexed</span></div>
    <div class="stat"><span class="v">{categories.length}</span><span class="l">Categories</span></div>
    <div class="stat"><span class="v">{totalEquivalents}</span><span class="l">Equivalents</span></div>
    <div class="stat"><span class="v">24/7</span><span class="l">Catalog online</span></div>
  </section>

  <!-- FEATURED CAROUSEL -->
  {insightArticles.length > 0 && (
    <section class="featured" id="insights" aria-label="Wawasan industri">
      <div class="sec-head">
        <h2 data-i18n="insights_title">Wawasan Industri</h2>
        <p data-i18n="insights_sub">Artikel & bacaan seputar part, spek, dan praktik MRO</p>
      </div>
      <div class="feat-track" id="feat-track">
        {insightArticles.map((a) => (
          <a class="feat-card" href={`/knowledge/${a.slug}/`}>
            <div class="feat-img">
              <img src={a.image} alt="" loading="lazy" onerror={`this.onerror=null;this.src='${a.imageFallback}'`} />
            </div>
            <div class="feat-body">
              <h3>{a.title}</h3>
              <p>{a.excerpt}</p>
              <span class="price" data-i18n="insights_read">Baca artikel →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- CATALOG -->
  <section class="catalog" id="catalog">
    <div class="sec-head">
      <h2>Katalog sparepart</h2>
      <p>Cari nama, kode, size, atau kategori</p>
    </div>
    <input id="search" type="search" placeholder="Cari kode part, nama, size, merek…" data-i18n-placeholder="search_ph" aria-label="Cari" />
    <div class="cat-rail-wrap">
      <div class="cat-rail" id="cat-rail" role="list">
        {categories.map((c) => {
          return (
            <button type="button" class="chip cat-item" data-category={c.toLowerCase()} role="listitem" title={c}>
              <span class="cat-icon" aria-hidden="true">{iconFor(c)}</span>
              <span class="cat-label">{c}</span>
            </button>
          );
        })}
      </div>
      <button type="button" class="chip chip-reset" id="reset-filter" hidden>Reset filter</button>
    </div>

    <div class="grid" id="results">
      {catalog.map((item) => {
        const theme = getCategoryTheme(item.category);
        const blob = [
          item.part_name, item.part_number, item.category, item.subcategory,
          item.size, item.fungsi, item.kegunaan, item.brand, item.material,
          item.specification, item.alternative_parts,
          ...(item.equivalent_codes || []),
        ]
          .filter(Boolean).join(" ").toLowerCase();
        const buyQ = encodeURIComponent(item.affiliate_query || `${item.part_number} ${item.part_name}`);
        // Placeholder affiliate: user mengganti tag Amazon/Global Industrial setelah daftar
        const buyUrl = `https://www.amazon.com/s?k=${buyQ}&tag=partpedia29-20`;
        const shopeeUrl =
          (item.slug && shopeeMap[item.slug]) ||
          `https://shopee.co.id/search?keyword=${buyQ}`;
        return (
          <article class="card" data-search={blob} data-category={item.category.toLowerCase()}>
            <a class="card-media" href={`/sparepart/${item.slug}/`} aria-label={item.part_name}>
              <img
                src={imgFor(item)}
                alt={item.part_name}
                loading="lazy"
                onerror={`this.onerror=function(){this.onerror=function(){this.onerror=null;this.src='${categoryImage[item.category] || categoryImage.default}';};this.src='/products/${item.slug}.png';};this.src='/products/${item.slug}.jpeg';`}
              />
            </a>
            <div class="card-body">
              <div class="card-top">
                <Badge label={item.category} bg={theme.bg} fg={theme.fg} />
                {(item.equivalent_codes?.length || 0) > 0 && (
                  <span class="eq">+{item.equivalent_codes.length} setara</span>
                )}
              </div>
              <a href={`/sparepart/${item.slug}/`}>
                <span class="code">{item.part_number}</span>
                <h3>{item.part_name}</h3>
              </a>
              {item.size && <p class="size">{item.size}</p>}
              {item.fungsi && <p class="fungsi">{item.fungsi}</p>}
              <div class="card-foot">
                <span class="price">{item.price_range || "Estimasi menyusul"}</span>
                <div class="buy-links">
                  <a class="buy" href={buyUrl} target="_blank" rel="noopener sponsored nofollow" data-i18n="buy_amazon">
                    Cek di Amazon →
                  </a>
                  <a class="buy buy-shopee" href={shopeeUrl} target="_blank" rel="noopener sponsored nofollow" data-i18n="buy_shopee">
                    Beli di Shopee →
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p id="empty-state" class="empty" hidden data-i18n="empty">Tidak ada hasil.</p>
  </section>

  <AdSlot slotId="home-mid" />

  <!-- WORLD / DISTRIBUTION VISUAL -->
  <section class="map-sec" aria-label="Jaringan industri global">
    <div class="sec-head">
      <h2>Jaringan manufaktur & distribusi</h2>
      <p>Ilustrasi aliran supply chain industri global (konseptual)</p>
    </div>
    <div class="map-frame">
      <img
        src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=1400&q=80"
        alt="Peta dunia — ilustrasi distribusi industri"
        loading="lazy"
      />
      <div class="map-caption">Hub produksi · pelabuhan · pusat MRO — visual inspiratif, bukan peta logistik real-time.</div>
    </div>
  </section>

  <!-- INSIGHTS / LONG-FORM -->
  <section class="insights" id="insights">
    <div class="sec-head">
      <h2>Insight industri</h2>
      <p>Bacaan singkat agar riset part lebih dalam</p>
    </div>
    <div class="insight-grid">
      <a class="insight" href="/knowledge/">
        <h3>10 merek bearing yang paling sering muncul di plant</h3>
        <p>SKF, NSK, NTN, FAG, Timken dan pemain aftermarket — kapan pilih OEM vs setara.</p>
      </a>
      <a class="insight" href="/knowledge/">
        <h3>End-use: dari conveyor FMCG sampai heavy duty</h3>
        <p>Bagaimana satu family bearing dipakai di motor, gearbox, hingga alat berat.</p>
      </a>
      <a class="insight" href="/knowledge/">
        <h3>Sejarah singkat raksasa komponen gerak</h3>
        <p>Dari bengkel abad ke-20 hingga standar ISO yang menyatukan dimensi global.</p>
      </a>
    </div>
  </section>

  <!-- FACTORY IMAGES -->
  <section class="gallery">
    <div class="sec-head">
      <h2>Suasana pabrik & maintenance</h2>
    </div>
    <div class="gallery-grid">
      <img src="https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=800&q=75" alt="Lantai produksi industri" loading="lazy" />
      <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=800&q=75" alt="Mesin pabrik modern" loading="lazy" />
      <img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=800&q=75" alt="Teknisi maintenance" loading="lazy" />
    </div>
  </section>

  <!-- VIDEO -->
  <section class="video-sec">
    <div class="sec-head">
      <h2>Video edukasi industri</h2>
      <p>Embed publik dari YouTube (konten pihak ketiga)</p>
    </div>
    <div class="video-wrap">
      <iframe
        src="https://www.youtube.com/embed/YqZQ7K1yQbE"
        title="Industrial manufacturing overview"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  </section>

  <!-- TESTIMONIALS (generic professionals — not fake brand endorsements) -->
  <section class="testimonials">
    <div class="sec-head">
      <h2>Suara praktisi MRO</h2>
      <p>Kutipan ilustratif dari persona maintenance (bukan endorsement resmi merek)</p>
    </div>
    <div class="t-grid">
      <blockquote>
        <p>“Cross-reference menghemat waktu saat part OEM lead-time-nya panjang.”</p>
        <footer>— Andi P., Reliability Tech · Indonesia</footer>
      </blockquote>
      <blockquote>
        <p>“Size dan kode setara di satu halaman mempercepat decision di shift malam.”</p>
        <footer>— Mira S., Plant Supervisor · Malaysia</footer>
      </blockquote>
      <blockquote>
        <p>“Estimasi harga cukup untuk budgeting awal sebelum RFQ ke vendor.”</p>
        <footer>— Kenji T., Procurement · Japan</footer>
      </blockquote>
    </div>
  </section>

  <p class="aff-note">Partpedia is a participant in the Amazon Services LLC Associates Program. As an Amazon Associate we may earn from qualifying purchases. “Cek harga beli” may open Amazon search results.</p>
  <AdSlot slotId="home-bottom" />

  <script>
    // Hero auto-rotate 2s
    const slides = Array.from(document.querySelectorAll(".hero-slide"));
    const dotsWrap = document.getElementById("hero-dots");
    let idx = 0;
    slides.forEach((_, i) => {
      const d = document.createElement("button");
      d.type = "button";
      d.className = "dot" + (i === 0 ? " on" : "");
      d.addEventListener("click", () => { idx = i; paint(); });
      dotsWrap?.appendChild(d);
    });
    function paint() {
      slides.forEach((s, i) => s.classList.toggle("active", i === idx));
      dotsWrap?.querySelectorAll(".dot").forEach((d, i) => d.classList.toggle("on", i === idx));
    }
    setInterval(() => { idx = (idx + 1) % slides.length; paint(); }, 2000);

    
    // Wawasan Industri:
    // - Kartu kiri = artikel terbaru (default saat buka halaman)
    // - Geser ke kanan tiap 3 detik (artikel lebih lama)
    // - Maks 10 kartu; setelah kartu terakhir → kembali ke kiri (terbaru)
    const track = document.getElementById("feat-track");
    if (track) {
      let pause = false;
      let cardIndex = 0;
      const cards = () => Array.from(track.querySelectorAll(".feat-card"));

      const goTo = (i, smooth = true) => {
        const list = cards();
        if (!list.length) return;
        const n = list.length;
        // setelah kartu terakhir (paling kanan / paling lama) → kembali ke 0 (terbaru)
        if (i >= n) {
          cardIndex = 0;
          track.scrollTo({ left: 0, behavior: "auto" });
          return;
        }
        if (i < 0) i = 0;
        cardIndex = i;
        const target = list[cardIndex];
        if (!target) return;
        track.scrollTo({
          left: Math.max(0, target.offsetLeft - 8),
          behavior: smooth ? "smooth" : "auto",
        });
      };

      // default: ujung kiri = artikel terbaru
      requestAnimationFrame(() => {
        track.scrollTo({ left: 0, behavior: "auto" });
        cardIndex = 0;
      });

      track.addEventListener("mouseenter", () => { pause = true; });
      track.addEventListener("mouseleave", () => { pause = false; });
      track.addEventListener("touchstart", () => { pause = true; }, { passive: true });
      track.addEventListener("touchend", () => { setTimeout(() => { pause = false; }, 2500); }, { passive: true });

      setInterval(() => {
        if (pause) return;
        if (cards().length < 2) return;
        goTo(cardIndex + 1, true);
      }, 3000);
    }



    // Search / filter — category chip = exact data-category (bukan text search)
    const input = document.getElementById("search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#results .card"));
    const empty = document.getElementById("empty-state");
    const resetBtn = document.getElementById("reset-filter") as HTMLButtonElement | null;
    let activeCategory = "";
    function applyAll() {
      const qq = (input?.value || "").toLowerCase().trim();
      let n = 0;
      cards.forEach((c) => {
        const catOk = !activeCategory || (c.dataset.category || "") === activeCategory;
        const textOk = !qq || (c.dataset.search || "").includes(qq);
        const ok = catOk && textOk;
        c.style.display = ok ? "" : "none";
        if (ok) n++;
      });
      if (empty) empty.hidden = n !== 0;
      if (resetBtn) resetBtn.hidden = !(activeCategory || qq);
    }
    input?.addEventListener("input", () => applyAll());
    document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip-reset)").forEach((chip) => {
      chip.addEventListener("click", () => {
        const cat = (chip.dataset.category || "").toLowerCase();
        activeCategory = activeCategory === cat ? "" : cat;
        document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip-reset)").forEach((x) => x.classList.remove("chip-on"));
        if (activeCategory) chip.classList.add("chip-on");
        applyAll();
      });
    });
    resetBtn?.addEventListener("click", () => {
      activeCategory = "";
      if (input) input.value = "";
      document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip-reset)").forEach((x) => x.classList.remove("chip-on"));
      applyAll();
    });
  </script>

