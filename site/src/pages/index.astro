                <span>Smart Tools</span>
                <span class="btn-tools-badge">Utilitas</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="hero-dots" id="hero-dots" aria-hidden="true"></div>
  </section>


  
