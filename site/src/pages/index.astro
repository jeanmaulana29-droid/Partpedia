};
/** Prioritas: image_url di data.json → /products/{slug}.jpg → gambar kategori */
function imgFor(item) {
  if (item.image_url) return item.image_url;
  // Prefer .jpg; onerror in template also tries .jpeg then .png then category
  if (item.slug) return `/products/${item.slug}.jpg`;
  return categoryImage[item.category] || categoryImage.default;
}
function imgFallback(item) {
  const cat = categoryImage[item.category] || categoryImage.default;
  if (!item.slug) return cat;
  // chain handled in onerror attribute
  return cat;
}
const shopeeMap = shopeeLinks || {};

/** Acak urutan katalog (Fisher–Yates) agar tidak berderet 0001,0002,0003… */
function shuffleCatalog(arr) {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
  }
  return a;
}
// Semua produk di beranda: urutan acak tiap build/deploy
const catalog = shuffleCatalog(data);
