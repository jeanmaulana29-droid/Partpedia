---
import Layout from "../layouts/Layout.astro";
import AdSlot from "../components/AdSlot.astro";
import Badge from "../components/Badge.astro";
import data from "../data/data.json";
import shopeeLinks from "../data/shopee-links.json";
import { getCategoryTheme } from "../utils/theme.js";

const total = data.length;
const categories = [...new Set(data.map((d) => d.category))];
const totalEquivalents = data.reduce((sum, d) => sum + (d.equivalent_codes?.length || 0), 0);
const featured = data.filter((d) => d.equivalent_codes?.length).slice(0, 8);
const heroSlides = [
  {
    title: "Industrial parts intelligence",
    sub: "Spek · size · cross-reference · estimasi harga",
    img: "https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=1600&q=80",
  },
  {
    title: "Dari bearing hingga otomasi",
    sub: "Katalog MRO untuk plant, workshop & maintenance",
    img: "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=1600&q=80",
  },
  {
    title: "Cari kode part dalam hitungan detik",
    sub: "Cross-brand equivalents untuk keputusan penggantian lebih cepat",
    img: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=1600&q=80",
  },
];
const brands = ["SKF", "NSK", "NTN", "FAG", "Timken", "KOYO", "NACHI", "Gates", "Optibelt", "Siemens", "Schneider", "ABB"];
const categoryImage: Record<string, string> = {
  Bearing: "https://images.unsplash.com/photo-1590959651373-a3db0f38a961?auto=format&fit=crop&w=600&q=70",
  "V-Belt": "https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&w=600&q=70",
  Filter: "https://images.unsplash.com/photo-1615900366914-79a2a0a9b13f?auto=format&fit=crop&w=600&q=70",
  Seal: "https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&w=600&q=70",
  "Motor Listrik": "https://images.unsplash.com/photo-1565793298595-6a901bc2a8ae?auto=format&fit=crop&w=600&q=70",
  "Gear Reducer": "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600&q=70",
  Sprocket: "https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=70",
  "Selang Hidrolik": "https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=600&q=70",
  Kopling: "https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=600&q=70",
  "Sensor Industri": "https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=70",
  PLC: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?auto=format&fit=crop&w=600&q=70",
  "Inverter / VFD": "https://images.unsplash.com/photo-1558449028-b53a1269d6b3?auto=format&fit=crop&w=600&q=70",
  "Pelumas Industri": "https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=600&q=70",
  "Alat Ukur": "https://images.unsplash.com/photo-1581092334651-ddf26d9a09d0?auto=format&fit=crop&w=600&q=70",
  default: "https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=600&q=70",
};
/** Prioritas: image_url di data.json → /products/{slug}.jpg → gambar kategori */
function imgFor(item: { category: string; slug?: string; image_url?: string }) {
  if (item.image_url) return item.image_url;
  if (item.slug) return `/products/${item.slug}.jpg`;
  return categoryImage[item.category] || categoryImage.default;
}
---

<Layout
  title="Partpedia — Katalog Sparepart Industri, Spek & Kode Pengganti"
  description="Direktori modern sparepart industri: bearing, V-belt, sensor, PLC, VFD, pelumas. Spek, size, estimasi harga & cross-reference untuk MRO dan plant maintenance."
>
  <!-- HERO SLIDER -->
  <section class="hero" aria-label="Banner utama">
    <div class="hero-slider" id="hero-slider">
      {heroSlides.map((s, i) => (
        <div class={`hero-slide ${i === 0 ? "active" : ""}`} style={`background-image:url('${s.img}')`}>
          <div class="hero-overlay">
            <p class="eyebrow">{total}+ parts · {categories.length} categories · live catalog</p>
            <h1>{s.title}</h1>
            <p class="hero-sub">{s.sub}</p>
            <div class="hero-cta">
              <a class="btn btn-primary" href="#catalog">Jelajahi katalog</a>
              <a class="btn btn-ghost" href="/knowledge/">Knowledge hub</a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="hero-dots" id="hero-dots" aria-hidden="true"></div>
  </section>

  <!-- BRAND STRIP -->
  <section class="brands" id="brands" aria-label="Brand referensi industri">
    <p class="brands-label">Referensi lintas merek yang sering dicari di industri</p>
    <div class="brands-track">
      {brands.map((b) => <span class="brand-pill">{b}</span>)}
      {brands.map((b) => <span class="brand-pill" aria-hidden="true">{b}</span>)}
    </div>
  </section>

  <AdSlot slotId="home-top" />

  <!-- STATS -->
  <section class="stats" aria-label="Ringkasan">
    <div class="stat"><span class="v">{total}</span><span class="l">Parts indexed</span></div>
    <div class="stat"><span class="v">{categories.length}</span><span class="l">Categories</span></div>
    <div class="stat"><span class="v">{totalEquivalents}</span><span class="l">Equivalents</span></div>
    <div class="stat"><span class="v">24/7</span><span class="l">Catalog online</span></div>
  </section>

  <!-- FEATURED CAROUSEL -->
  {featured.length > 0 && (
    <section class="featured" aria-label="Part unggulan">
      <div class="sec-head">
        <h2>Featured cross-reference</h2>
        <p>Part dengan data ekuivalen antar-brand</p>
      </div>
      <div class="feat-track" id="feat-track">
        {featured.map((item) => {
          const theme = getCategoryTheme(item.category);
          return (
            <a class="feat-card" href={`/sparepart/${item.slug}/`}>
              <div class="feat-img" style={`background-image:url('${imgFor(item)}')`} />
              <div class="feat-body">
                <Badge label={item.category} bg={theme.bg} fg={theme.fg} />
                <h3>{item.part_number}</h3>
                <p>{item.part_name}</p>
                <span class="price">{item.price_range || "Cek vendor"}</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- CATALOG -->
  <section class="catalog" id="catalog">
    <div class="sec-head">
      <h2>Katalog sparepart</h2>
      <p>Cari nama, kode, size, atau kategori</p>
    </div>
    <input id="search" type="search" placeholder="Cari bearing 6205, V-belt, sensor, PLC..." aria-label="Cari" />
    <div class="categories">
      {categories.map((c) => {
        const theme = getCategoryTheme(c);
        return (
          <button type="button" class="chip" data-category={c.toLowerCase()} style={`--chip-bg:${theme.bg};--chip-fg:${theme.fg};`}>
            {c}
          </button>
        );
      })}
      <button type="button" class="chip chip-reset" id="reset-filter" hidden>Reset</button>
    </div>

    <div class="grid" id="results">
      {data.map((item) => {
        const theme = getCategoryTheme(item.category);
        const blob = [item.part_name, item.part_number, item.category, item.size, item.fungsi, item.kegunaan, item.brand]
          .filter(Boolean).join(" ").toLowerCase();
        const buyQ = encodeURIComponent(item.affiliate_query || `${item.part_number} ${item.part_name}`);
        // Placeholder affiliate: user mengganti tag Amazon/Global Industrial setelah daftar
        const buyUrl = `https://www.amazon.com/s?k=${buyQ}&tag=partpedia29-20`;
        const shopeeMap = shopeeLinks as Record<string, string>;
        const shopeeUrl =
          (item.slug && shopeeMap[item.slug]) ||
          `https://shopee.co.id/search?keyword=${buyQ}`;
        return (
          <article class="card" data-search={blob} data-category={item.category.toLowerCase()}>
            <a class="card-media" href={`/sparepart/${item.slug}/`} aria-label={item.part_name}>
              <img
                src={imgFor(item)}
                alt={item.part_name}
                loading="lazy"
                onerror={`this.onerror=null;this.src='${categoryImage[item.category] || categoryImage.default}';`}
              />
            </a>
            <div class="card-body">
              <div class="card-top">
                <Badge label={item.category} bg={theme.bg} fg={theme.fg} />
                {(item.equivalent_codes?.length || 0) > 0 && (
                  <span class="eq">+{item.equivalent_codes.length} setara</span>
                )}
              </div>
              <a href={`/sparepart/${item.slug}/`}>
                <span class="code">{item.part_number}</span>
                <h3>{item.part_name}</h3>
              </a>
              {item.size && <p class="size">{item.size}</p>}
              {item.fungsi && <p class="fungsi">{item.fungsi}</p>}
              <div class="card-foot">
                <span class="price">{item.price_range || "Estimasi menyusul"}</span>
                <div class="buy-links">
                  <a class="buy" href={buyUrl} target="_blank" rel="noopener sponsored nofollow">
                    Cek di Amazon →
                  </a>
                  <a class="buy buy-shopee" href={shopeeUrl} target="_blank" rel="noopener sponsored nofollow">
                    Beli di Shopee →
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p id="empty-state" class="empty" hidden>Tidak ada hasil.</p>
  </section>

  <AdSlot slotId="home-mid" />

  <!-- WORLD / DISTRIBUTION VISUAL -->
  <section class="map-sec" aria-label="Jaringan industri global">
    <div class="sec-head">
      <h2>Jaringan manufaktur & distribusi</h2>
      <p>Ilustrasi aliran supply chain industri global (konseptual)</p>
    </div>
    <div class="map-frame">
      <img
        src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=1400&q=80"
        alt="Peta dunia — ilustrasi distribusi industri"
        loading="lazy"
      />
      <div class="map-caption">Hub produksi · pelabuhan · pusat MRO — visual inspiratif, bukan peta logistik real-time.</div>
    </div>
  </section>

  <!-- INSIGHTS / LONG-FORM -->
  <section class="insights" id="insights">
    <div class="sec-head">
      <h2>Insight industri</h2>
      <p>Bacaan singkat agar riset part lebih dalam</p>
    </div>
    <div class="insight-grid">
      <a class="insight" href="/knowledge/">
        <h3>10 merek bearing yang paling sering muncul di plant</h3>
        <p>SKF, NSK, NTN, FAG, Timken dan pemain aftermarket — kapan pilih OEM vs setara.</p>
      </a>
      <a class="insight" href="/knowledge/">
        <h3>End-use: dari conveyor FMCG sampai heavy duty</h3>
        <p>Bagaimana satu family bearing dipakai di motor, gearbox, hingga alat berat.</p>
      </a>
      <a class="insight" href="/knowledge/">
        <h3>Sejarah singkat raksasa komponen gerak</h3>
        <p>Dari bengkel abad ke-20 hingga standar ISO yang menyatukan dimensi global.</p>
      </a>
    </div>
  </section>

  <!-- FACTORY IMAGES -->
  <section class="gallery">
    <div class="sec-head">
      <h2>Suasana pabrik & maintenance</h2>
    </div>
    <div class="gallery-grid">
      <img src="https://images.unsplash.com/photo-1565043589221-1a6fd9ae45c7?auto=format&fit=crop&w=800&q=75" alt="Lantai produksi industri" loading="lazy" />
      <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=800&q=75" alt="Mesin pabrik modern" loading="lazy" />
      <img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=800&q=75" alt="Teknisi maintenance" loading="lazy" />
    </div>
  </section>

  <!-- VIDEO -->
  <section class="video-sec">
    <div class="sec-head">
      <h2>Video edukasi industri</h2>
      <p>Embed publik dari YouTube (konten pihak ketiga)</p>
    </div>
    <div class="video-wrap">
      <iframe
        src="https://www.youtube.com/embed/YqZQ7K1yQbE"
        title="Industrial manufacturing overview"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  </section>

  <!-- TESTIMONIALS (generic professionals — not fake brand endorsements) -->
  <section class="testimonials">
    <div class="sec-head">
      <h2>Suara praktisi MRO</h2>
      <p>Kutipan ilustratif dari persona maintenance (bukan endorsement resmi merek)</p>
    </div>
    <div class="t-grid">
      <blockquote>
        <p>“Cross-reference menghemat waktu saat part OEM lead-time-nya panjang.”</p>
        <footer>— Andi P., Reliability Tech · Indonesia</footer>
      </blockquote>
      <blockquote>
        <p>“Size dan kode setara di satu halaman mempercepat decision di shift malam.”</p>
        <footer>— Mira S., Plant Supervisor · Malaysia</footer>
      </blockquote>
      <blockquote>
        <p>“Estimasi harga cukup untuk budgeting awal sebelum RFQ ke vendor.”</p>
        <footer>— Kenji T., Procurement · Japan</footer>
      </blockquote>
    </div>
  </section>

  <p class="aff-note">Partpedia is a participant in the Amazon Services LLC Associates Program. As an Amazon Associate we may earn from qualifying purchases. “Cek harga beli” may open Amazon search results.</p>
  <AdSlot slotId="home-bottom" />

  <script>
    // Hero auto-rotate 2s
    const slides = Array.from(document.querySelectorAll(".hero-slide"));
    const dotsWrap = document.getElementById("hero-dots");
    let idx = 0;
    slides.forEach((_, i) => {
      const d = document.createElement("button");
      d.type = "button";
      d.className = "dot" + (i === 0 ? " on" : "");
      d.addEventListener("click", () => { idx = i; paint(); });
      dotsWrap?.appendChild(d);
    });
    function paint() {
      slides.forEach((s, i) => s.classList.toggle("active", i === idx));
      dotsWrap?.querySelectorAll(".dot").forEach((d, i) => d.classList.toggle("on", i === idx));
    }
    setInterval(() => { idx = (idx + 1) % slides.length; paint(); }, 2000);

    // Featured horizontal auto-scroll gentle
    const track = document.getElementById("feat-track");
    if (track) {
      setInterval(() => {
        track.scrollBy({ left: 280, behavior: "smooth" });
        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
          track.scrollTo({ left: 0, behavior: "smooth" });
        }
      }, 3200);
    }

    // Search / filter
    const input = document.getElementById("search") as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#results .card"));
    const empty = document.getElementById("empty-state");
    const resetBtn = document.getElementById("reset-filter") as HTMLButtonElement | null;
    function apply(q: string) {
      const qq = q.toLowerCase().trim();
      let n = 0;
      cards.forEach((c) => {
        const ok = (c.dataset.search || "").includes(qq);
        c.style.display = ok ? "" : "none";
        if (ok) n++;
      });
      if (empty) empty.hidden = n !== 0;
    }
    input?.addEventListener("input", (e) => {
      apply((e.target as HTMLInputElement).value);
      if (resetBtn) resetBtn.hidden = !(e.target as HTMLInputElement).value.trim();
    });
    document.querySelectorAll<HTMLButtonElement>(".chip:not(.chip-reset)").forEach((chip) => {
      chip.addEventListener("click", () => {
        const cat = chip.dataset.category || "";
        if (input) input.value = cat;
        apply(cat);
        if (resetBtn) resetBtn.hidden = false;
      });
    });
    resetBtn?.addEventListener("click", () => { if (input) input.value = ""; apply(""); resetBtn.hidden = true; });
  </script>

  <style>
    .hero { position: relative; margin: 1.25rem 0 1.5rem; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); }
    .hero-slider { position: relative; min-height: 360px; }
    .hero-slide {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      opacity: 0; transition: opacity 0.6s ease;
    }
    .hero-slide.active { opacity: 1; z-index: 1; }
    .hero-overlay {
      position: absolute; inset: 0; z-index: 2;
      background: linear-gradient(120deg, rgba(8,12,18,0.92) 0%, rgba(8,12,18,0.55) 55%, rgba(8,12,18,0.25) 100%);
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: 2rem 1.75rem 2.25rem;
    }
    .eyebrow { font-family: var(--font-mono); font-size: 0.72rem; color: var(--teal); letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.5rem; }
    .hero h1 { font-size: clamp(1.8rem, 4.5vw, 2.8rem); max-width: 14ch; margin-bottom: 0.4rem; }
    .hero-sub { color: var(--muted); max-width: 36ch; margin: 0 0 1.1rem; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .hero-dots { position: absolute; bottom: 0.9rem; right: 1rem; z-index: 3; display: flex; gap: 0.35rem; }
    .dot { width: 8px; height: 8px; border-radius: 99px; border: none; background: rgba(255,255,255,0.35); cursor: pointer; padding: 0; }
    .dot.on { background: var(--amber); width: 18px; }

    .brands { margin: 1.5rem 0 2rem; overflow: hidden; }
    .brands-label { text-align: center; color: var(--muted); font-size: 0.8rem; margin-bottom: 0.85rem; }
    .brands-track { display: flex; gap: 0.65rem; width: max-content; animation: marquee 28s linear infinite; }
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .brand-pill {
      font-family: var(--font-display); font-weight: 700; font-size: 0.95rem;
      padding: 0.55rem 1rem; border-radius: 999px;
      border: 1px solid var(--line); background: var(--bg-elevated); color: var(--ink);
      white-space: nowrap; opacity: 0.85;
    }

    .stats {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); } }
    .stat {
      background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius);
      padding: 1rem; text-align: center;
    }
    .stat .v { display: block; font-family: var(--font-mono); font-size: 1.45rem; font-weight: 600; color: var(--amber); }
    .stat .l { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }

    .sec-head { margin: 2rem 0 1rem; }
    .sec-head h2 { font-size: 1.45rem; }
    .sec-head p { color: var(--muted); margin: 0; }

    .feat-track {
      display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem; -webkit-overflow-scrolling: touch;
    }
    .feat-card {
      flex: 0 0 260px; scroll-snap-align: start;
      background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius);
      overflow: hidden; color: var(--ink);
    }
    .feat-img { height: 120px; background-size: cover; background-position: center; }
    .feat-body { padding: 0.9rem 1rem 1.1rem; }
    .feat-body h3 { font-size: 1.05rem; margin: 0.4rem 0 0.15rem; font-family: var(--font-mono); }
    .feat-body p { margin: 0 0 0.5rem; color: var(--muted); font-size: 0.85rem; }
    .feat-body .price { font-family: var(--font-mono); font-size: 0.82rem; color: var(--amber); }

    #search {
      width: 100%; max-width: 520px;
      padding: 0.85rem 1.1rem; border-radius: 12px;
      border: 1px solid var(--line); background: var(--bg-elevated); color: var(--ink);
      font-size: 1rem; margin-bottom: 0.9rem;
    }
    .categories { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.25rem; }
    .chip {
      font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600;
      border: none; cursor: pointer; padding: 0.4rem 0.8rem; border-radius: 999px;
      background: var(--chip-bg, #243040); color: var(--chip-fg, #d7e0ea);
    }
    .chip-reset { background: var(--ink); color: var(--bg); }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1rem;
    }
    .card {
      background: var(--bg-card); border: 1px solid var(--line); border-radius: var(--radius);
      overflow: hidden; display: flex; flex-direction: column;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .card:hover { border-color: rgba(240,164,58,0.45); transform: translateY(-2px); }
    .card-media {
      display: block; height: 140px; overflow: hidden; background: #0e141c;
    }
    .card-media img {
      width: 100%; height: 100%; object-fit: cover;
      filter: saturate(1.05) contrast(1.05);
    }
    .card-body { padding: 0.95rem 1rem 1.1rem; display: flex; flex-direction: column; flex: 1; }
    .card-top { display: flex; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.45rem; }
    .eq { font-family: var(--font-mono); font-size: 0.68rem; color: var(--teal); }
    .code { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); }
    .card h3 { font-size: 1.02rem; margin: 0.2rem 0 0.35rem; color: var(--ink); }
    .size { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; color: var(--teal); }
    .fungsi {
      margin: 0.35rem 0 0; font-size: 0.82rem; color: var(--muted);
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      flex: 1;
    }
    .card-foot {
      margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px solid var(--line);
      display: flex; flex-direction: column; gap: 0.35rem;
    }
    .price { font-family: var(--font-mono); font-weight: 600; font-size: 0.88rem; color: var(--amber); }
    .buy { font-size: 0.82rem; font-weight: 600; color: var(--blue); }
    .buy-links { display: flex; flex-direction: column; gap: 0.28rem; margin-top: 0.15rem; }
    .buy-shopee { color: #ee4d2d !important; font-weight: 700; }
