---
interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="id">
<!-- content bilingual-friendly; toggle sets lang attribute -->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="Partpedia" />
    <meta name="apple-mobile-web-app-title" content="Partpedia" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="keywords" content="sparepart industri, bearing, V-belt, PLC, sensor industri, kode part, cross reference, harga sparepart, industrial parts, MRO, maintenance repair operations, gearbox, seal, filter hidrolik" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Partpedia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-default.png", Astro.site).toString()} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={new URL("/icon-192.png", Astro.site).toString()} />
    <meta name="robots" content="index, follow" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Partpedia",
      "alternateName": ["Partpedia Industrial Parts", "Partpedia Katalog Sparepart"],
      "url": "https://partpedia.vercel.app/",
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "Partpedia",
        "url": "https://partpedia.vercel.app/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://partpedia.vercel.app/icon-512.png"
        }
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://partpedia.vercel.app/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --bg: #0b0f14;
        --bg-elevated: #121820;
        --bg-card: #161d27;
        --ink: #eef2f6;
        --muted: #8b9aab;
        --line: rgba(255,255,255,0.08);
        --amber: #f0a43a;
        --amber-soft: rgba(240,164,58,0.15);
        --teal: #3dcfb6;
        --teal-soft: rgba(61,207,182,0.12);
        --blue: #5b9fd4;
        --danger: #ff6b6b;
        --font-display: "Syne", system-ui, sans-serif;
        --font-body: "DM Sans", system-ui, sans-serif;
        --font-mono: "JetBrains Mono", ui-monospace, monospace;
        --radius: 14px;
        --shadow: 0 20px 50px rgba(0,0,0,0.35);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: 1.6;
        min-height: 100vh;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;
        background:
          radial-gradient(1200px 600px at 10% -10%, rgba(61,207,182,0.12), transparent 55%),
          radial-gradient(900px 500px at 90% 0%, rgba(240,164,58,0.10), transparent 50%),
          radial-gradient(800px 400px at 50% 100%, rgba(91,159,212,0.08), transparent 45%);
      }
      h1,h2,h3,h4 { font-family: var(--font-display); line-height: 1.15; margin: 0 0 0.5em; }
      a { color: var(--teal); text-decoration: none; }
      a:hover { color: var(--amber); }
      a:focus-visible, button:focus-visible, input:focus-visible {
        outline: 2px solid var(--amber);
        outline-offset: 2px;
      }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 1.25rem; }
      
      .site-header {
        position: sticky; top: 0; z-index: 50;
        backdrop-filter: blur(14px);
        background: rgba(11,15,20,0.92);
        border-bottom: 1px solid var(--line);
      }
      .site-header .wrap {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding-top: 0.65rem;
        padding-bottom: 0.55rem;
        height: auto;
        min-height: 0;
      }
      .header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }
      .brand {
        font-family: var(--font-display); font-weight: 800; font-size: 1.15rem;
        letter-spacing: -0.02em; color: var(--ink);
        display: inline-flex; align-items: center; gap: 0.45rem;
        text-decoration: none;
      }
      .brand-logo { border-radius: 6px; display: block; }
      .brand span { color: var(--amber); }
      .nav {
        display: flex;
        gap: 0.4rem;
        align-items: center;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding: 0.45rem 0 0.15rem;
        margin: 0 -0.15rem;
      }
      .nav::-webkit-scrollbar { display: none; }
      .nav a {
        flex: 0 0 auto;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--bg-elevated);
        white-space: nowrap;
      }
      .nav a:hover { color: var(--ink); border-color: var(--amber); }
      .lang-btn {

        font-family: var(--font-mono);
        font-size: 0.7rem;
        border: 1px solid var(--line);
        background: var(--bg-elevated);
        color: var(--muted);
        padding: 0.35rem 0.55rem;
        border-radius: 999px;
        cursor: pointer;
      }
      @media (min-width: 768px) {
        .site-header .wrap {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
          height: 64px;
          padding-top: 0;
          padding-bottom: 0;
        }
        .header-row { flex: 1; }
        .nav {
          overflow: visible;
          padding: 0;
          margin: 0;
          gap: 0.35rem 0.5rem;
        }
        .nav a {
          border: none;
          background: transparent;
          font-size: 0.9rem;
          padding: 0.25rem 0.45rem;
        }
      }

      .site-footer {
        margin-top: 4rem;
        border-top: 1px solid var(--line);
        padding: 2.5rem 0 2rem;
        color: var(--muted);
        font-size: 0.88rem;
      }
      .site-footer .wrap { display: grid; gap: 1rem; }
      .site-footer strong { color: var(--ink); }
      .footer-links { display: flex; flex-wrap: wrap; gap: 0.85rem 1.15rem; }
      .footer-links a { color: var(--muted); font-size: 0.88rem; }
      .footer-links a:hover { color: var(--amber); }
      .footer-aff { color: var(--muted); font-size: 0.8rem; line-height: 1.45; max-width: 52rem; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
        font-weight: 600; font-size: 0.9rem;
        padding: 0.7rem 1.15rem; border-radius: 999px;
        border: none; cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: linear-gradient(135deg, var(--amber), #e08a1a);
        color: #1a1205;
        box-shadow: 0 8px 24px rgba(240,164,58,0.25);
      }
      .btn-ghost {
        background: transparent;
        border: 1px solid var(--line);
        color: var(--ink);
      }
      /* soft first-visit promo — dismissible, not hard interstitial */
      
      
      @keyframes slideUp {
        from { transform: translateY(16px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      
    </style>
    <!-- Vercel Web Analytics (aktifkan dulu di dashboard Vercel → Analytics) -->
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="header-row">
          <a class="brand" href="/">
            <img src="/logo.png" alt="Partpedia" width="28" height="28" class="brand-logo" />
            Part<span>pedia</span>
          </a>
          <button type="button" class="lang-btn" id="lang-toggle" aria-label="Language">EN</button>
        </div>
        <nav class="nav" aria-label="Main menu">
          <a href="/" data-i18n="nav_catalog">Katalog</a>
          <a href="/knowledge/" data-i18n="nav_knowledge">Knowledge</a>
          <a href="/tools/" data-i18n="nav_tools">Smart Tools</a>
          <a href="/#insights" data-i18n="nav_insights">Insights</a>
          <a href="/download/" data-i18n="nav_download">Download</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div><strong>Partpedia</strong> — <span data-i18n="footer_1">direktori spek, kode part & referensi pengganti sparepart industri.</span></div>
        <div data-i18n="footer_2">Harga bersifat estimasi pasar. Selalu verifikasi ke vendor resmi sebelum membeli.</div>
        <div class="footer-links">
          <a href="/about/">Tentang</a>
          <a href="/contact/">Kontak</a>
          <a href="/privacy/">Privasi</a>
          <a href="/disclaimer/">Disclaimer</a>
        </div>
        <div class="footer-aff">Beberapa tautan ke toko bersifat afiliasi; kami dapat menerima komisi jika Anda membeli lewat tautan tersebut, tanpa biaya tambahan untuk Anda.</div>
        <div>© 2026 Partpedia · Built for MRO & plant maintenance research</div>
      </div>
    </footer>

    <script>
      
      const dict = {
        en: {
          nav_catalog: "Catalog",
          nav_knowledge: "Knowledge",
          nav_tools: "Smart Tools",
          nav_insights: "Insights",
          nav_download: "Download",
          footer_1: "directory of specs, part codes & industrial spare-part cross-references.",
          footer_2: "Prices are market estimates. Always verify with official vendors before buying.",
          welcome_title: "Find parts faster",
          welcome_body: "Browse specs, sizes & equivalents. Sponsor slots appear here after ads/affiliates are enabled.",
          welcome_close: "Close",
          welcome_cta: "View catalog",
          hero_cta1: "Browse catalog",
          hero_cta2: "Knowledge hub",
          brands_label: "Cross-brand references often searched in industry",
          stats_parts: "PARTS INDEXED",
          stats_cat: "CATEGORIES",
          stats_eq: "EQUIVALENTS",
          stats_live: "CATALOG ONLINE",
          catalog_title: "Full catalog",
          catalog_sub: "Search by part number, name, size, function — English or Indonesian",
          search_ph: "Search part number, name, size, brand…",
          buy_amazon: "Check on Amazon →",
          buy_shopee: "Buy on Shopee →",
          empty: "No results.",
          featured: "Featured cross-reference",
          featured_sub: "Parts with inter-brand equivalent data",
          insights_title: "Industrial Insights",
          insights_sub: "Articles on parts, specs, and MRO practice",
          insights_read: "Read article →",
        },
        id: {
          nav_catalog: "Katalog",
          nav_knowledge: "Knowledge",
          nav_tools: "Smart Tools",
          nav_insights: "Insights",
          nav_download: "Unduh",
          footer_1: "direktori spek, kode part & referensi pengganti sparepart industri.",
          footer_2: "Harga bersifat estimasi pasar. Selalu verifikasi ke vendor resmi sebelum membeli.",
          welcome_title: "Temukan part lebih cepat",
          welcome_body: "Jelajahi spek, size & kode setara. Slot sponsor tersedia di area ini setelah AdSense/affiliate aktif.",
          welcome_close: "Tutup",
          welcome_cta: "Lihat katalog",
          hero_cta1: "Jelajahi katalog",
          hero_cta2: "Knowledge hub",
          brands_label: "Referensi lintas merek yang sering dicari di industri",
          stats_parts: "PARTS INDEXED",
          stats_cat: "CATEGORIES",
          stats_eq: "EQUIVALENTS",
          stats_live: "CATALOG ONLINE",
          catalog_title: "Katalog lengkap",
          catalog_sub: "Cari kode part, nama, size, fungsi — Inggris atau Indonesia",
          search_ph: "Cari kode part, nama, size, merek…",
          buy_amazon: "Cek di Amazon →",
          buy_shopee: "Beli di Shopee →",
          empty: "Tidak ada hasil.",
          featured: "Featured cross-reference",
          featured_sub: "Part dengan data ekuivalen antar-brand",
          insights_title: "Wawasan Industri",
          insights_sub: "Artikel & bacaan seputar part, spek, dan praktik MRO",
          insights_read: "Baca artikel →",
        },
      };
      function applyLang(lang) {
        document.documentElement.lang = lang;
        const btn = document.getElementById("lang-toggle");
        if (btn) btn.textContent = lang === "id" ? "EN" : "ID";
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const k = el.getAttribute("data-i18n");
          if (k && dict[lang][k]) el.textContent = dict[lang][k];
        });
        document.querySelectorAll("[data-i18n-placeholder]").forEach((el) => {
          const k = el.getAttribute("data-i18n-placeholder");
          if (k && dict[lang][k]) el.setAttribute("placeholder", dict[lang][k]);
        });
        try { localStorage.setItem("partpedia_lang", lang); } catch {}
      }
      let lang = "id";
      try {
        const saved = localStorage.getItem("partpedia_lang");
        if (saved === "en" || saved === "id") lang = saved;
      } catch {}
      applyLang(lang);
      document.getElementById("lang-toggle")?.addEventListener("click", () => {
        lang = lang === "id" ? "en" : "id";
        applyLang(lang);
      });
    </script>
  </body>
</html>
